plugin tensor;
plugin math;

lam select (input: tensor.Tensor 1 2 I64 ∪ tensor.Tensor 1 2 math.F32): Nat =
    match input with
        | indices: tensor.Tensor 1 2 I64 => 0
        | probabilities: tensor.Tensor 1 2 math.F32 => 1;

extern fun reproduce (input: tensor.Tensor 1 2 I64): Nat =
    return (select (input inj tensor.Tensor 1 2 I64 ∪ tensor.Tensor 1 2 math.F32));
