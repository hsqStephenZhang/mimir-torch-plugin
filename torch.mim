            (d, h, w, kernel, stride, dilation, padding, ceil_mode);
      «n, c, s_out#0_3, s_out#1_3, s_out#2_3; F#A#R#T»;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.max_pool1d.html
/// Types: NCL floating input plus scalar window parameters to NCL output.
axm max_pool1d:
    [F: Floating]
    → {n c length: Nat}
    → [kernel: Nat, stride: Nat, padding: Nat, dilation: Nat, ceil_mode: Bool]
