pub mod unary_impl
anx lam neg (A: Arithmetic) {r: Nat, s: «r; Nat»}
                       (input: «s; A#R#T»): «s; A#R#T» =
    tensor.unary @(A#R#T, A#R#T) (torch_neg_scalar A) @(r, s) input;

anx lam abs (A: Arithmetic) {r: Nat, s: «r; Nat»}
                       (input: «s; A#R#T»): «s; A#R#T» =
    tensor.unary @(A#R#T, A#R#T) (torch_abs_scalar A) @(r, s) input;

anx lam exp (F: Floating) {r: Nat, s: «r; Nat»}
                       (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T) (torch_exp_scalar F) @(r, s) input;

anx lam log (F: Floating) {r: Nat, s: «r; Nat»}
                       (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T) (torch_log_scalar F) @(r, s) input;

anx lam sqrt (F: Floating) {r: Nat, s: «r; Nat»}
                        (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T) (torch_sqrt_scalar F) @(r, s) input;

anx lam rsqrt (F: Floating) {r: Nat, s: «r; Nat»}
                         (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T) (torch_rsqrt_scalar F) @(r, s) input;

anx lam sin (F: Floating) {r: Nat, s: «r; Nat»}
                       (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T) (torch_sin_scalar F) @(r, s) input;

anx lam cos (F: Floating) {r: Nat, s: «r; Nat»}
                       (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T) (torch_cos_scalar F) @(r, s) input;

anx lam reciprocal (F: Floating) {r: Nat, s: «r; Nat»}
                              (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_reciprocal_scalar F) @(r, s) input;

end
pub mod pointwise
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.where.html
/// Types: a Bool condition and two same-shape `T` tensors to a same-shape `T` tensor.
axm where_: {T: *, r: Nat, s: «r; Nat»}
                    → [condition: «s; Bool», lhs: «s; T», rhs: «s; T»]
                    → «s; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.masked_fill.html
/// Types: `Tensor[T, s]`, a broadcastable Bool mask, and a scalar `T` to `Tensor[T, s]`.
axm masked_fill_scalar: {T: *, rm r: Nat}
                                    → [sm: «rm; Nat», s: «r; Nat»,
                                       dm: «rm; Idx r»]
                                    → [input: «s; T», mask: «sm; Bool», value: T]
                                    → «s; T»;
end
pub mod pointwise_impl
anx lam where_ {T: *, r: Nat, s: «r; Nat»}
                         (condition: «s; Bool», lhs: «s; T», rhs: «s; T»): «s; T» =
    tensor.select @T @(r, s) (condition, lhs, rhs);

anx lam masked_fill_scalar {T: *, rm r: Nat}
                                         (sm: «rm; Nat», s: «r; Nat»,
                                          dm: «rm; Idx r»)
                                         (input: «s; T», mask: «sm; Bool», value: T)
                                       : «s; T» =
    let valid = torch_broadcast_compatible (sm, s, dm);
    runtime.require (valid, "masked_fill mask is not broadcastable") body
    where
        lam body(): «s; T» =
            let mask_b = tensor.broadcast_in_dim @(Bool, rm, r)
                (sm, s, mask, dm);
            let filled = tensor.splat @(T, r) (s, value);
            tensor.select @T @(r, s) (mask_b, filled, input);
    end;

end

pub mod shape
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.reshape.html
/// Types: `Tensor[T, s_in] -> Tensor[T, s_out]`; element counts must agree.
axm reshape: {T: *, r_in r_out: Nat}
                      → [s_in: «r_in; Nat», s_out: «r_out; Nat»]
                      → [input: «s_in; T»]
                      → «s_out; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.permute.html
/// Types: rank-`r` tensor and an input-axis permutation to the permuted shape.
axm permute: {T: *, r: Nat, s: «r; Nat»}
                      → [input: «s; T», dims: «r; Idx r»]
                      → «torch_permute_shape (s, dims); T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.transpose.html
/// Types: rank-`r` tensor and two signed axes to the corresponding permuted tensor shape.
axm transpose_int: {T: *, r: Nat, s: «r; Nat»}
                            → [input: «s; T», dim0: I64, dim1: I64]
                            → «torch_transpose_shape (s, torch_transpose_dims @r (dim0, dim1)); T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.expand.html
/// Types: `Tensor[T, s_in]` plus explicit broadcast dimensions to `Tensor[T, s_out]`.
axm expand: {T: *, r_in r_out: Nat}
                     → [s_in: «r_in; Nat», s_out: «r_out; Nat»]
                     → [input: «s_in; T», dims: «r_in; Idx r_out»]
                     → «s_out; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.cat.html
/// Types: a dependent tuple of rank-`r` tensors to `torch_concat_shape(dimension, shapes)`.
axm cat: {T: *, ni r: Nat}
                  → [dimension: Idx r]
                  → {shapes: «ni; «r; Nat»»}
                  → «i: ni; «shapes#i; T»»
                  → «torch_concat_shape (dimension, shapes); T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.stack.html
/// Types: equal-shaped rank-`r_in` tensors gain one singleton axis and are
/// concatenated along it. The frontend supplies the statically inferred
/// singleton shape and canonicalized dimension; the result shape is derived.
axm stack: {T: *, ni r_in r_out: Nat}
                    → [s_in: «r_in; Nat»,
                       s_singleton: «r_out; Nat»,
                       dimension: Idx r_out]
                    → «ni; «s_in; T»»
                    → «torch_concat_shape
                         (dimension, ‹i: ni; s_singleton›); T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.flatten.html
/// Types: `Tensor[T, s_in] -> Tensor[T, s_out]`; the frontend computes the flattened shape.
axm flatten: {T: *, r_in r_out: Nat}
                      → [s_in: «r_in; Nat», s_out: «r_out; Nat»]
                      → «s_in; T» → «s_out; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.squeeze.html
/// Types: `Tensor[T, s_in] -> Tensor[T, s_out]`; only logical singleton axes may be removed.
axm squeeze: {T: *, r_in r_out: Nat}
                      → [s_in: «r_in; Nat», s_out: «r_out; Nat»]
                      → «s_in; T» → «s_out; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.unsqueeze.html
/// Types: `Tensor[T, s_in] -> Tensor[T, s_out]`; `s_out` inserts a logical singleton axis.
axm unsqueeze: {T: *, r_in r_out: Nat}
                        → [s_in: «r_in; Nat», s_out: «r_out; Nat»]
                        → «s_in; T» → «s_out; T»;
/// PyTorch repeat with an already rank-aligned repeat vector. Each static
/// repeat count specializes the modulo-based tensor.repeat access map.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.repeat.html
/// Types: rank-aligned repeat counts map `Tensor[T, s]` to `Tensor[T, s * repeats]`.
axm repeat: {T: *, r: Nat, s: «r; Nat»}
                     → [repeats: «r; Nat»]
                     → «s; T»
                     → «torch_repeat_shape (s, repeats); T»;
end
pub mod shape_impl
anx lam reshape {T: *, r_in r_out: Nat}
                           (s_in: «r_in; Nat», s_out: «r_out; Nat»)
                           (input: «s_in; T»): «s_out; T» =
    tensor.reshape @(T, r_in, r_out) s_in s_out input;

anx lam permute {T: *, r: Nat, s: «r; Nat»}
                           (input: «s; T», dims: «r; Idx r»)
                         : «torch_permute_shape (s, dims); T» =
    let out_s = torch_permute_shape (s, dims);
    tensor.map_reduce @1 @(T, r, r) (out_s, out_s)
        @(T, r, s) (torch_tensor_copy @T, ⊥: T)
        (affine.id @r) (torch_permute_map dims,) input;

anx lam transpose_int {T: *, r: Nat, s: «r; Nat»}
                                 (input: «s; T», dim0: I64, dim1: I64)
                               : «torch_transpose_shape (s, torch_transpose_dims @r (dim0, dim1)); T» =
    let valid = core.bit2.and_ 0 (
        torch_dim_in_range @r dim0,
        torch_dim_in_range @r dim1);
    runtime.require (valid, "transpose expects in-range dimensions") body
    where
        lam body()
          : «torch_transpose_shape (s, torch_transpose_dims @r (dim0, dim1)); T» =
            tensor.transpose @(T, r)
                (torch_transpose_dims @r (dim0, dim1)) input;
    end;

anx lam expand {T: *, r_in r_out: Nat}
                          (s_in: «r_in; Nat», s_out: «r_out; Nat»)
                          (input: «s_in; T», dims: «r_in; Idx r_out»): «s_out; T» =
    tensor.broadcast_in_dim @(T, r_in, r_out) (s_in, s_out, input, dims);

anx lam cat {T: *, ni r: Nat}
                       (dimension: Idx r)
                     {shapes: «ni; «r; Nat»»}
                       (inputs: «i: ni; «shapes#i; T»»)
                     : «torch_concat_shape (dimension, shapes); T» =
    tensor.concat @(T, ni, r) dimension @shapes inputs;

anx lam stack {T: *, ni r_in r_out: Nat}
                          (s_in: «r_in; Nat»,
                           s_singleton: «r_out; Nat»,
                           dimension: Idx r_out)
                          (inputs: «ni; «s_in; T»»)
                        : «torch_concat_shape
                             (dimension, ‹i: ni; s_singleton›); T» =
    let reshaped = ‹i: ni;
        tensor.reshape @(T, r_in, r_out)
            s_in s_singleton (inputs#i)›;
    let shapes = ‹i: ni; s_singleton›;
    tensor.concat @(T, ni, r_out) dimension @shapes reshaped;

anx lam flatten {T: *, r_in r_out: Nat}
                           (s_in: «r_in; Nat», s_out: «r_out; Nat»)
                           (input: «s_in; T»): «s_out; T» =
    tensor.reshape @(T, r_in, r_out) s_in s_out input;

anx lam squeeze {T: *, r_in r_out: Nat}
                           (s_in: «r_in; Nat», s_out: «r_out; Nat»)
                           (input: «s_in; T»): «s_out; T» =
    tensor.reshape @(T, r_in, r_out) s_in s_out input;

anx lam unsqueeze {T: *, r_in r_out: Nat}
                             (s_in: «r_in; Nat», s_out: «r_out; Nat»)
                             (input: «s_in; T»): «s_out; T» =
    tensor.reshape @(T, r_in, r_out) s_in s_out input;

anx lam repeat {T: *, r: Nat, s: «r; Nat»}
                          (repeats: «r; Nat»)
                          (input: «s; T»)
                        : «torch_repeat_shape (s, repeats); T» =
    tensor.repeat @(T, r) s (torch_repeat_shape (s, repeats)) input;

end

pub mod indexing
/// Strided slice with the already-canonical per-axis start/step/output shape.
/// Frontends retain PyTorch's argument normalization; all indexing semantics
/// after that normalization are represented by this operator.
/// PyTorch API: https://pytorch.org/docs/stable/tensor_view.html
/// Types: rank-`r` tensor plus per-axis start/step/output extents to `Tensor[T, s_out]`.
axm slice: {T: *, r: Nat}
                    → [s_in: «r; Nat», start: «r; Nat»,
                       step: «r; Nat», s_out: «r; Nat»]
                    → «s_in; T» → «s_out; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.select.html
/// Types: rank-`r` tensor and valid signed axis/index to a rank-`r-1` tensor.
axm select: {T: *, r: Nat, s: «r; Nat»}
                     → [dimension: I64, index: I64]
                     → «s; T»
                     → «torch_reduce_shape (s, torch_canonical_dim @r dimension); T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.roll.html
/// Static shifts and dimensions become per-axis modular index expressions;
/// dimensions not present in the list retain their original coordinate.
axm roll: {T: *, r nr: Nat, s: «r; Nat»}
                   → [shifts: «nr; Nat», dimensions: «nr; I64»]
                   → «s; T» → «s; T»;

/// Value-semantics form of PyTorch's sliding-window view. MimIR tensors do not
/// expose strides, so the view is represented by its equivalent indexed value.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.unfold.html
/// Types: rank `r` input to rank `r + 1`; `size <= shape[dimension]`, `step > 0`.
axm unfold: {T: *, r: Nat, s: «r; Nat»}
                     → [dimension: I64, size step: Nat]
                     → «s; T»
                     → «torch_unfold_shape
                            (s, torch_canonical_dim @r dimension, size, step); T»;

/// narrow canonicalizes a negative start and lowers to a unit-stride slice.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.narrow.html
/// Types: rank-`r` tensor plus signed axis/start and Nat length to a narrowed rank-`r` tensor.
axm narrow: {T: *, r: Nat, s: «r; Nat»}
                     → [dimension: I64, start: I64, length: Nat]
                     → «s; T»
                     → «torch_narrow_shape
                          (s, torch_canonical_dim @r dimension, length); T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.gather.html
/// Types: same-rank input and I64 index tensors; the result has index shape.
axm gather: {T: *, r: Nat, s_input s_index: «r; Nat»}
                     → [dimension: I64]
                     → [input: «s_input; T», index: «s_index; I64»]
                     → «s_index; T»;
/// PyTorch source: `aten/src/ATen/native/ScatterGatherChecks.h` and
/// `torch/_meta_registrations.py::scatter_shape_check`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.scatter_.html
/// Types: same-rank input/index/src tensors with equal input/src dtype; output
/// preserves input shape. Index/source extent constraints remain executable.
axm scatter_src:
    {T: *, r: Nat, s_input s_index s_src: «r; Nat»}
    → [dimension: I64]
    → [input: «s_input; T», index: «s_index; I64», src: «s_src; T»]
    → «s_input; T»;
/// PyTorch scalar-value scatter overload. Python equivalent:
/// `return input.scatter(dim, index, torch.full(index.shape, value))`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.scatter_.html
/// Types: scalar `T` is expanded to index shape before sharing src semantics.
axm scatter_value: {T: *, r: Nat, s_input s_index: «r; Nat»}
                            → [dimension: I64, value: T]
                            → [input: «s_input; T», index: «s_index; I64»]
                            → «s_input; T»;
/// Inference value semantics of `aten.embedding`, decomposed through checked
/// index conversion, broadcasting, and `tensor.gather`. `padding_idx`,
/// `scale_grad_by_freq`, and `sparse` only affect autograd, but remain explicit
/// so the axiom directly matches the public PyTorch operator.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.embedding.html
/// Types: weight `[vocab, hidden]` and I64 indices shape `s` to `s + [hidden]`.
axm embedding: {T: *, vocab hidden ri: Nat}
                        → {s_indices: «ri; Nat»}
                        → [padding_idx: I64,
                           scale_grad_by_freq: Bool,
                           sparse: Bool]
                        → [weight: «vocab, hidden; T»,
                           indices: «s_indices; I64»]
                        → «vec.cat (s_indices, (hidden,)); T»;
/// Python equivalent of `input[row_indices, column_indices]` for a rank-2
/// tensor after PyTorch has broadcast both advanced-index tensors. The
/// implementation converts `(row, column)` to a row-major linear index, then
/// uses reshape, broadcast, and gather so every producer remains an explicit
/// tensor operand. Dynamic bounds checks are sequenced by
/// `torch_checked_index_cast`.
/// PyTorch API: https://pytorch.org/docs/stable/tensor_view.html#indexing-slicing-joining-mutating-ops
/// Types: `[m, n]` input and same-shape I64 row/column indices to that shape.
axm index_2d: {T: *, m n r: Nat, s: «r; Nat»}
                       → [input: «m, n; T»,
                          rows: «s; I64», columns: «s; I64»]
                       → «s; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.flip.html
/// Types: rank-`r` tensor and unique signed axes to the same tensor type.
axm flip: {T: *, r nr: Nat, s: «r; Nat»}
                       → [dimensions: «nr; I64»]
                       → «s; T» → «s; T»;
end

pub mod creation
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.pad.html
/// Constant, nonnegative padding specialization. Static pad widths expose the
/// complete output shape and index mapping to partial evaluation.
axm constant_pad:
    {T: *, r np: Nat, s: «r; Nat»}
    → [padding: «2 * np; Nat», value: T]
    → «s; T»
    → «torch_pad_shape
          (torch_pad_lows @(r, np) padding,
           s,
           torch_pad_highs @(r, np) padding); T»;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.full.html
/// Types: shape vector and scalar `T` to `Tensor[T, shape]`.
axm full: {T: *, r: Nat}
                   → [dims: «r; Nat», value: T]
                   → «dims; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.scalar_tensor.html
/// Rank-zero tensors are represented by their scalar value in MimIR. Keeping
/// this identity as a Torch axiom makes the Aten operation visible to PE.
axm scalar_tensor: [T: *] → T → T;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.full_like.html
/// Types: input shape from `Tensor[Tin, s]` and scalar `T` to `Tensor[T, s]`.
axm full_like: {Tin T: *, r: Nat, s: «r; Nat»}
                        → [input: «s; Tin», value: T]
                        → «s; T»;
/// Value semantics for contiguous `aten.empty_strided`. Layout is not part of
/// the tensor type, so `stride` is retained at the Torch boundary while each
/// element is intentionally undefined until initialized by a later operator.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.empty_strided.html
/// Types: shape/stride vectors and element type `T` to an undefined `Tensor[T, shape]`.
axm empty_strided: {T: *, r: Nat}
                            → [dims: «r; Nat», stride: «r; Nat»]
                            → «dims; T»;
/// Functional value semantics of `aten.fill.Scalar`: the input determines
/// dtype and shape, while every output element is replaced by `value`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.fill_.html
/// Types: `Tensor[T, s]` and scalar `T` to a functional same-type tensor value.
axm fill_scalar: {T: *, r: Nat, s: «r; Nat»}
                          → [input: «s; T», value: T]
                          → «s; T»;
/// Integer `aten.arange`. `size` is a dependent shape argument resolved from
/// `(start, end, step)` by the caller; retaining all scalar operands keeps the
/// public operator contract visible while the element implementation only
/// needs `start` and `step`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.arange.html
/// Types: I64 start/stop/step plus dependent `size` to a one-dimensional I64 tensor.
axm arange_i64: {size: Nat}
                         → [start: I64, stop: I64, step: I64]
                         → «size; I64»;
/// Clone has identity value semantics, but retains an explicit tensor
/// producer so buffer lowering materializes independent output storage.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.clone.html
/// Types: identity on `Tensor[T, s]` under immutable value semantics.
axm clone: {T: *, r: Nat, s: «r; Nat»} → «s; T» → «s; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.copy_.html
/// Types: identity on `Tensor[T, s]` after the frontend functionalizes mutation.
axm copy: {T: *, r: Nat, s: «r; Nat»} → «s; T» → «s; T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.clone.html
/// Types: identity on `Tensor[T, s]`; freshness is unobservable in immutable MimIR.
axm lift_fresh_copy:
    {T: *, r: Nat, s: «r; Nat»} → «s; T» → «s; T»;
end

pub mod creation_impl
anx lam constant_pad
    {T: *, r np: Nat, s: «r; Nat»}
    (padding: «2 * np; Nat», value: T)
    (input: «s; T»)
  : «torch_pad_shape
        (torch_pad_lows @(r, np) padding,
         s,
         torch_pad_highs @(r, np) padding); T» =
    runtime.require
        (np <= r, "pad length must not exceed input rank")
        body
    where
        lam body(): «torch_pad_shape
              (torch_pad_lows @(r, np) padding,
               s,
               torch_pad_highs @(r, np) padding); T» =
            let lo = torch_pad_lows @(r, np) padding;
            let hi = torch_pad_highs @(r, np) padding;
            tensor.pad s (0, lo, hi) (input, value);
    end;

anx lam full {T: *, r: Nat}
                        (dims: «r; Nat», value: T): «dims; T» =
    tensor.splat @(T, r) (dims, value);

anx lam scalar_tensor (T: *) (value: T): T = value;

anx lam full_like {Tin T: *, r: Nat, s: «r; Nat»}
                             (input: «s; Tin», value: T): «s; T» =
    full @(T, r) (s, value);

anx lam empty_strided {T: *, r: Nat}
                                 (dims: «r; Nat», stride: «r; Nat»)
                               : «dims; T» =
    tensor.splat @(T, r) (dims, ⊥: T);

anx lam fill_scalar {T: *, r: Nat, s: «r; Nat»}
                               (input: «s; T», value: T): «s; T» =
    full @(T, r) (s, value);

anx lam arange_i64 {size: Nat}
                              (start: I64, stop: I64, step: I64)
                            : «size; I64» =
    tensor.generate @(I64, 1)
        (size,) (torch_arange_i64_element (start, step));

anx lam clone {T: *, r: Nat, s: «r; Nat»}
                         (input: «s; T»): «s; T» =
    tensor.repeat @(T, r) s s input;

anx lam copy {T: *, r: Nat, s: «r; Nat»}
                        (input: «s; T»): «s; T» = input;

anx lam lift_fresh_copy {T: *, r: Nat, s: «r; Nat»}
                                   (input: «s; T»): «s; T» = input;

end
pub mod reduction
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sum.html
/// Types: reduce one signed axis of an `Arithmetic` tensor and remove that axis.
axm sum_dim: [A: Arithmetic]
                      → {r: Nat, s: «r; Nat»}
                      → [dimension: I64]
                      → «s; A#R#T»
                      → «torch_reduce_shape (s, torch_canonical_dim @r dimension); A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sum.html
/// Types: reduce one signed axis of an `Arithmetic` tensor and replace its extent with one.
axm sum_dim_keepdim: [A: Arithmetic]
                              → {r: Nat, s: «r; Nat»}
                              → [dimension: I64]
                              → «s; A#R#T»
                              → «torch_keepdim_shape (s, torch_canonical_dim @r dimension); A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.amax.html
/// Types: reduce one signed axis of a `Floating` tensor and remove that axis.
axm amax_dim: [F: Floating]
                       → {r: Nat, s: «r; Nat»}
                       → [dimension: I64]
                       → «s; F#A#R#T»
                       → «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.max.html
axm max_dim: [F: Floating]
                      → {r: Nat, s: «r; Nat»}
                      → [dimension: I64]
                      → «s; F#A#R#T»
                      → [Bool,
                         «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T»,
                         «torch_reduce_shape (s, torch_canonical_dim @r dimension); I64»];
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.min.html
axm min_dim: [F: Floating]
                      → {r: Nat, s: «r; Nat»}
                      → [dimension: I64]
                      → «s; F#A#R#T»
                      → [Bool,
                         «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T»,
                         «torch_reduce_shape (s, torch_canonical_dim @r dimension); I64»];
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mean.html
/// Types: reduce one signed axis of a `Floating` tensor and remove that axis.
axm mean_dim: [F: Floating]
                       → {r: Nat, s: «r; Nat»}
                       → [dimension: I64]
                       → «s; F#A#R#T»
                       → «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mean.html
/// Types: reduce one signed axis of a `Floating` tensor and replace its extent with one.
axm mean_dim_keepdim: [F: Floating]
                               → {r: Nat, s: «r; Nat»}
                               → [dimension: I64]
                               → «s; F#A#R#T»
                               → «torch_keepdim_shape
                                    (s, torch_canonical_dim @r dimension); F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sum.html
/// Types: reduce a non-empty unique signed-axis tuple and remove those axes.
axm sum_dims: [A: Arithmetic]
                       → {r nr: Nat, s: «r; Nat»}
                       → [dimensions: «nr; I64»]
                       → «s; A#R#T»
                       → «torch_multi_reduce_shape
                            (s, torch_canonical_dims @(r, nr) dimensions); A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sum.html
/// Types: reduce a non-empty unique signed-axis tuple and retain unit extents.
axm sum_dims_keepdim: [A: Arithmetic]
                               → {r nr: Nat, s: «r; Nat»}
                               → [dimensions: «nr; I64»]
                               → «s; A#R#T»
                               → «torch_multi_keepdim_shape
                                    (s, torch_canonical_dims @(r, nr) dimensions); A#R#T»;
/// PyTorch `sum.dim_IntList` with one schema-shaped `keepdim` parameter.
/// The frontend canonicalizes `dim=None` to the complete static axis list.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sum.html
axm sum: [A: Arithmetic]
    → {r nr: Nat, s: «r; Nat»}
    → [dimensions: «nr; I64», keepdim: Bool]
    → «s; A#R#T»
    → («torch_multi_reduce_shape
           (s, torch_canonical_dims @(r, nr) dimensions); A#R#T»,
       «torch_multi_keepdim_shape
           (s, torch_canonical_dims @(r, nr) dimensions); A#R#T»)#keepdim;
/// Mixed-dtype `sum.dim_IntList`. The dictionary captures input conversion,
/// accumulation and result dtype; static dtype resolution and identity casts
/// are exposed to PE before tensor lowering.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sum.html
axm sum_typed: [D: Reduction]
    → {r nr: Nat, s: «r; Nat»}
    → [dimensions: «nr; I64», keepdim: Bool]
    → «s; D#Input»
    → («torch_multi_reduce_shape
           (s, torch_canonical_dims @(r, nr) dimensions); D#Output»,
       «torch_multi_keepdim_shape
           (s, torch_canonical_dims @(r, nr) dimensions); D#Output»)#keepdim;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.linalg.vector_norm.html
/// Types: an L2 norm over non-empty unique axes, removing reduced dimensions.
axm norm2_dims: [F: Floating]
    → {r nr: Nat, s: «r; Nat»}
    → [dimensions: «nr; I64»]
    → «s; F#A#R#T»
    → «torch_multi_reduce_shape
         (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.linalg.vector_norm.html
/// Types: an L2 norm over non-empty unique axes, retaining unit dimensions.
axm norm2_dims_keepdim: [F: Floating]
    → {r nr: Nat, s: «r; Nat»}
    → [dimensions: «nr; I64»]
    → «s; F#A#R#T»
    → «torch_multi_keepdim_shape
         (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T»;
/// PyTorch vector norm over arbitrary finite p, zero, and positive/negative
/// infinity. The dtype is supplied by `F`; dtype conversion remains a frontend
/// overload concern until promotion dictionaries are added.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.linalg.vector_norm.html
axm vector_norm: [F: Floating]
    → {r nr: Nat, s: «r; Nat»}
    → [dimensions: «nr; I64», keepdim: Bool, p: F#A#R#T]
    → «s; F#A#R#T»
    → («torch_multi_reduce_shape
           (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T»,
       «torch_multi_keepdim_shape
           (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T»)#keepdim;
/// Full-tensor L2/Frobenius norm. A separate scalar schema keeps the dependent
/// `norm2_dims` result useful for partial reductions without exposing an empty
/// tensor shape to the native execution ABI.
axm norm2_all: [F: Floating]
                       → {r: Nat, s: «r; Nat»}
                       → «s; F#A#R#T» → F#A#R#T;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sum.html
/// Types: reduce every axis of `Tensor[A, s]` to its scalar physical representation.
/// Scalar ABI companion for a full mixed-dtype sum reduction.
axm sum_typed_all: [D: Reduction]
    → {r: Nat, s: «r; Nat»} → «s; D#Input» → D#Output;
axm sum_all: [A: Arithmetic]
                      → {r: Nat, s: «r; Nat»}
                      → «s; A#R#T» → A#R#T;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.amax.html
/// Types: reduce every axis of a floating tensor to its scalar physical representation.
axm amax_all: [F: Floating]
                       → {r: Nat, s: «r; Nat»}
                       → «s; F#A#R#T» → F#A#R#T;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mean.html
/// Types: reduce every axis of a floating tensor to its scalar physical representation.
axm mean_all: [F: Floating]
                       → {r: Nat, s: «r; Nat»}
                       → «s; F#A#R#T» → F#A#R#T;
/// Full `var_mean` reduction with scalar physical results. The Bool tag keeps
/// the two equal scalar fields heterogeneous under MimIR normalization.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.var_mean.html
axm var_mean_all: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [correction: F#A#R#T]
    → «s; F#A#R#T»
    → [Bool, F#A#R#T, F#A#R#T];
/// Reduction over logical singleton axes. Such axes are erased from MimIR's
/// physical tensor type, but correction still determines whether variance is
/// zero or NaN, so this operation is not an unconditional identity.
axm var_mean_singletons: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [correction: F#A#R#T]
    → «s; F#A#R#T»
    → [Bool, «s; F#A#R#T», «s; F#A#R#T»];
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.amax.html
/// Types: reduce a non-empty unique axis tuple of a `Floating` tensor and remove those axes.
axm amax_dims: [F: Floating]
                        → {r nr: Nat, s: «r; Nat»}
                        → [dimensions: «nr; I64»]
                        → «s; F#A#R#T»
                        → «torch_multi_reduce_shape
                             (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mean.html
/// Types: reduce a non-empty unique axis tuple of a `Floating` tensor and remove those axes.
axm mean_dims: [F: Floating]
                        → {r nr: Nat, s: «r; Nat»}
                        → [dimensions: «nr; I64»]
                        → «s; F#A#R#T»
                        → «torch_multi_reduce_shape
                             (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mean.html
/// Types: reduce a non-empty unique axis tuple of a `Floating` tensor and retain unit extents.
axm mean_dims_keepdim:
    [F: Floating]
    → {r nr: Nat, s: «r; Nat»}
    → [dimensions: «nr; I64»]
    → «s; F#A#R#T»
    → «torch_multi_keepdim_shape
         (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T»;
/// PyTorch `mean.dim` with `keepdim` represented as a semantic parameter.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mean.html
