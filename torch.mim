    → let s_out = torch_pool_shape (h, w, kernel, stride, dilation, padding, ceil_mode);
      «n, c, s_out#ff, s_out#tt; F#A#R#T»;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.max_pool2d.html
/// Types: the pooled values and their flattened spatial I64 indices.
