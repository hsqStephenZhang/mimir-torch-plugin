    [F: Floating]
    → {n c h w: Nat}
    → [kernel: «2; Nat», stride: «2; Nat»,
       padding: «2; Nat», dilation: «2; Nat», ceil_mode: Bool]
    → «n, c, h, w; F#A#R#T»
    → let s_out = torch_pool_shape (
            h, w, kernel, stride, dilation, padding, ceil_mode);
      [«n, c, s_out#ff, s_out#tt; F#A#R#T»,
       «n, c, s_out#ff, s_out#tt; I64»];

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.max_pool3d.html
