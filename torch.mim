/// # The Torch Plugin {#torch}
///
/// Framework-level Torch operators with executable Mim implementations.
/// Each public `*_op` axiom has a matching `*_op_impl` lambda. Running
/// `lower_torch` exposes those semantics as tensor operations.
///
/// Scalar behavior is supplied explicitly through `Arithmetic`. This is
/// a lightweight typeclass dictionary that keeps dtype-specific behavior out
/// of operator definitions. `resolve_arithmetic` and
/// `resolve_floating` map flat scalar types to built-in dictionaries;
/// exact static lookup and the provider branch disappear under PE.
///
/// Scalar dictionaries, shape arithmetic and element helpers live in
/// `helper.mim`, spliced below with `pub import "helper.mim" as *`, so they
/// stay reachable as `torch.*` for tests and other plugins. Only the helpers
/// that call an `*_impl` remain in this file. Utility comments cite the
/// matching PyTorch implementation when one exists: `PyTorch source` means
/// that the predicate or formula intentionally mirrors that implementation,
/// `MimIR lowering` marks helpers that only construct tensor loop/projection
/// metadata after the PyTorch-level choice is known.
///
plugin tensor;
plugin compile;
plugin core;
plugin math;
plugin affine;
plugin runtime;
plugin vec;
plugin option;

pub import "helper.mim" as *;

/// Exact lookup in a flat `(scalar type, instance)` table. This deliberately
/// small Torch-local dispatcher is sufficient for non-compositional dtypes.
axm resolve: {V: *, n: Nat}
                  → [key: *, instances: «n; [*, V]»]
                  → V, normalize_resolve;

anx let reduction_input_tags = (
    (math.F32, 0),
    (math.F64, 1),
    (I64, 2),
    (Bool, 3),
);
anx let reduction_output_tags = (
    (I64, 0),
    (math.F32, 1),
    (math.F64, 2),
);

/// Resolve both input and result dtype. Exact pair lookup is sufficient for
/// PyTorch's flat scalar dtype lattice and is completely removed by PE.
anx lam resolve_reduction (Input: *) (Output: *): Reduction =
    let input_tag = resolve @(Nat, 4)
        (Input, reduction_input_tags);
    let output_tag = resolve @(Nat, 3)
        (Output, reduction_output_tags);
    let i64_reduction = torch_select_reduction (
        output_tag == 0,
        torch_i64_sum_reduction (), torch_i64_f32_sum_reduction ());
    torch_select_reduction (
        input_tag == 0, torch_f32_sum_reduction (),
        torch_select_reduction (
            input_tag == 1, torch_f64_sum_reduction (),
            torch_select_reduction (
                input_tag == 2, i64_reduction,
                torch_bool_sum_reduction ())));

anx let scalar_type_tags = (
    (math.F32, 0),
    (math.F64, 1),
);

/// Resolves exact scalar arithmetic semantics for a supported flat dtype.
anx lam resolve_arithmetic (T: *): Arithmetic =
    let tag = resolve @(Nat, 2) (T, scalar_type_tags);
    torch_select_arithmetic (
        tag == 0,
        torch_f32_arithmetic (),
        torch_f64_arithmetic ());

/// Resolves exact floating-point semantics for a supported flat dtype.
anx lam resolve_floating (T: *): Floating =
    let tag = resolve @(Nat, 2) (T, scalar_type_tags);
    torch_select_floating (
        tag == 0,
        torch_f32_floating (),
        torch_f64_floating ());

pub mod binary
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: two same-shape `Arithmetic` tensors and same-dtype `alpha` to the same tensor type.
axm add: [A: Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T», alpha: A#R#T]
                  → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: two same-shape `Arithmetic` tensors and same-dtype `alpha` to the same tensor type.
axm sub: [A: Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T», alpha: A#R#T]
                  → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mul.html
/// Types: two same-shape `Arithmetic` tensors to a tensor of the same shape and element type.
axm mul: [A: Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T»]
                  → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.div.html
/// Types: two same-shape `Arithmetic` tensors to a tensor of the same shape and element type.
axm div: [A: Arithmetic]
                  → {r: Nat, s: «r; Nat»}
                  → [lhs: «s; A#R#T», rhs: «s; A#R#T»]
                  → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: an `Arithmetic` tensor plus same-dtype `alpha * other`.
axm add_scalar: [A: Arithmetic]
                         → {r: Nat, s: «r; Nat»}
                         → [input: «s; A#R#T», other alpha: A#R#T]
                         → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: an I64 tensor and I64 scalar to a shape-preserving I64 tensor.
axm add_i64_scalar: {r: Nat, s: «r; Nat»}
                             → [input: «s; I64», other alpha: I64]
                             → «s; I64»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: an `Arithmetic` tensor minus same-dtype `alpha * other`.
axm sub_scalar: [A: Arithmetic]
                         → {r: Nat, s: «r; Nat»}
                         → [input: «s; A#R#T», other alpha: A#R#T]
                         → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.add.html
/// Types: scalar `self` plus `alpha` times a same-dtype tensor.
axm add_scalar_lhs: [A: Arithmetic]
                             → {r: Nat, s: «r; Nat»}
                             → [self: A#R#T, other: «s; A#R#T», alpha: A#R#T]
                             → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: scalar `self` minus `alpha` times a same-dtype tensor.
axm sub_scalar_lhs: [A: Arithmetic]
                             → {r: Nat, s: «r; Nat»}
                             → [self: A#R#T, other: «s; A#R#T», alpha: A#R#T]
                             → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sub.html
/// Types: an I64 tensor and I64 scalar to a shape-preserving I64 tensor.
axm sub_i64_scalar: {r: Nat, s: «r; Nat»}
                             → [input: «s; I64», other alpha: I64]
                             → «s; I64»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.mul.html
/// Types: an `Arithmetic` tensor and same-dtype scalar to the original shape.
axm mul_scalar: [A: Arithmetic]
                         → {r: Nat, s: «r; Nat»}
                         → [input: «s; A#R#T», other: A#R#T]
                         → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.pow.html
/// Types: a `Floating` tensor and same-dtype exponent to a shape-preserving tensor.
axm pow_tensor_scalar: [F: Floating]
                                → {r: Nat, s: «r; Nat»}
                                → [input: «s; F#A#R#T», exponent: F#A#R#T]
                                → «s; F#A#R#T»;
/// PyTorch source: `torch/_refs/__init__.py::addcmul`.
/// Python: `return self + value * tensor1 * tensor2` after broadcasting.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.addcmul.html
axm addcmul: [A: Arithmetic]
                      → {rs r1 r2 ro: Nat}
                      → [ss: «rs; Nat», ds: «rs; Idx ro»,
                         s1: «r1; Nat», d1: «r1; Idx ro»,
                         s2: «r2; Nat», d2: «r2; Idx ro»,
                         so: «ro; Nat»]
                      → [self: «ss; A#R#T», tensor1: «s1; A#R#T»,
                         tensor2: «s2; A#R#T», value: A#R#T]
                      → «so; A#R#T»;
/// PyTorch source: `torch/_refs/__init__.py::addcdiv`.
/// Python: `return self + value * tensor1 / tensor2` after broadcasting.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.addcdiv.html
axm addcdiv: [A: Arithmetic]
                      → {rs r1 r2 ro: Nat}
                      → [ss: «rs; Nat», ds: «rs; Idx ro»,
                         s1: «r1; Nat», d1: «r1; Idx ro»,
                         s2: «r2; Nat», d2: «r2; Idx ro»,
                         so: «ro; Nat»]
                      → [self: «ss; A#R#T», tensor1: «s1; A#R#T»,
                         tensor2: «s2; A#R#T», value: A#R#T]
                      → «so; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.maximum.html
/// Types: two same-shape `Arithmetic` tensors to a same-type tensor.
axm maximum: [A: Arithmetic]
                      → {r: Nat, s: «r; Nat»}
                      → [lhs: «s; A#R#T», rhs: «s; A#R#T»]
                      → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.minimum.html
/// Types: two same-shape `Arithmetic` tensors to a same-type tensor.
axm minimum: [A: Arithmetic]
                      → {r: Nat, s: «r; Nat»}
                      → [lhs: «s; A#R#T», rhs: «s; A#R#T»]
                      → «s; A#R#T»;
end
pub mod binary_impl
anx lam add (A: Arithmetic)
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»,
                        alpha: A#R#T): «s; A#R#T» =
    let scaled_rhs = tensor.unary @(A#R#T, A#R#T)
        (torch_scale_scalar A alpha) @(r, s) rhs;
    tensor.binary @(A#R#T, A#R#T, A#R#T)
        (torch_ring_add A#R) @(r, s) (lhs, scaled_rhs);

anx lam sub (A: Arithmetic)
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»,
                        alpha: A#R#T): «s; A#R#T» =
    let scaled_rhs = tensor.unary @(A#R#T, A#R#T)
        (torch_scale_scalar A alpha) @(r, s) rhs;
    tensor.binary @(A#R#T, A#R#T, A#R#T)
        (torch_arith_sub A) @(r, s) (lhs, scaled_rhs);

anx lam mul (A: Arithmetic)
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; A#R#T» =
    tensor.binary @(A#R#T, A#R#T, A#R#T) (torch_ring_mul A#R) @(r, s) (lhs, rhs);

anx lam div (A: Arithmetic)
                       {r: Nat, s: «r; Nat»}
                       (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; A#R#T» =
    tensor.binary @(A#R#T, A#R#T, A#R#T) (torch_arith_div A) @(r, s) (lhs, rhs);

anx lam add_scalar (A: Arithmetic)
                              {r: Nat, s: «r; Nat»}
                              (input: «s; A#R#T», other alpha: A#R#T): «s; A#R#T» =
    let scaled_other = (torch_ring_mul A#R) (other, alpha);
    tensor.unary @(A#R#T, A#R#T)
        (torch_add_scalar A scaled_other) @(r, s) input;

anx lam add_i64_scalar {r: Nat, s: «r; Nat»}
                                  (input: «s; I64», other alpha: I64): «s; I64» =
    let scaled_other = core.wrap.mul 0 (other, alpha);
    tensor.unary @(I64, I64)
        (torch_add_i64_scalar scaled_other) @(r, s) input;

anx lam sub_scalar (A: Arithmetic)
                              {r: Nat, s: «r; Nat»}
                              (input: «s; A#R#T», other alpha: A#R#T): «s; A#R#T» =
    let scaled_other = (torch_ring_mul A#R) (other, alpha);
    tensor.unary @(A#R#T, A#R#T)
        (torch_sub_scalar A scaled_other) @(r, s) input;

anx lam add_scalar_lhs (A: Arithmetic)
                                  {r: Nat, s: «r; Nat»}
                                  (self: A#R#T, other: «s; A#R#T»,
                                   alpha: A#R#T): «s; A#R#T» =
    tensor.unary @(A#R#T, A#R#T)
        (torch_add_scalar_lhs A (self, alpha)) @(r, s) other;

anx lam sub_scalar_lhs (A: Arithmetic)
                                  {r: Nat, s: «r; Nat»}
                                  (self: A#R#T, other: «s; A#R#T»,
                                   alpha: A#R#T): «s; A#R#T» =
    tensor.unary @(A#R#T, A#R#T)
        (torch_sub_scalar_lhs A (self, alpha)) @(r, s) other;

anx lam sub_i64_scalar {r: Nat, s: «r; Nat»}
                                  (input: «s; I64», other alpha: I64): «s; I64» =
    let scaled_other = core.wrap.mul 0 (other, alpha);
    tensor.unary @(I64, I64)
        (torch_sub_i64_scalar scaled_other) @(r, s) input;

anx lam mul_scalar (A: Arithmetic)
                              {r: Nat, s: «r; Nat»}
                              (input: «s; A#R#T», other: A#R#T): «s; A#R#T» =
    tensor.unary @(A#R#T, A#R#T)
        (torch_scale_scalar A other) @(r, s) input;

anx lam pow_tensor_scalar (F: Floating)
                                     {r: Nat, s: «r; Nat»}
                                     (input: «s; F#A#R#T»,
                                      exponent: F#A#R#T): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_pow_scalar F exponent) @(r, s) input;

anx lam addcmul (A: Arithmetic)
                           {rs r1 r2 ro: Nat}
                           (ss: «rs; Nat», ds: «rs; Idx ro»,
                            s1: «r1; Nat», d1: «r1; Idx ro»,
                            s2: «r2; Nat», d2: «r2; Idx ro»,
                            so: «ro; Nat»)
                           (self: «ss; A#R#T», tensor1: «s1; A#R#T»,
                            tensor2: «s2; A#R#T», value: A#R#T): «so; A#R#T» =
    let valid = core.bit2.and_ 0 (
        torch_broadcast_compatible (ss, so, ds),
        core.bit2.and_ 0 (
            torch_broadcast_compatible (s1, so, d1),
            torch_broadcast_compatible (s2, so, d2)));
    runtime.require (valid, "addcmul operands are not broadcastable") body
    where
        lam body(): «so; A#R#T» =
            let self_b = tensor.broadcast_in_dim @(A#R#T, rs, ro)
                (ss, so, self, ds);
            let tensor1_b = tensor.broadcast_in_dim @(A#R#T, r1, ro)
                (s1, so, tensor1, d1);
            let tensor2_b = tensor.broadcast_in_dim @(A#R#T, r2, ro)
                (s2, so, tensor2, d2);
            let product = tensor.binary @(A#R#T, A#R#T, A#R#T)
                (torch_ring_mul A#R) @(ro, so) (tensor1_b, tensor2_b);
            let scaled = tensor.unary @(A#R#T, A#R#T)
                (torch_scale_scalar A value) @(ro, so) product;
            tensor.binary @(A#R#T, A#R#T, A#R#T)
                (torch_ring_add A#R) @(ro, so) (self_b, scaled);
    end;

anx lam addcdiv (A: Arithmetic)
                           {rs r1 r2 ro: Nat}
                           (ss: «rs; Nat», ds: «rs; Idx ro»,
                            s1: «r1; Nat», d1: «r1; Idx ro»,
                            s2: «r2; Nat», d2: «r2; Idx ro»,
                            so: «ro; Nat»)
                           (self: «ss; A#R#T», tensor1: «s1; A#R#T»,
                            tensor2: «s2; A#R#T», value: A#R#T): «so; A#R#T» =
    let valid = core.bit2.and_ 0 (
        torch_broadcast_compatible (ss, so, ds),
        core.bit2.and_ 0 (
            torch_broadcast_compatible (s1, so, d1),
            torch_broadcast_compatible (s2, so, d2)));
    runtime.require (valid, "addcdiv operands are not broadcastable") body
    where
        lam body(): «so; A#R#T» =
            let self_b = tensor.broadcast_in_dim @(A#R#T, rs, ro)
                (ss, so, self, ds);
            let tensor1_b = tensor.broadcast_in_dim @(A#R#T, r1, ro)
                (s1, so, tensor1, d1);
            let tensor2_b = tensor.broadcast_in_dim @(A#R#T, r2, ro)
                (s2, so, tensor2, d2);
            let quotient = tensor.binary @(A#R#T, A#R#T, A#R#T)
                (torch_arith_div A) @(ro, so) (tensor1_b, tensor2_b);
            let scaled = tensor.unary @(A#R#T, A#R#T)
                (torch_scale_scalar A value) @(ro, so) quotient;
            tensor.binary @(A#R#T, A#R#T, A#R#T)
                (torch_ring_add A#R) @(ro, so) (self_b, scaled);
    end;

anx lam maximum (A: Arithmetic)
                           {r: Nat, s: «r; Nat»}
                           (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; A#R#T» =
    tensor.binary @(A#R#T, A#R#T, A#R#T) (torch_arith_maximum A) @(r, s) (lhs, rhs);

anx lam minimum (A: Arithmetic)
                           {r: Nat, s: «r; Nat»}
                           (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; A#R#T» =
    tensor.binary @(A#R#T, A#R#T, A#R#T) (torch_arith_minimum A) @(r, s) (lhs, rhs);

end
