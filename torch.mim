/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.linear.html
/// Types: `batch_shape + [k]`, weight `[n, k]`, optional bias `[n]` to `batch_shape + [n]`.
axm linear: [A: Arithmetic]
                     → {rb k n: Nat}
                     → [batch_shape: «rb; Nat»]
                     → [input: «vec.cat (batch_shape, (k,)); A#R#T»,
                        weight: «n, k; A#R#T»]
                     → [option.Opt «n; A#R#T»]
                     → «vec.cat (batch_shape, (n,)); A#R#T»;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.triu.html
/// Types: rank >= 2 tensor plus same-type zero and I64 diagonal to the same tensor type.
