axm matmul: [A: Arithmetic]
                     → {rl rr: Nat, sl: «rl; Nat», sr: «rr; Nat»}
                     → [lhs: «sl; A#R#T», rhs: «sr; A#R#T»]
                     → «torch_matmul_output_shape (sl, sr); A#R#T»;

/// PyTorch `addmm` including scalar alpha/beta and arbitrary broadcasting of
/// `self` into the matrix result. `self_dims` is the in-dimension broadcast
/// map; it represents scalar, vector, and matrix `self` uniformly.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.addmm.html
/// Types: broadcastable `self`, `[m, k]`, `[k, n]`, and same-dtype scalars to `[m, n]`.
axm addmm: [A: Arithmetic]
                    → {ri m k n: Nat}
                    → [s_self: «ri; Nat», self_dims: «ri; Idx 2»]
                    → [self: «s_self; A#R#T», mat1: «m, k; A#R#T», mat2: «k, n; A#R#T»]
                    → [beta: A#R#T, alpha: A#R#T]
                    → «m, n; A#R#T»;

