pub mod pool_impl
anx lam max_pool2d
    (F: Floating)
    {n c h w: Nat}
    (kernel: «2; Nat», stride: «2; Nat»,
     padding: «2; Nat», dilation: «2; Nat», ceil_mode: Bool)
    (input: «n, c, h, w; F#A#R#T»)
  : let s_out = torch_pool_shape (h, w, kernel, stride, dilation, padding, ceil_mode);
    «n, c, s_out#ff, s_out#tt; F#A#R#T» =
    let s_out = torch_pool_shape (
        h, w, kernel, stride, dilation, padding, ceil_mode);
    let extra_hi = (
        torch_pool_extra_hi (
            h, kernel#ff, stride#ff, dilation#ff, padding#ff, s_out#ff),
        torch_pool_extra_hi (
            w, kernel#tt, stride#tt, dilation#tt, padding#tt, s_out#tt));
    let s_in = (n, c, h, w);
    let pad_lo = (0, 0, padding#ff, padding#tt);
    let pad_hi = (
        0, 0,
        padding#ff + extra_hi#ff,
        padding#tt + extra_hi#tt);
    let padded = tensor.pad s_in (0, pad_lo, pad_hi) (input, F#neg_inf);
    let s_padded = torch_pad_shape (pad_lo, s_in, pad_hi);
    tensor.pool (F#A#maximum, F#neg_inf)
        @(n, c, s_padded#2_4, s_padded#3_4)
        (kernel, stride, dilation, (0, 0), s_out) padded;

anx lam max_pool2d_with_indices
    (F: Floating)
    {n c h w: Nat}
    (kernel: «2; Nat», stride: «2; Nat»,
     padding: «2; Nat», dilation: «2; Nat», ceil_mode: Bool)
    (input: «n, c, h, w; F#A#R#T»)
  : let s_out = torch_pool_shape (
        h, w, kernel, stride, dilation, padding, ceil_mode);
    [«n, c, s_out#ff, s_out#tt; F#A#R#T»,
     «n, c, s_out#ff, s_out#tt; I64»] =
    let s_out = torch_pool_shape (
        h, w, kernel, stride, dilation, padding, ceil_mode);
    let values = max_pool2d F @(n, c, h, w)
        (kernel, stride, padding, dilation, ceil_mode) input;
    let extra_hi = (
        torch_pool_extra_hi (
            h, kernel#ff, stride#ff, dilation#ff, padding#ff, s_out#ff),
        torch_pool_extra_hi (
            w, kernel#tt, stride#tt, dilation#tt, padding#tt, s_out#tt));
    let s_in = (n, c, h, w);
    let pad_lo = (0, 0, padding#ff, padding#tt);
    let pad_hi = (
        0, 0,
        padding#ff + extra_hi#ff,
        padding#tt + extra_hi#tt);
    let padded = tensor.pad s_in (0, pad_lo, pad_hi) (input, F#neg_inf);
    let s_padded = torch_pad_shape (pad_lo, s_in, pad_hi);
    let flat_indices = tensor.generate @(I64, 4) s_padded
        (torch_pool2d_flat_index @(h, w) padding);
    let output_shape = (n, c, s_out#ff, s_out#tt);
    let iteration_shape = (
        n, c, s_out#ff, s_out#tt, kernel#ff, kernel#tt);
    let window_map = torch_pool2d_in_map (stride, dilation);
    let projection = tensor.proj_map @(6, 4) (0, 1, 2, 3);
    let result_indices = tensor.map_reduce @3 @(I64, 4, 6)
        (output_shape, iteration_shape)
        @((F#A#R#T, F#A#R#T, I64),
          (4, 4, 4), (s_padded, output_shape, s_padded))
        (torch_arg_index_fold F, 9223372036854775807I64)
        projection
        (window_map, projection, window_map)
        (padded, values, flat_indices);
    (values, result_indices);

anx lam max_pool3d
    (F: Floating)
    {n c d h w: Nat}
    (kernel: «3; Nat», stride: «3; Nat»,
     padding: «3; Nat», dilation: «3; Nat», ceil_mode: Bool)
    (input: «n, c, d, h, w; F#A#R#T»)
  : let s_out = torch_pool3d_shape
        (d, h, w, kernel, stride, dilation, padding, ceil_mode);
    «n, c, s_out#0_3, s_out#1_3, s_out#2_3; F#A#R#T» =
    let s_out = torch_pool3d_shape
        (d, h, w, kernel, stride, dilation, padding, ceil_mode);
    let extra_hi = ‹i: 3;
        let spatial = (d, h, w);
        torch_pool_extra_hi
            (spatial#i, kernel#i, stride#i, dilation#i, padding#i, s_out#i)›;
    let s_in = (n, c, d, h, w);
    let pad_lo = (0, 0, padding#0_3, padding#1_3, padding#2_3);
    let pad_hi = (
        0, 0,
        padding#0_3 + extra_hi#0_3,
        padding#1_3 + extra_hi#1_3,
        padding#2_3 + extra_hi#2_3);
    let padded = tensor.pad s_in (0, pad_lo, pad_hi) (input, F#neg_inf);
    let s_padded = torch_pad_shape (pad_lo, s_in, pad_hi);
    torch_pool3d (F#A#maximum, F#neg_inf)
        @(n, c, s_padded#2_5, s_padded#3_5, s_padded#4_5)
        (kernel, stride, dilation, (0, 0, 0), s_out) padded;

anx lam max_pool1d
    (F: Floating)
    {n c length: Nat}
    (kernel stride padding dilation: Nat, ceil_mode: Bool)
    (input: «n, c, length; F#A#R#T»)
  : «torch_pool1d_shape
        (n, c, length, kernel, stride, dilation, padding, ceil_mode);
      F#A#R#T» =
    let input_2d = tensor.reshape @(F#A#R#T, 3, 4)
        (n, c, length) (n, c, length, 1) input;
    let output_2d = max_pool2d F @(n, c, length, 1)
        ((kernel, 1), (stride, 1), (padding, 0), (dilation, 1), ceil_mode)
        input_2d;
    let output_shape = torch_pool1d_shape
        (n, c, length, kernel, stride, dilation, padding, ceil_mode);
    tensor.reshape @(F#A#R#T, 4, 3)
        (output_shape#0_3, output_shape#1_3, output_shape#2_3, 1)
        output_shape output_2d;

anx lam avg_pool2d
    (F: Floating)
    {n c h w: Nat}
    (kernel: «2; Nat», stride: «2; Nat», padding: «2; Nat»,
     ceil_mode: Bool, count_include_pad: Bool,
     divisor_override: option.Opt Nat)
    (input: «n, c, h, w; F#A#R#T»)
  : let s_out = torch_pool_shape (h, w, kernel, stride, (1, 1), padding, ceil_mode);
    «n, c, s_out#ff, s_out#tt; F#A#R#T» =
    let checked_divisor = option.unwrap_or divisor_override 1;
    runtime.require
        (checked_divisor != 0,
         "avg_pool2d divisor must be nonzero")
        body
    where
        lam body():
            let s_out = torch_pool_shape
                (h, w, kernel, stride, (1, 1), padding, ceil_mode);
            «n, c, s_out#ff, s_out#tt; F#A#R#T» =
            let s_out = torch_pool_shape
                (h, w, kernel, stride, (1, 1), padding, ceil_mode);
            let extra_hi = (
                torch_pool_extra_hi
                    (h, kernel#ff, stride#ff, 1, padding#ff, s_out#ff),
                torch_pool_extra_hi
                    (w, kernel#tt, stride#tt, 1, padding#tt, s_out#tt));
            let s_in = (n, c, h, w);
            let pad_lo = (0, 0, padding#ff, padding#tt);
            let pad_hi = (
                0, 0,
                padding#ff + extra_hi#ff,
                padding#tt + extra_hi#tt);
            let padded = tensor.pad
                s_in (0, pad_lo, pad_hi) (input, F#A#R#_0);
            let s_padded = torch_pad_shape (pad_lo, s_in, pad_hi);
            let summed = tensor.pool
                (F#A#R#add, F#A#R#_0)
                @(n, c, s_padded#2_4, s_padded#3_4)
                (kernel, stride, (1, 1), (0, 0), s_out) padded;
            let divisors = tensor.generate @(F#A#R#T, 4)
                (n, c, s_out#ff, s_out#tt)
                (torch_avg_pool_divisor F
                    (h, w, kernel, stride, padding, count_include_pad,
                     divisor_override));
            tensor.binary @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#div @(4, (n, c, s_out#ff, s_out#tt))
                (summed, divisors);
    end;

anx lam avg_pool3d
    (F: Floating)
    {n c d h w: Nat}
    (kernel: «3; Nat», stride: «3; Nat», padding: «3; Nat»,
     ceil_mode count_include_pad: Bool,
     divisor_override: option.Opt Nat)
    (input: «n, c, d, h, w; F#A#R#T»)
  : let s_out = torch_pool3d_shape
        (d, h, w, kernel, stride, (1, 1, 1), padding, ceil_mode);
    «n, c, s_out#0_3, s_out#1_3, s_out#2_3; F#A#R#T» =
    let checked_divisor = option.unwrap_or divisor_override 1;
    runtime.require
        (checked_divisor != 0,
         "avg_pool3d divisor must be nonzero")
        body
    where
        lam body():
            let s_out = torch_pool3d_shape
                (d, h, w, kernel, stride, (1, 1, 1), padding, ceil_mode);
            «n, c, s_out#0_3, s_out#1_3, s_out#2_3; F#A#R#T» =
            let s_out = torch_pool3d_shape
                (d, h, w, kernel, stride, (1, 1, 1), padding, ceil_mode);
            let spatial = (d, h, w);
            let extra_hi = ‹i: 3;
                torch_pool_extra_hi
                    (spatial#i, kernel#i, stride#i, 1, padding#i, s_out#i)›;
            let s_in = (n, c, d, h, w);
            let pad_lo = (0, 0, padding#0_3, padding#1_3, padding#2_3);
            let pad_hi = (
                0, 0,
                padding#0_3 + extra_hi#0_3,
                padding#1_3 + extra_hi#1_3,
                padding#2_3 + extra_hi#2_3);
            let padded = tensor.pad
                s_in (0, pad_lo, pad_hi) (input, F#A#R#_0);
            let s_padded = torch_pad_shape (pad_lo, s_in, pad_hi);
            let summed = torch_pool3d
                (F#A#R#add, F#A#R#_0)
                @(n, c, s_padded#2_5, s_padded#3_5, s_padded#4_5)
                (kernel, stride, (1, 1, 1), (0, 0, 0), s_out) padded;
            let divisors = tensor.generate @(F#A#R#T, 5)
                (n, c, s_out#0_3, s_out#1_3, s_out#2_3)
                (torch_avg_pool3d_divisor F
                    (d, h, w, kernel, stride, padding, count_include_pad,
                     divisor_override));
            tensor.binary @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#div @(5, (n, c, s_out#0_3, s_out#1_3, s_out#2_3))
                (summed, divisors);
    end;

anx lam avg_pool1d
    (F: Floating)
    {n c length: Nat}
    (kernel stride padding: Nat, ceil_mode count_include_pad: Bool,
     divisor_override: option.Opt Nat)
    (input: «n, c, length; F#A#R#T»)
  : «torch_pool1d_shape
        (n, c, length, kernel, stride, 1, padding, ceil_mode);
      F#A#R#T» =
    let input_2d = tensor.reshape @(F#A#R#T, 3, 4)
        (n, c, length) (n, c, length, 1) input;
    let output_2d = avg_pool2d F @(n, c, length, 1)
        ((kernel, 1), (stride, 1), (padding, 0),
         ceil_mode, count_include_pad, divisor_override)
        input_2d;
    let output_shape = torch_pool1d_shape
        (n, c, length, kernel, stride, 1, padding, ceil_mode);
    tensor.reshape @(F#A#R#T, 4, 3)
        (output_shape#0_3, output_shape#1_3, output_shape#2_3, 1)
        output_shape output_2d;

anx lam adaptive_avg_pool1d (F: Floating)
    {r: Nat, s: «r; Nat»}
    (output_size: Nat)
    (input: «s; F#A#R#T»)
  : «torch_adaptive_pool1d_shape (s, output_size); F#A#R#T» =
    let rank_valid = core.bit2.or_ 0 (
        r == 2, r == 3);
    let input_size = s#(core.idx 0 r  (r - 1));
    runtime.require
        (core.bit2.and_ 0 (
            rank_valid,
            torch_adaptive_pool_extents_valid @(r, 1)
                (s, (output_size,))),
         "adaptive_avg_pool1d expects rank 2/3 and positive input/output sizes")
        body
    where
        lam body(): «torch_adaptive_pool1d_shape
                (s, output_size); F#A#R#T» =
            tensor.generate @(F#A#R#T, r)
                (torch_adaptive_pool1d_shape (s, output_size))
                (torch_adaptive_pool1d_element F
                    @(r, s) (output_size, input));
    end;

anx lam adaptive_avg_pool2d (F: Floating)
    {r: Nat, s: «r; Nat»}
    (output_size: «2; Nat»)
    (input: «s; F#A#R#T»)
  : «torch_adaptive_pool2d_shape (s, output_size); F#A#R#T» =
    let rank_valid = core.bit2.or_ 0 (
        r == 3, r == 4);
    let extents_valid = torch_adaptive_pool_extents_valid @(r, 2)
        (s, output_size);
    runtime.require
        (core.bit2.and_ 0 (rank_valid, extents_valid),
         "adaptive_avg_pool2d expects rank 3/4 and positive input/output sizes")
        body
    where
        lam body(): «torch_adaptive_pool2d_shape
                (s, output_size); F#A#R#T» =
            let output_shape = torch_adaptive_pool2d_shape (s, output_size);
            let h_axis = core.idx 0 r  (r - 2);
            let w_axis = core.idx 0 r  (r - 1);
            let mh = torch_adaptive_pool_max_window
                (s#h_axis, output_size#0_2);
            let mw = torch_adaptive_pool_max_window
                (s#w_axis, output_size#1_2);
            let window_shape = vec.cat (output_shape, (mh, mw));
            let total_rank = r + 2;
            let windows = tensor.generate @(F#A#R#T, total_rank)
                window_shape
                (torch_adaptive_pool2d_window_element F
                    @(r, s) (output_size, input));
            let output_subscripts = ‹i: r; core.bitcast Nat i›;
            let summed = tensor.map_reduce @1
                @(F#A#R#T, r, total_rank)
                (output_shape, window_shape)
                @(F#A#R#T, total_rank, window_shape)
                (tensor.pool_fun F#A#R#add, F#A#R#_0)
                (tensor.proj_map @(total_rank, r) output_subscripts)
                (affine.id @total_rank,) windows;
            let divisors = tensor.generate @(F#A#R#T, r)
                output_shape
                (torch_adaptive_pool2d_divisor_element F
                    @(r, s) output_size);
            tensor.binary @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#div @(r, output_shape) (summed, divisors);
    end;

anx lam adaptive_avg_pool3d (F: Floating)
    {r: Nat, s: «r; Nat»}
    (output_size: «3; Nat»)
    (input: «s; F#A#R#T»)
  : «torch_adaptive_pool3d_shape (s, output_size); F#A#R#T» =
    let rank_valid = core.bit2.or_ 0 (
        r == 4, r == 5);
    let extents_valid = torch_adaptive_pool_extents_valid @(r, 3)
        (s, output_size);
    runtime.require
        (core.bit2.and_ 0 (rank_valid, extents_valid),
         "adaptive_avg_pool3d expects rank 4/5 and positive input/output sizes")
        body
    where
        lam body(): «torch_adaptive_pool3d_shape
                (s, output_size); F#A#R#T» =
            let output_shape = torch_adaptive_pool3d_shape (s, output_size);
            let d_axis = core.idx 0 r  (r - 3);
            let h_axis = core.idx 0 r  (r - 2);
            let w_axis = core.idx 0 r  (r - 1);
            let md = torch_adaptive_pool_max_window
                (s#d_axis, output_size#0_3);
            let mh = torch_adaptive_pool_max_window
                (s#h_axis, output_size#1_3);
            let mw = torch_adaptive_pool_max_window
                (s#w_axis, output_size#2_3);
            let window_shape = vec.cat (output_shape, (md, mh, mw));
            let total_rank = r + 3;
            let windows = tensor.generate @(F#A#R#T, total_rank)
                window_shape
                (torch_adaptive_pool3d_window_element F
                    @(r, s) (output_size, input));
            let output_subscripts = ‹i: r; core.bitcast Nat i›;
            let summed = tensor.map_reduce @1
                @(F#A#R#T, r, total_rank)
                (output_shape, window_shape)
                @(F#A#R#T, total_rank, window_shape)
                (tensor.pool_fun F#A#R#add, F#A#R#_0)
                (tensor.proj_map @(total_rank, r) output_subscripts)
                (affine.id @total_rank,) windows;
            let divisors = tensor.generate @(F#A#R#T, r)
                output_shape
                (torch_adaptive_pool3d_divisor_element F
                    @(r, s) output_size);
            tensor.binary @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#div @(r, output_shape) (summed, divisors);
    end;

end

pub mod normalization
/// PyTorch source: `torch/_refs/__init__.py::native_layer_norm` and `_normalize`.
/// PyTorch `native_layer_norm` over an arbitrary non-empty normalized suffix.
/// The dependent input type captures the suffix and affine parameter shape
/// invariants. Flattening the batch and normalized portions turns every rank
/// combination into the same 2-D reduction without losing those constraints.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.native_layer_norm.html
/// Types: `batch + normalized`, optional affine tensors, and eps to output/mean/rstd.
axm native_layer_norm:
    [F: Floating]
    → {rb rn: Nat}
    → [batch_shape: «rb; Nat», normalized_shape: «rn; Nat»]
    → [input: «vec.cat (batch_shape, normalized_shape); F#A#R#T»]
    → [weight: option.Opt «normalized_shape; F#A#R#T»,
       bias: option.Opt «normalized_shape; F#A#R#T»]
    → [eps: F#A#R#T]
    → [«vec.cat (batch_shape, normalized_shape); F#A#R#T»,
       «vec.cat (batch_shape, ‹i: rn; 1›); F#A#R#T»,
       «vec.cat (batch_shape, ‹i: rn; 1›); F#A#R#T»];

/// Group normalization uses the input statistics for each `(N, group)` and
/// applies optional affine parameters over the original channel dimension.
/// Python: `reshape([N,G,C/G,*spatial])`, normalize the trailing dimensions,
/// reshape back, then apply channel-wise `weight` and `bias`.
/// PyTorch source: `torch/_refs/__init__.py::native_group_norm`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.group_norm.html
axm group_norm:
    [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T»,
       weight: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
       bias: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
       groups: Nat, eps: F#A#R#T]
    → «s; F#A#R#T»;

/// Inference batch normalization for arbitrary rank >= 2. Running statistics
/// are required in inference mode; affine weight and bias remain independent
/// Optional parameters and specialize away when absent.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.batch_norm.html
/// Types: rank >= 2 floating tensor and channel vectors to a shape-preserving tensor.
axm batch_norm_inference:
    [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T»,
       weight: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
       bias: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
       running_mean: «s#(torch_channel_dim @r); F#A#R#T»,
       running_var: «s#(torch_channel_dim @r); F#A#R#T»,
       eps: F#A#R#T]
    → «s; F#A#R#T»;

/// Pure training-result semantics of `aten.native_batch_norm`. The returned
/// tuple is `(output, save_mean, save_invstd)`. ATen's optional running-stat
/// mutation is intentionally outside this pure operator and must be made
/// explicit by functionalization before calling it.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.native_batch_norm.html
/// Types: rank >= 2 floating input and optional channel vectors to an output
/// tensor plus two channel-sized saved-statistic tensors.
axm native_batch_norm: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T»,
       weight bias running_mean running_var:
          option.Opt «s#(torch_channel_dim @r); F#A#R#T»]
    → [training: Bool, momentum eps: F#A#R#T]
    → [«s; F#A#R#T»,
       «s#(torch_channel_dim @r); F#A#R#T»,
       «s#(torch_channel_dim @r); F#A#R#T»];
/// Functionalization boundary for training BatchNorm. In addition to native
/// saved statistics, return updated running statistics instead of mutating the
/// two input buffers.
/// PyTorch schema: `aten._native_batch_norm_legit_functional`.
axm native_batch_norm_functional: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T»,
       weight bias: option.Opt
          «s#(torch_channel_dim @r); F#A#R#T»,
       running_mean running_var:
          «s#(torch_channel_dim @r); F#A#R#T»]
    → [training: Bool, momentum eps: F#A#R#T]
    → [«s; F#A#R#T»,
       «s#(torch_channel_dim @r); F#A#R#T»,
       «s#(torch_channel_dim @r); F#A#R#T»,
       «s#(torch_channel_dim @r); F#A#R#T»,
       «s#(torch_channel_dim @r); F#A#R#T»];
/// Pure forward semantics of `aten.batch_norm`. Static `training` selects and
/// eliminates either batch-statistics reduction or running-statistics use.
/// `momentum` is retained in the API for direct mapping, but running-stat
/// mutation belongs to functionalization and is not part of this output-only
/// operator.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.batch_norm.html
axm batch_norm: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T»,
       weight bias running_mean running_var:
          option.Opt «s#(torch_channel_dim @r); F#A#R#T»]
    → [training: Bool, momentum eps: F#A#R#T, cudnn_enabled: Bool]
    → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.softmax.html
/// Types: rank > 0 `Floating` tensor and signed axis to the same tensor type.
axm softmax: [F: Floating]
                      → {r: Nat, s: «r; Nat»}
                      → [dimension: I64, half_to_float: Bool]
                      → [input: «s; F#A#R#T»]
                      → «s; F#A#R#T»;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.log_softmax.html
/// Types: rank > 0 `Floating` tensor and signed axis to the same tensor type.
axm log_softmax: [F: Floating]
                          → {r: Nat, s: «r; Nat»}
                          → [dimension: I64, half_to_float: Bool]
                          → [input: «s; F#A#R#T»]
                          → «s; F#A#R#T»;

/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.native_group_norm.html
/// Types: NCHW-like input and optional channel affine tensors to output plus
/// per-(batch, group) mean and reciprocal standard deviation.
axm native_group_norm:
    [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T»,
       weight: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
       bias: option.Opt «s#(torch_channel_dim @r); F#A#R#T»]
    → [n channels inner groups: Nat, eps: F#A#R#T]
    → [«s; F#A#R#T»,
       «n, groups; F#A#R#T»,
       «n, groups; F#A#R#T»];

end

pub mod loss
/// Mean-reduced SmoothL1/Huber loss over equal-shape floating tensors.
/// PyTorch source: `torch/_decomp/decompositions.py::smooth_l1_loss`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.smooth_l1_loss.html
axm smooth_l1_mean: [F: Floating]
                         → {r: Nat, s: «r; Nat»}
                         → [input: «s; F#A#R#T», target: «s; F#A#R#T»]
                         → [beta: F#A#R#T]
                         → F#A#R#T;
axm smooth_l1_loss: [F: Floating]
    → {ri rt ro: Nat}
    → [si: «ri; Nat», di: «ri; Idx ro»,
       st: «rt; Nat», dt: «rt; Idx ro», so: «ro; Nat»]
    → [input: «si; F#A#R#T», target: «st; F#A#R#T»]
    → [reduce_mode: Nat, beta: F#A#R#T]
    → («so; F#A#R#T», F#A#R#T)#(reduce_mode != 0);
/// Reduced KL divergence over equal-shape floating tensors.
/// Reduction tags are `0=sum`, `1=mean`, and `2=batchmean`; they are API-level
/// static choices so PE removes the unused denominator and result branch.
/// This reduced schema requires rank >= 1. A future `none` schema can preserve
/// the input shape without introducing a dependent reduced/non-reduced result.
/// PyTorch source: `torch/nn/functional.py::kl_div` and `aten::kl_div`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.kl_div.html
axm kl_div_reduced: [F: Floating]
                         → {r: Nat, s: «r; Nat»}
                         → [log_target: Bool, reduce_mode: Nat]
                         → [input target: «s; F#A#R#T»]
                         → F#A#R#T;
axm kl_div: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input target: «s; F#A#R#T»]
    → [reduce_mode: Nat, log_target: Bool]
    → («s; F#A#R#T», F#A#R#T)#(reduce_mode != 0);
/// Rank-2 TripletMarginLoss with the public PyTorch parameters retained as
/// PE-visible values. Reduction tags are `0=sum` and `1=mean`.
/// Python:
/// ```python
/// d_pos = pairwise_distance(anchor, positive, p, eps)
/// d_neg = pairwise_distance(anchor, negative, p, eps)
/// if swap: d_neg = minimum(d_neg, pairwise_distance(positive, negative, p, eps))
/// return reduce(maximum(d_pos - d_neg + margin, 0))
/// ```
/// PyTorch source: `torch/nn/functional.py::triplet_margin_loss`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.triplet_margin_loss.html
axm triplet_margin_reduced: [F: Floating]
    → {n d: Nat}
    → [margin p eps: F#A#R#T, swap: Bool, reduce_mode: Nat]
    → [anchor positive negative: «n, d; F#A#R#T»]
    → F#A#R#T;
axm triplet_margin_loss: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [anchor positive negative: «s; F#A#R#T»]
    → [margin p eps: F#A#R#T, swap: Bool, reduce_mode: Nat]
    → let feature_dim = core.idx 0 r  (r - 1);
      let loss_shape = torch_reduce_shape (s, feature_dim);
      («loss_shape; F#A#R#T», F#A#R#T)#(reduce_mode != 0);
/// Scalar physical boundary for rank-1 `reduction="none"`. PyTorch exposes a
/// 0-d tensor, while native MimIR execution represents that single value as a
/// scalar rather than bufferizing `Tensor[()]`.
axm triplet_margin_loss_1d_none: [F: Floating]
    → {d: Nat}
    → [anchor positive negative: «d; F#A#R#T»]
    → [margin p eps: F#A#R#T, swap: Bool]
    → F#A#R#T;
/// Mean-reduced cross entropy for the common `(N, C)` logits and `(N)` I64
/// class-target schema.
/// Python:
/// ```python
/// log_probs = torch.log_softmax(input, dim=1)
/// losses = -torch.gather(log_probs, 1, target[:, None]).reshape(N)
/// return losses.mean()
/// ```
/// The checked gather owns target bounds diagnostics. Stable log-softmax and
/// the reduction remain composable Torch operators and are recursively
/// decomposed by `lower_torch`.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.cross_entropy.html
/// Types: `(N, C)` floating logits and `(N)` I64 class indices to a scalar.
axm cross_entropy_mean_2d: [F: Floating]
    → {n c: Nat}
    → [input: «n, c; F#A#R#T», target: «n; I64»]
    → F#A#R#T;

/// One public CrossEntropyLoss schema for both class-index and probability
/// targets. The union is a lightweight target-domain interface: injection
/// proves the target's element/shape relationship, and PE removes this match.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.cross_entropy.html
axm cross_entropy: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T»,
       target: «s; F#A#R#T» ∪ «torch_reduce_shape
          (s, torch_cross_entropy_class_dim @r); I64»,
       weight: option.Opt
          «s#(torch_cross_entropy_class_dim @r); F#A#R#T»]
    → [reduce_mode: Nat, ignore_index: I64, label_smoothing: F#A#R#T]
    → let loss_shape = torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r);
      («loss_shape; F#A#R#T», F#A#R#T)#(reduce_mode != 0);
end

/// Typed target-domain constructors for the unified CrossEntropy schema.
/// Their injections are compile-time values, so the implementation match is
/// eliminated before tensor lowering.
anx lam cross_entropy_index_target (F: Floating)
    {r: Nat, s: «r; Nat»}
    (target: «torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r); I64»)
  : «s; F#A#R#T» ∪ «torch_reduce_shape
      (s, torch_cross_entropy_class_dim @r); I64» =
    target inj (
        «s; F#A#R#T» ∪ «torch_reduce_shape
            (s, torch_cross_entropy_class_dim @r); I64»);

anx lam cross_entropy_probability_target (F: Floating)
    {r: Nat, s: «r; Nat»}
    (target: «s; F#A#R#T»)
  : «s; F#A#R#T» ∪ «torch_reduce_shape
      (s, torch_cross_entropy_class_dim @r); I64» =
    target inj (
        «s; F#A#R#T» ∪ «torch_reduce_shape
            (s, torch_cross_entropy_class_dim @r); I64»);

pub mod linalg_impl
anx lam mm (A: Arithmetic) {m k n: Nat}
                      (lhs: «m, k; A#R#T», rhs: «k, n; A#R#T»): «m, n; A#R#T» =
    tensor.product_2d A#R @(m, k, n) (lhs, rhs);

anx lam bmm (A: Arithmetic) {b m k n: Nat}
                       (lhs: «b, m, k; A#R#T», rhs: «b, k, n; A#R#T»): «b, m, n; A#R#T» =
    tensor.bmm A#R @(b, m, k, n) (lhs, rhs);

anx lam matmul (A: Arithmetic)
                          {rl rr: Nat, sl: «rl; Nat», sr: «rr; Nat»}
                          (lhs: «sl; A#R#T», rhs: «sr; A#R#T»)
                        : «torch_matmul_output_shape (sl, sr); A#R#T» =
    let ranks_valid = core.bit2.and_ 0 (
        rl >= 1, rr >= 1);
    let contract_valid = torch_matmul_last sl == torch_matmul_rhs_contract sr;
    let batch_valid = torch_matmul_batch_compatible (sl, sr);
    let valid = core.bit2.and_ 0 (
        ranks_valid, core.bit2.and_ 0 (contract_valid, batch_valid));
    runtime.require
        (valid, "matmul expects rank > 0, matching contraction, and broadcastable batches")
        body
    where
        lam body(): «torch_matmul_output_shape (sl, sr); A#R#T» =
            let rb = torch_matmul_batch_rank (rl, rr);
            let batch_shape = torch_matmul_batch_shape (sl, sr);
            let m = torch_matmul_rows sl;
            let k = torch_matmul_last sl;
            let n = torch_matmul_cols sr;
            let lhs_shape = vec.cat (batch_shape, (m, k));
            let rhs_shape = vec.cat (batch_shape, (k, n));
            let lhs_matrix = tensor.broadcast_in_dim
                @(A#R#T, rl, rb + 2)
                (sl, lhs_shape, lhs, torch_matmul_lhs_dims @(rl, rb) ());
            let rhs_matrix = tensor.broadcast_in_dim
                @(A#R#T, rr, rb + 2)
                (sr, rhs_shape, rhs, torch_matmul_rhs_dims @(rr, rb) ());
            let product = torch_matmul_matrices A @(rb, m, k, n)
                batch_shape (lhs_matrix, rhs_matrix);
            tensor.reshape
                @(A#R#T, rb + 2, torch_matmul_output_rank (rl, rr))
                (vec.cat (batch_shape, (m, n)))
                (torch_matmul_output_shape (sl, sr))
                product;
    end;

anx lam addmm (A: Arithmetic)
                         {ri m k n: Nat}
                         (s_self: «ri; Nat», self_dims: «ri; Idx 2»)
                         (self: «s_self; A#R#T», mat1: «m, k; A#R#T», mat2: «k, n; A#R#T»)
                         (beta: A#R#T, alpha: A#R#T)
                       : «m, n; A#R#T» =
    runtime.require
        (torch_broadcast_compatible (s_self, (m, n), self_dims),
         "addmm self is not broadcastable to the matrix result")
        body
    where
        lam body(): «m, n; A#R#T» =
            let product = tensor.product_2d A#R @(m, k, n) (mat1, mat2);
            let scaled_product = tensor.unary @(A#R#T, A#R#T)
                (torch_scale_scalar A alpha) @(2, (m, n)) product;
            (core.select (A#is_zero beta, without_self, with_self)) ()
            where
                // PyTorch deliberately ignores `self` when beta is zero. Keeping
                // this as a thunk prevents NaNs in `self` from entering the graph,
                // and lets PE delete the broadcast and multiply completely.
                lam without_self(): «m, n; A#R#T» = scaled_product;
                lam with_self(): «m, n; A#R#T» =
                    let broadcast_self = tensor.broadcast_in_dim @(A#R#T, ri, 2)
                        (s_self, (m, n), self, self_dims);
                    let scaled_self = tensor.unary @(A#R#T, A#R#T)
                        (torch_scale_scalar A beta) @(2, (m, n)) broadcast_self;
                    tensor.binary @(A#R#T, A#R#T, A#R#T)
                        A#R#add @(2, (m, n)) (scaled_product, scaled_self);
            end;
    end;

anx lam linear (A: Arithmetic) {rb k n: Nat}
                          (batch_shape: «rb; Nat»)
                          (input: «vec.cat (batch_shape, (k,)); A#R#T»,
                           weight: «n, k; A#R#T»)
                          (bias: option.Opt «n; A#R#T»)
                        : «vec.cat (batch_shape, (n,)); A#R#T» =
    let output_shape = vec.cat (batch_shape, (n,));
    let ro = rb + 1;
    // x · Wᵀ is `tensor.dot_product`, whose implementation schedules it.
    let product = core.bitcast «output_shape; A#R#T»
        (tensor.dot_product A#R ((core.idx 0 ro rb,), (1_2,), (), ()) (input, weight));
    let effective_bias = option.unwrap_or bias ‹n; A#R#_0›;
    let broadcast_bias = tensor.broadcast_in_dim @(A#R#T, 1, ro)
        ((n,), output_shape, effective_bias, (core.idx 0 ro  rb,));
    tensor.binary @(A#R#T, A#R#T, A#R#T)
        A#R#add @(ro, output_shape) (product, broadcast_bias);

anx lam triu {T: *, r: Nat, s: «r; Nat»}
                        (zero: T, diagonal: I64) (input: «s; T»): «s; T» =
    runtime.require (r >= 2, "triu expects rank >= 2") body where
        lam body(): «s; T» =
            triangular_apply @(T, r) s (tt, zero, diagonal) input;
    end;

anx lam tril {T: *, r: Nat, s: «r; Nat»}
                        (zero: T, diagonal: I64) (input: «s; T»): «s; T» =
    runtime.require (r >= 2, "tril expects rank >= 2") body where
        lam body(): «s; T» =
            triangular_apply @(T, r) s (ff, zero, diagonal) input;
    end;

end
pub mod metadata
/// Runtime-visible size component of `aten._assert_tensor_metadata`.
/// Dtype, device, layout, and stride are checked by the frontend while those
/// properties are compile-time-only in the current tensor representation.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.Tensor.html
/// Types: two rank-`r` Nat shape vectors to Bool; mismatch follows `runtime.require`.
axm assert_tensor_metadata: {r: Nat}
                                    → [actual expected: «r; Nat»]
                                    → Bool;
end
pub mod metadata_impl
anx lam assert_tensor_metadata {r: Nat}
                                         (actual expected: «r; Nat»): Bool =
    runtime.require
        (torch_shapes_equal @(r) (actual, expected),
         "_assert_tensor_metadata size mismatch")
        body
    where
        lam body(): Bool = tt;
    end;

end
/// Selectively exposes Torch reference semantics. Pass preserved operator names
/// with `-X torch:preserve=native_layer_norm_op,convolution_op` so a later
/// target-specific phase can consume them before the exhaustive fallback.
axm decompose_torch: compile.Phase;

/// Exhaustively exposes all Torch reference semantics.
axm lower_torch: compile.Phase;

pub mod conv
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.conv2d.html
/// Types: NCHW input, OIHW weight, optional channel bias, and 2-D parameters to NCHW output.
axm general:
    [A: Arithmetic]
    → {n cin cout cin_per_group h w kh kw: Nat}
    → [stride: «2; Nat», padding: «2; Nat», dilation: «2; Nat»,
       transposed: Bool, output_padding: «2; Nat», groups: Nat]
    → [input: «n, cin, h, w; A#R#T»,
       weight: «cout, cin_per_group, kh, kw; A#R#T»,
       bias: option.Opt «cout; A#R#T»]
    → «tensor.conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding); A#R#T»;

/// Rank-3 NCL `aten.convolution`/`conv1d` specialization. PyTorch represents
/// stride, padding, dilation, and output_padding as singleton lists; this
/// interface uses their sole values because literal-one arrays collapse in
/// MimIR's nested-array representation. The implementation embeds NCL/OIL as
/// NCL1/OIL1 and reuses the canonical grouped 2-D cross-correlation semantics.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.conv1d.html
/// Types: NCL input, OIL weight, optional output-channel bias, to NCL output.
axm conv1d:
    [A: Arithmetic]
    → {n cin cout cin_per_group length kernel: Nat}
    → [stride: Nat, padding: Nat, dilation: Nat,
       transposed: Bool, output_padding: Nat, groups: Nat]
    → [input: «n, cin, length; A#R#T»,
       weight: «cout, cin_per_group, kernel; A#R#T»,
       bias: option.Opt «cout; A#R#T»]
    → «torch_conv1d_shape
            (n, cout, length, kernel, stride, dilation, padding); A#R#T»;

/// Rank-5 NCDHW `aten.convolution` specialization. PyTorch exposes OIDHW
/// weights for ordinary Conv3d; groups partition both channel dimensions.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.conv3d.html
/// Types: NCDHW input, OIDHW weight, optional output-channel bias, to NCDHW output.
axm conv3d:
    [A: Arithmetic]
    → {n cin cout cin_per_group d h w kd kh kw: Nat}
    → [stride: «3; Nat», padding: «3; Nat», dilation: «3; Nat»,
       transposed: Bool, output_padding: «3; Nat», groups: Nat]
    → [input: «n, cin, d, h, w; A#R#T»,
       weight: «cout, cin_per_group, kd, kh, kw; A#R#T»,
       bias: option.Opt «cout; A#R#T»]
    → «conv3d_shape (n, cout, (d, h, w), (kd, kh, kw),
          stride, dilation, padding); A#R#T»;

/// Rank-4 NCHW transposed convolution with PyTorch IOHW weights.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.conv_transpose2d.html
/// Types: NCHW input, IOHW weight, optional output-channel bias, to NCHW output.
axm transpose2d:
    [A: Arithmetic]
    → {n cin cout cout_per_group h w kh kw: Nat}
    → [stride: «2; Nat», padding: «2; Nat», dilation: «2; Nat»,
       output_padding: «2; Nat», groups: Nat]
    → [input: «n, cin, h, w; A#R#T»,
       weight: «cin, cout_per_group, kh, kw; A#R#T»,
       bias: option.Opt «cout; A#R#T»]
    → «conv_transpose2d_shape (n, cout, (h, w), (kh, kw),
          stride, dilation, padding, output_padding); A#R#T»;

/// Rank-3 NCL transposed convolution. The implementation embeds the trailing
/// spatial axis into NCL1 and reuses the canonical 2-D semantics.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.conv_transpose1d.html
/// Types: NCL input, IOK weight, optional output-channel bias, to NCL output.
axm transpose1d:
    [A: Arithmetic]
    → {n cin cout cout_per_group length kernel: Nat}
    → [stride padding dilation output_padding groups: Nat]
    → [input: «n, cin, length; A#R#T»,
       weight: «cin, cout_per_group, kernel; A#R#T»,
       bias: option.Opt «cout; A#R#T»]
    → «torch_conv_transpose1d_shape
          (n, cout, length, kernel, stride, dilation, padding, output_padding);
       A#R#T»;

/// Rank-5 NCDHW transposed convolution with PyTorch IO(DHW) weights.
/// Unit-stride axes are removed by partial evaluation; strided axes lower
/// through tensor reshape/pad/reshape/slice zero insertion.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.conv_transpose3d.html
/// Types: NCDHW input, IO(DHW) weight, optional output-channel bias, to NCDHW output.
axm transpose3d:
    [A: Arithmetic]
    → {n cin cout cout_per_group d h w kd kh kw: Nat}
    → [stride: «3; Nat», padding: «3; Nat», dilation: «3; Nat»,
       output_padding: «3; Nat», groups: Nat]
    → [input: «n, cin, d, h, w; A#R#T»,
       weight: «cin, cout_per_group, kd, kh, kw; A#R#T»,
       bias: option.Opt «cout; A#R#T»]
    → «conv_transpose3d_shape
          (n, cout, (d, h, w), (kd, kh, kw),
           stride, dilation, padding, output_padding); A#R#T»;

end

pub mod conv_impl
anx lam general
    (A: Arithmetic)
    {n cin cout cin_per_group h w kh kw: Nat}
    (stride: «2; Nat», padding: «2; Nat», dilation: «2; Nat»,
     transposed: Bool, output_padding: «2; Nat», groups: Nat)
    (input: «n, cin, h, w; A#R#T»,
     weight: «cout, cin_per_group, kh, kw; A#R#T»,
     bias: option.Opt «cout; A#R#T»)
  : «tensor.conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding); A#R#T» =
    let valid = core.bit2.and_ 0 (
        core.icmp.e @2 (transposed, ff),
        core.bit2.and_ 0 (
            groups > 0,
            core.bit2.and_ 0 (
                core.bit2.and_ 0 (
                    output_padding#ff == 0,
                    output_padding#tt == 0),
                core.bit2.and_ 0 (
                    cin == groups * cin_per_group,
                    cout % groups == 0))));
    runtime.require
        (valid, "convolution expects valid non-transposed grouped NCHW parameters")
        body
    where
        lam body():
            «tensor.conv_shape (n, cout, (h, w), (kh, kw), stride, dilation, padding); A#R#T» =
            let output_shape = tensor.conv_shape
                (n, cout, (h, w), (kh, kw), stride, dilation, padding);
            let convolved = torch_grouped_conv2d A
                @(n, cin, cout, cin_per_group, h, w, kh, kw)
                (groups, stride, dilation, padding)
                (input, weight);
            let effective_bias = option.unwrap_or bias ‹cout; A#R#_0›;
            let broadcast_bias = tensor.broadcast_in_dim
                @(A#R#T, 1, 4)
                ((cout,), output_shape, effective_bias, (1_4,));
            tensor.binary @(A#R#T, A#R#T, A#R#T)
                A#R#add @(4, output_shape) (convolved, broadcast_bias);
    end;

anx lam conv1d
    (A: Arithmetic)
    {n cin cout cin_per_group length kernel: Nat}
    (stride: Nat, padding: Nat, dilation: Nat,
     transposed: Bool, output_padding: Nat, groups: Nat)
    (input: «n, cin, length; A#R#T»,
     weight: «cout, cin_per_group, kernel; A#R#T»,
     bias: option.Opt «cout; A#R#T»)
  : «torch_conv1d_shape
        (n, cout, length, kernel, stride, dilation, padding); A#R#T» =
    let input_2d = tensor.reshape @(A#R#T, 3, 4)
        (n, cin, length) (n, cin, length, 1) input;
    let weight_2d = tensor.reshape @(A#R#T, 3, 4)
        (cout, cin_per_group, kernel) (cout, cin_per_group, kernel, 1) weight;
    let output_2d = general A
        @(n, cin, cout, cin_per_group, length, 1, kernel, 1)
        ((stride, 1), (padding, 0), (dilation, 1),
         transposed, (output_padding, 0), groups)
        (input_2d, weight_2d, bias);
    let output_shape = torch_conv1d_shape
        (n, cout, length, kernel, stride, dilation, padding);
    let output_2d_shape = tensor.conv_shape
        (n, cout, (length, 1), (kernel, 1),
         (stride, 1), (dilation, 1), (padding, 0));
    tensor.reshape @(A#R#T, 4, 3)
        output_2d_shape output_shape output_2d;

anx lam conv3d
    (A: Arithmetic)
    {n cin cout cin_per_group d h w kd kh kw: Nat}
    (stride: «3; Nat», padding: «3; Nat», dilation: «3; Nat»,
     transposed: Bool, output_padding: «3; Nat», groups: Nat)
    (input: «n, cin, d, h, w; A#R#T»,
     weight: «cout, cin_per_group, kd, kh, kw; A#R#T»,
     bias: option.Opt «cout; A#R#T»)
  : «conv3d_shape (n, cout, (d, h, w), (kd, kh, kw),
        stride, dilation, padding); A#R#T» =
    let output_padding_zero = core.bit2.and_ 0 (
        output_padding#0_3 == 0,
        core.bit2.and_ 0 (
            output_padding#1_3 == 0,
            output_padding#2_3 == 0));
    let valid = core.bit2.and_ 0 (
        core.icmp.e @2 (transposed, ff),
        core.bit2.and_ 0 (
            groups > 0,
            core.bit2.and_ 0 (
                output_padding_zero,
                core.bit2.and_ 0 (
                    cin == groups * cin_per_group,
                    cout % groups == 0))));
    runtime.require
        (valid, "convolution expects valid non-transposed grouped NCDHW parameters")
        body
    where
        lam body():
            «conv3d_shape (n, cout, (d, h, w), (kd, kh, kw),
                stride, dilation, padding); A#R#T» =
            let output_shape = conv3d_shape
                (n, cout, (d, h, w), (kd, kh, kw),
                 stride, dilation, padding);
            let convolved = torch_grouped_conv3d A
                @(n, cin, cout, cin_per_group, d, h, w, kd, kh, kw)
                (groups, stride, dilation, padding)
                (input, weight);
            let effective_bias = option.unwrap_or bias ‹cout; A#R#_0›;
            let broadcast_bias = tensor.broadcast_in_dim
                @(A#R#T, 1, 5)
                ((cout,), output_shape, effective_bias, (1_5,));
            tensor.binary @(A#R#T, A#R#T, A#R#T)
                A#R#add @(5, output_shape) (convolved, broadcast_bias);
    end;

anx lam transpose2d
    (A: Arithmetic)
    {n cin cout cout_per_group h w kh kw: Nat}
    (stride: «2; Nat», padding: «2; Nat», dilation: «2; Nat»,
     output_padding: «2; Nat», groups: Nat)
    (input: «n, cin, h, w; A#R#T»,
     weight: «cin, cout_per_group, kh, kw; A#R#T»,
     bias: option.Opt «cout; A#R#T»)
  : «conv_transpose2d_shape (n, cout, (h, w), (kh, kw),
        stride, dilation, padding, output_padding); A#R#T» =
    let output_padding_h_valid = core.bit2.or_ 0 (
        output_padding#0_2 < stride#0_2,
        output_padding#0_2 < dilation#0_2);
    let output_padding_w_valid = core.bit2.or_ 0 (
        output_padding#1_2 < stride#1_2,
        output_padding#1_2 < dilation#1_2);
    let effective_padding_valid = core.bit2.and_ 0 (
        padding#0_2 <= dilation#0_2 * (kh - 1),
        padding#1_2 <= dilation#1_2 * (kw - 1));
    let valid = core.bit2.and_ 0 (
        groups > 0,
        core.bit2.and_ 0 (
            cin % groups == 0,
            core.bit2.and_ 0 (
                cout == groups * cout_per_group,
                core.bit2.and_ 0 (
                    core.bit2.and_ 0 (
                        stride#0_2 > 0,
                        stride#1_2 > 0),
                    core.bit2.and_ 0 (
                        core.bit2.and_ 0 (
                            dilation#0_2 > 0,
                            dilation#1_2 > 0),
                        core.bit2.and_ 0 (
                            output_padding_h_valid,
                            core.bit2.and_ 0 (
                                output_padding_w_valid,
                                effective_padding_valid)))))));
    runtime.require
        (valid, "conv_transpose2d expects valid grouped NCHW parameters") body
    where
        lam body():
            «conv_transpose2d_shape (n, cout, (h, w), (kh, kw),
                stride, dilation, padding, output_padding); A#R#T» =
            let output_shape = conv_transpose2d_shape
                (n, cout, (h, w), (kh, kw),
                 stride, dilation, padding, output_padding);
            let convolved = torch_grouped_conv_transpose2d A
                @(n, cin, cout, cout_per_group, h, w, kh, kw)
                (groups, stride, dilation, padding, output_padding)
                (input, weight);
            let effective_bias = option.unwrap_or bias ‹cout; A#R#_0›;
            let broadcast_bias = tensor.broadcast_in_dim
                @(A#R#T, 1, 4)
                ((cout,), output_shape, effective_bias, (1_4,));
            tensor.binary @(A#R#T, A#R#T, A#R#T)
                A#R#add @(4, output_shape) (convolved, broadcast_bias);
    end;

anx lam transpose1d
    (A: Arithmetic)
    {n cin cout cout_per_group length kernel: Nat}
    (stride padding dilation output_padding groups: Nat)
    (input: «n, cin, length; A#R#T»,
     weight: «cin, cout_per_group, kernel; A#R#T»,
     bias: option.Opt «cout; A#R#T»)
  : «torch_conv_transpose1d_shape
        (n, cout, length, kernel, stride, dilation, padding, output_padding);
     A#R#T» =
    let input_2d = tensor.reshape @(A#R#T, 3, 4)
        (n, cin, length) (n, cin, length, 1) input;
    let weight_2d = tensor.reshape @(A#R#T, 3, 4)
        (cin, cout_per_group, kernel)
        (cin, cout_per_group, kernel, 1) weight;
    let output_2d = transpose2d A
        @(n, cin, cout, cout_per_group, length, 1, kernel, 1)
        ((stride, 1), (padding, 0), (dilation, 1),
         (output_padding, 0), groups)
        (input_2d, weight_2d, bias);
    let output_2d_shape = conv_transpose2d_shape
        (n, cout, (length, 1), (kernel, 1),
         (stride, 1), (dilation, 1), (padding, 0), (output_padding, 0));
    let output_shape = torch_conv_transpose1d_shape
        (n, cout, length, kernel, stride, dilation, padding, output_padding);
    tensor.reshape @(A#R#T, 4, 3)
        output_2d_shape output_shape output_2d;

anx lam transpose3d
    (A: Arithmetic)
    {n cin cout cout_per_group d h w kd kh kw: Nat}
    (stride: «3; Nat», padding: «3; Nat», dilation: «3; Nat»,
     output_padding: «3; Nat», groups: Nat)
    (input: «n, cin, d, h, w; A#R#T»,
     weight: «cin, cout_per_group, kd, kh, kw; A#R#T»,
     bias: option.Opt «cout; A#R#T»)
  : «conv_transpose3d_shape
        (n, cout, (d, h, w), (kd, kh, kw),
         stride, dilation, padding, output_padding); A#R#T» =
    let kernel = (kd, kh, kw);
    let axis_checks = ‹axis: 3;
        let output_padding_valid = core.bit2.or_ 0 (
            output_padding#axis < stride#axis,
            output_padding#axis < dilation#axis);
        let effective_padding_valid = padding#axis <= dilation#axis * (kernel#axis - 1);
        core.bit2.and_ 0 (
            stride#axis > 0,
            core.bit2.and_ 0 (
                dilation#axis > 0,
                core.bit2.and_ 0 (
                    output_padding_valid, effective_padding_valid)))›;
    let axes_valid = vec.fold.l (core.bit2.and_ 0) (tt, axis_checks);
    let valid = core.bit2.and_ 0 (
        axes_valid,
        core.bit2.and_ 0 (
            groups > 0,
            core.bit2.and_ 0 (
                cin % groups == 0,
                cout == groups * cout_per_group)));
    runtime.require
        (valid, "conv_transpose3d expects valid grouped NCDHW parameters")
        body
    where
        lam body():
            «conv_transpose3d_shape
                (n, cout, (d, h, w), (kd, kh, kw),
                 stride, dilation, padding, output_padding); A#R#T» =
            let output_shape = conv_transpose3d_shape
                (n, cout, (d, h, w), (kd, kh, kw),
                 stride, dilation, padding, output_padding);
            let convolved = torch_grouped_conv_transpose3d A
                @(n, cin, cout, cout_per_group, d, h, w, kd, kh, kw)
                (groups, stride, dilation, padding, output_padding)
                (input, weight);
            let effective_bias = option.unwrap_or bias ‹cout; A#R#_0›;
            let broadcast_bias = tensor.broadcast_in_dim
                @(A#R#T, 1, 5)
                ((cout,), output_shape, effective_bias, (1_5,));
            tensor.binary @(A#R#T, A#R#T, A#R#T)
                A#R#add @(5, output_shape) (convolved, broadcast_bias);
    end;

end

pub mod activation_impl
anx lam relu (A: Arithmetic)
                                {r: Nat, s: «r; Nat»}
                                (input: «s; A#R#T»): «s; A#R#T» =
    tensor.unary @(A#R#T, A#R#T) (torch_relu_scalar A) @(r, s) input;

anx lam leaky_relu (F: Floating)
                                      {r: Nat, s: «r; Nat»}
                                      (input: «s; F#A#R#T»,
                                       negative_slope: F#A#R#T): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_leaky_relu_scalar F negative_slope) @(r, s) input;

anx lam tanh (F: Floating) {r: Nat, s: «r; Nat»}
                                (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T) (torch_tanh_scalar F) @(r, s) input;

anx lam sigmoid (F: Floating) {r: Nat, s: «r; Nat»}
                                   (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_sigmoid_scalar F) @(r, s) input;

anx lam silu (F: Floating) {r: Nat, s: «r; Nat»}
                                (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_silu_scalar F) @(r, s) input;

anx lam gelu (F: Floating) {r: Nat, s: «r; Nat»}
                                (approximate_tanh: Bool,
                                 input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_gelu_scalar F approximate_tanh) @(r, s) input;

anx lam elu (F: Floating) {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T», alpha scale input_scale: F#A#R#T)
  : «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_elu_scalar F (alpha, scale, input_scale)) @(r, s) input;

anx lam selu (F: Floating) {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»): «s; F#A#R#T» =
    let alpha = F#A#div (F#from_nat 1673263, F#from_nat 1000000);
    let scale = F#A#div (F#from_nat 1050701, F#from_nat 1000000);
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_elu_scalar F (alpha, scale, F#from_nat 1)) @(r, s) input;

anx lam hardsigmoid (F: Floating)
    {r: Nat, s: «r; Nat»} (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_hardsigmoid_scalar F) @(r, s) input;

anx lam softplus (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T», beta threshold: F#A#R#T): «s; F#A#R#T» =
    runtime.require (F#A#ne (beta, F#A#R#_0), "softplus expects beta != 0") body
    where
        lam body(): «s; F#A#R#T» =
            tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_softplus_scalar F (beta, threshold)) @(r, s) input;
    end;

anx lam hardtanh (A: Arithmetic)
                                    {r: Nat, s: «r; Nat»}
                                    (input: «s; A#R#T»,
                                     minimum: A#R#T, maximum: A#R#T): «s; A#R#T» =
    runtime.require
        (A#le (minimum, maximum), "hardtanh expects min_val <= max_val") body
    where
        lam body(): «s; A#R#T» =
            let lower_bounded = tensor.unary @(A#R#T, A#R#T)
                (torch_clamp_min_scalar A minimum) @(r, s) input;
            tensor.unary @(A#R#T, A#R#T)
                (torch_clamp_max_scalar A maximum) @(r, s) lower_bounded;
    end;

anx lam threshold (A: Arithmetic)
                             {r: Nat, s: «r; Nat»}
                             (input: «s; A#R#T»,
                              threshold: A#R#T, value: A#R#T): «s; A#R#T» =
    tensor.unary @(A#R#T, A#R#T)
        (torch_threshold_scalar A (threshold, value)) @(r, s) input;

anx lam clamp (A: Arithmetic)
                         {r: Nat, s: «r; Nat»}
                         (input: «s; A#R#T»,
                          minimum: option.Opt A#R#T,
                          maximum: option.Opt A#R#T): «s; A#R#T» =
    let valid = core.bit2.or_ 0
        (option.is_some minimum, option.is_some maximum);
    runtime.require (valid, "clamp expects at least one of min or max") body
    where
        lam body(): «s; A#R#T» =
            let lower_bounded = match minimum with
                | bound: A#R#T =>
                    tensor.unary @(A#R#T, A#R#T)
                        (torch_clamp_min_scalar A bound) @(r, s) input
                | _: [] => input;
            match maximum with
                | bound: A#R#T =>
                    tensor.unary @(A#R#T, A#R#T)
                        (torch_clamp_max_scalar A bound) @(r, s) lower_bounded
                | _: [] => lower_bounded;
    end;

anx lam mish (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»): «s; F#A#R#T» =
    tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_mish_scalar F) @(r, s) input;

end

pub mod reduction_impl
anx lam sum_dim (A: Arithmetic)
                           {r: Nat, s: «r; Nat»}
                           (dimension: I64)
                           (input: «s; A#R#T»)
                         : «torch_reduce_shape (s, torch_canonical_dim @r dimension); A#R#T» =
    runtime.require (torch_dim_in_range @r dimension, "sum.dim expects an in-range dim") body
    where
        lam body(): «torch_reduce_shape (s, torch_canonical_dim @r dimension); A#R#T» =
            let dim = torch_canonical_dim @r dimension;
            torch_reduce_dim (A#R#add, A#R#_0) (s, dim) input;
    end;

anx lam sum_dim_keepdim (A: Arithmetic)
                                   {r: Nat, s: «r; Nat»}
                                   (dimension: I64)
                                   (input: «s; A#R#T»)
                                 : «torch_keepdim_shape (s, torch_canonical_dim @r dimension); A#R#T» =
    runtime.require (torch_dim_in_range @r dimension, "sum.dim expects an in-range dim") body
    where
        lam body(): «torch_keepdim_shape (s, torch_canonical_dim @r dimension); A#R#T» =
            let dim = torch_canonical_dim @r dimension;
            let reduced = torch_reduce_dim (A#R#add, A#R#_0) (s, dim) input;
            tensor.reshape @(A#R#T, r - 1, r)
                (torch_reduce_shape (s, dim)) (torch_keepdim_shape (s, dim)) reduced;
    end;

anx lam amax_dim (F: Floating)
                            {r: Nat, s: «r; Nat»}
                            (dimension: I64)
                            (input: «s; F#A#R#T»)
                          : «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T» =
    runtime.require (torch_dim_in_range @r dimension, "amax expects an in-range dim") body
    where
        lam body(): «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T» =
            let dim = torch_canonical_dim @r dimension;
            runtime.require
                (s#dim != 0,
                 "amax reduction dimensions must have non-zero size")
                reduce
            where
                lam reduce():
                    «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T» =
                    torch_reduce_dim (F#A#maximum, F#neg_inf) (s, dim) input;
            end;
    end;

anx lam max_dim (F: Floating) {r: Nat, s: «r; Nat»}
                           (dimension: I64) (input: «s; F#A#R#T»)
                         : [Bool,
                            «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T»,
                            «torch_reduce_shape (s, torch_canonical_dim @r dimension); I64»] =
    runtime.require
        (core.bit2.and_ 0 (
            torch_dim_in_range @r dimension,
            s#(torch_canonical_dim @r dimension) > 0),
         "max.dim expects an in-range non-empty dimension")
        body
    where lam body() =
        torch_arg_extrema F (tt, torch_canonical_dim @r dimension) input;
    end;

anx lam min_dim (F: Floating) {r: Nat, s: «r; Nat»}
                           (dimension: I64) (input: «s; F#A#R#T»)
                         : [Bool,
                            «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T»,
                            «torch_reduce_shape (s, torch_canonical_dim @r dimension); I64»] =
    runtime.require
        (core.bit2.and_ 0 (
            torch_dim_in_range @r dimension,
            s#(torch_canonical_dim @r dimension) > 0),
         "min.dim expects an in-range non-empty dimension")
        body
    where lam body() =
        torch_arg_extrema F (ff, torch_canonical_dim @r dimension) input;
    end;

anx lam mean_dim (F: Floating)
                            {r: Nat, s: «r; Nat»}
                            (dimension: I64)
                            (input: «s; F#A#R#T»)
                          : «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T» =
    runtime.require (torch_dim_in_range @r dimension, "mean.dim expects an in-range dim") body
    where
        lam body(): «torch_reduce_shape (s, torch_canonical_dim @r dimension); F#A#R#T» =
            let dim = torch_canonical_dim @r dimension;
            let reduced = torch_reduce_dim (F#A#R#add, F#A#R#_0) (s, dim) input;
            let count = F#from_nat (s#dim);
            tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count)
                @(r - 1, torch_reduce_shape (s, dim)) reduced;
    end;

anx lam mean_dim_keepdim (F: Floating)
                                    {r: Nat, s: «r; Nat»}
                                    (dimension: I64)
                                    (input: «s; F#A#R#T»)
                                  : «torch_keepdim_shape
                                        (s, torch_canonical_dim @r dimension); F#A#R#T» =
    runtime.require
        (torch_dim_in_range @r dimension, "mean.dim expects an in-range dim")
        body
    where
        lam body(): «torch_keepdim_shape
                        (s, torch_canonical_dim @r dimension); F#A#R#T» =
            let dim = torch_canonical_dim @r dimension;
            let reduced = torch_reduce_dim
                (F#A#R#add, F#A#R#_0) (s, dim) input;
            let count = F#from_nat (s#dim);
            let mean = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count)
                @(r - 1, torch_reduce_shape (s, dim)) reduced;
            tensor.reshape @(F#A#R#T, r - 1, r)
                (torch_reduce_shape (s, dim))
                (torch_keepdim_shape (s, dim)) mean;
    end;

anx lam sum_dims (A: Arithmetic)
                            {r nr: Nat, s: «r; Nat»}
                            (dimensions: «nr; I64»)
                            (input: «s; A#R#T»)
                          : «torch_multi_reduce_shape
                                (s, torch_canonical_dims @(r, nr) dimensions); A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions, "sum.dim expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            «torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions); A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            torch_multi_reduce (A#R#add, A#R#_0) (s, dims) input;
    end;

anx lam sum_dims_keepdim (A: Arithmetic)
                                    {r nr: Nat, s: «r; Nat»}
                                    (dimensions: «nr; I64»)
                                    (input: «s; A#R#T»)
                                  : «torch_multi_keepdim_shape
                                        (s, torch_canonical_dims @(r, nr) dimensions); A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions, "sum.dim expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            «torch_multi_keepdim_shape
                (s, torch_canonical_dims @(r, nr) dimensions); A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let reduced = torch_multi_reduce (A#R#add, A#R#_0) (s, dims) input;
            tensor.reshape
                @(A#R#T, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims))
                reduced;
    end;

anx lam sum (A: Arithmetic)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», keepdim: Bool)
    (input: «s; A#R#T»)
  =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "sum expects non-empty, unique, in-range dims")
        body
    where
        lam body() =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let reduced = torch_multi_reduce
                (A#R#add, A#R#_0) (s, dims) input;
            let kept = tensor.reshape
                @(A#R#T, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims))
                reduced;
            (reduced, kept)#keepdim;
    end;

anx lam sum_typed (D: Reduction)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», keepdim: Bool)
    (input: «s; D#Input») =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "sum expects non-empty, unique, in-range dims")
        body
    where
        lam body() =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let converted = tensor.unary @(D#Input, D#Output)
                D#cast @(r, s) input;
            let reduced = torch_multi_reduce
                (D#add, D#zero) (s, dims) converted;
            let kept = tensor.reshape
                @(D#Output, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims)) reduced;
            (reduced, kept)#keepdim;
    end;

anx lam norm2_dims (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64»)
    (input: «s; F#A#R#T»)
  : «torch_multi_reduce_shape
        (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "norm expects non-empty, unique, in-range dims")
        body
    where
        lam body(): «torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let squared = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_square_scalar F#A) @(r, s) input;
            let reduced = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) squared;
            tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_sqrt_scalar F)
                @(torch_reduced_rank dims, torch_multi_reduce_shape (s, dims))
                reduced;
    end;

anx lam norm2_dims_keepdim (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64»)
    (input: «s; F#A#R#T»)
  : «torch_multi_keepdim_shape
        (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "norm expects non-empty, unique, in-range dims")
        body
    where
        lam body(): «torch_multi_keepdim_shape
                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let squared = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_square_scalar F#A) @(r, s) input;
            let reduced = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) squared;
            let kept = tensor.reshape
                @(F#A#R#T, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims))
                reduced;
            tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_sqrt_scalar F)
                @(r, torch_multi_keepdim_shape (s, dims)) kept;
    end;

anx lam vector_norm (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», keepdim: Bool, p: F#A#R#T)
    (input: «s; F#A#R#T») =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "norm expects non-empty, unique, in-range dims")
        body
    where
        lam body() =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let out_rank = torch_reduced_rank dims;
            let out_shape = torch_multi_reduce_shape (s, dims);
            let absolute = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_abs_scalar F#A) @(r, s) input;
            let powered = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_pow_scalar F p) @(r, s) absolute;
            let power_sum = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) powered;
            let reciprocal = F#A#div (F#from_nat 1, p);
            let lp = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_pow_scalar F reciprocal) @(out_rank, out_shape) power_sum;
            let nonzero = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_nonzero_count_scalar F) @(r, s) absolute;
            let zero_norm = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) nonzero;
            let pos_inf = F#A#sub (F#A#R#_0, F#neg_inf);
            let max_norm = torch_multi_reduce
                (F#A#maximum, F#A#R#_0) (s, dims) absolute;
            let min_norm = torch_multi_reduce
                (F#A#minimum, pos_inf) (s, dims) absolute;
            let finite_or_zero = core.select @«out_shape; F#A#R#T»
                (F#A#is_zero p, zero_norm, lp);
            let with_pos_inf = core.select @«out_shape; F#A#R#T»
                (F#A#eq (p, pos_inf), max_norm, finite_or_zero);
            let reduced = core.select @«out_shape; F#A#R#T»
                (F#A#eq (p, F#neg_inf), min_norm, with_pos_inf);
            let kept = tensor.reshape @(F#A#R#T, out_rank, r)
                out_shape (torch_multi_keepdim_shape (s, dims)) reduced;
            (reduced, kept)#keepdim;
    end;

anx lam norm2_all (F: Floating)
                            {r: Nat, s: «r; Nat»}
                            (input: «s; F#A#R#T»): F#A#R#T =
    let squared = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_square_scalar F#A) @(r, s) input;
    F#sqrt (torch_sum_all_runtime F#A @(r, s) squared);

anx lam sum_typed_all (D: Reduction)
    {r: Nat, s: «r; Nat»} (input: «s; D#Input»): D#Output =
    let converted = tensor.unary @(D#Input, D#Output)
        D#cast @(r, s) input;
    torch_reduce_all_runtime (D#add, D#zero) @(r, s) converted;

anx lam sum_all (A: Arithmetic)
                           {r: Nat, s: «r; Nat»}
                           (input: «s; A#R#T»): A#R#T =
    torch_sum_all_runtime A @(r, s) input;

anx lam amax_all (F: Floating)
                            {r: Nat, s: «r; Nat»}
                            (input: «s; F#A#R#T»): F#A#R#T =
    runtime.require
        (torch_numel s != 0,
         "amax reduction dimensions must have non-zero size")
        body
    where
        lam body(): F#A#R#T =
            torch_reduce_all_runtime (F#A#maximum, F#neg_inf) @(r, s) input;
    end;

anx lam mean_all (F: Floating)
                            {r: Nat, s: «r; Nat»}
                            (input: «s; F#A#R#T»): F#A#R#T =
    let sum = torch_sum_all_runtime F#A @(r, s) input;
    let count = F#from_nat (torch_numel s);
    F#A#div (sum, count);

anx lam var_mean_all (F: Floating)
    {r: Nat, s: «r; Nat»}
    (correction: F#A#R#T)
    (input: «s; F#A#R#T»): [Bool, F#A#R#T, F#A#R#T] =
    let n = torch_numel s;
    let count = F#from_nat n;
    let flat = tensor.reshape @(F#A#R#T, r, 1) s (n,) input;
    let values = ‹i: n; flat#(i,)›;
    let sum = vec.fold.l F#A#R#add (F#A#R#_0, values);
    let arithmetic_mean = F#A#div (sum, count);
    let nonfinite_count = vec.fold.l F#A#R#add
        (F#A#R#_0, ‹i: n; torch_nonfinite_count_scalar F (values#i)›);
    let mean = torch_var_mean_adjust_mean F
        (arithmetic_mean, nonfinite_count);
    // Full reductions are statically specialized by the frontend, so PE
    // unrolls this scalar fold without creating a rank-zero tensor buffer.
    let squared_centered = ‹i: n;
        let delta = F#A#sub (values#i, mean);
        F#A#R#mul (delta, delta)›;
    let centered_sum_sq = vec.fold.l
        F#A#R#add (F#A#R#_0, squared_centered);
    let denominator = F#A#maximum (
        F#A#sub (count, correction), F#A#R#_0);
    let variance = F#A#div (centered_sum_sq, denominator);
    (ff, variance, mean);

anx lam var_mean_singletons (F: Floating)
    {r: Nat, s: «r; Nat»}
    (correction: F#A#R#T)
    (input: «s; F#A#R#T»): [Bool, «s; F#A#R#T», «s; F#A#R#T»] =
    let one = F#from_nat 1;
    let denominator = F#A#maximum (
        F#A#sub (one, correction), F#A#R#_0);
    let singleton_variance = F#A#div (F#A#R#_0, denominator);
    let variance = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_constant_scalar F#A singleton_variance) @(r, s) input;
    (ff, variance, input);

anx lam amax_dims (F: Floating)
                             {r nr: Nat, s: «r; Nat»}
                             (dimensions: «nr; I64»)
                             (input: «s; F#A#R#T»)
                           : «torch_multi_reduce_shape
                                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions, "amax expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            «torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            runtime.require
                (torch_reduction_extents_nonzero (s, dims),
                 "amax reduction dimensions must have non-zero size")
                reduce
            where
                lam reduce():
                    «torch_multi_reduce_shape (s, dims); F#A#R#T» =
                    torch_multi_reduce
                        (F#A#maximum, F#neg_inf) (s, dims) input;
            end;
    end;

anx lam mean_dims (F: Floating)
                             {r nr: Nat, s: «r; Nat»}
                             (dimensions: «nr; I64»)
                             (input: «s; F#A#R#T»)
                           : «torch_multi_reduce_shape
                                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions, "mean.dim expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            «torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let reduced = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) input;
            let count = F#from_nat (torch_reduction_numel (s, dims));
            tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count)
                @(torch_reduced_rank dims, torch_multi_reduce_shape (s, dims))
                reduced;
    end;

anx lam mean_dims_keepdim
    (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64»)
    (input: «s; F#A#R#T»)
  : «torch_multi_keepdim_shape
        (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "mean.dim expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            «torch_multi_keepdim_shape
                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let reduced = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) input;
            let count = F#from_nat (torch_reduction_numel (s, dims));
            let mean = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count)
                @(torch_reduced_rank dims, torch_multi_reduce_shape (s, dims))
                reduced;
            tensor.reshape
                @(F#A#R#T, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims))
                mean;
    end;

anx lam mean (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», keepdim: Bool)
    (input: «s; F#A#R#T») =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "mean expects non-empty, unique, in-range dims")
        body
    where
        lam body() =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let sums = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) input;
            let count = F#from_nat (torch_reduction_numel (s, dims));
            let reduced = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count)
                @(torch_reduced_rank dims, torch_multi_reduce_shape (s, dims))
                sums;
            let kept = tensor.reshape
                @(F#A#R#T, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims)) reduced;
            (reduced, kept)#keepdim;
    end;

anx lam amax (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», keepdim: Bool)
    (input: «s; F#A#R#T») =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "amax expects non-empty, unique, in-range dims")
        body
    where
        lam body() =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            runtime.require
                (torch_reduction_extents_nonzero (s, dims),
                 "amax reduction dimensions must have non-zero size")
                reduce
            where
                lam reduce() =
                    let reduced = torch_multi_reduce
                        (F#A#maximum, F#neg_inf) (s, dims) input;
                    let kept = tensor.reshape
                        @(F#A#R#T, torch_reduced_rank dims, r)
                        (torch_multi_reduce_shape (s, dims))
                        (torch_multi_keepdim_shape (s, dims)) reduced;
                    (reduced, kept)#keepdim;
            end;
    end;

anx lam var_mean_dims
    (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», correction: F#A#R#T)
    (input: «s; F#A#R#T»)
  : let s_out = torch_multi_reduce_shape
        (s, torch_canonical_dims @(r, nr) dimensions);
    [Bool, «s_out; F#A#R#T», «s_out; F#A#R#T»] =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "var_mean expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            let s_out = torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions);
            [Bool, «s_out; F#A#R#T», «s_out; F#A#R#T»] =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let s_out = torch_multi_reduce_shape (s, dims);
            let sum = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) input;
            let count = F#from_nat (torch_reduction_numel (s, dims));
            let arithmetic_mean = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count)
                @(torch_reduced_rank dims, s_out) sum;
            let nonfinite = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_nonfinite_count_scalar F) @(r, s) input;
            let nonfinite_count = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) nonfinite;
            let mean = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                (torch_var_mean_adjust_mean F)
                @(torch_reduced_rank dims, s_out)
                (arithmetic_mean, nonfinite_count);
            // Two-pass centered variance avoids the cancellation in
            // E[x^2] - E[x]^2 for large-offset inputs.
            let mean_b = tensor.broadcast_in_dim
                @(F#A#R#T, torch_reduced_rank dims, r)
                (s_out, s, mean, torch_kept_axes dims);
            let centered = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#sub @(r, s) (input, mean_b);
            let squared_centered = tensor.unary
                @(F#A#R#T, F#A#R#T)
                (torch_square_scalar F#A) @(r, s) centered;
            let centered_sum_sq = torch_multi_reduce
                (F#A#R#add, F#A#R#_0) (s, dims) squared_centered;
            // PyTorch clamps non-positive degrees of freedom to zero. IEEE
            // division then produces NaN or Inf instead of a runtime error.
            let denominator = F#A#maximum (
                F#A#sub (count, correction), F#A#R#_0);
            let variance = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A denominator)
                @(torch_reduced_rank dims, s_out) centered_sum_sq;
            // The heterogeneous tag prevents `[variance, mean]` from
            // normalizing into one rank-higher tensor when shapes coincide.
            (ff, variance, mean);
    end;

anx lam var_mean (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», correction: F#A#R#T, keepdim: Bool)
    (input: «s; F#A#R#T») =
    let reduced_pair = var_mean_dims F
        @(r, nr, s) (dimensions, correction) input;
    let dims = torch_canonical_dims @(r, nr) dimensions;
    let reduced_shape = torch_multi_reduce_shape (s, dims);
    let kept_shape = torch_multi_keepdim_shape (s, dims);
    let variance = reduced_pair#1_3;
    let mean = reduced_pair#2_3;
    let variance_kept = tensor.reshape
        @(F#A#R#T, torch_reduced_rank dims, r)
        reduced_shape kept_shape variance;
    let mean_kept = tensor.reshape
        @(F#A#R#T, torch_reduced_rank dims, r)
        reduced_shape kept_shape mean;
    (ff, (variance, variance_kept)#keepdim, (mean, mean_kept)#keepdim);

anx lam any_dims {r nr: Nat, s: «r; Nat»}
                            (dimensions: «nr; I64»)
                            (input: «s; Bool»)
                          : «torch_multi_reduce_shape
                                (s, torch_canonical_dims @(r, nr) dimensions); Bool» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions, "any expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            «torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions); Bool» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            torch_multi_reduce (core.bit2.or_ 0, ff) (s, dims) input;
    end;

anx lam all_dims {r nr: Nat, s: «r; Nat»}
                            (dimensions: «nr; I64»)
                            (input: «s; Bool»)
                          : «torch_multi_reduce_shape
                                (s, torch_canonical_dims @(r, nr) dimensions); Bool» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions, "all expects non-empty, unique, in-range dims")
        body
    where
        lam body():
            «torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions); Bool» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            torch_multi_reduce (core.bit2.and_ 0, tt) (s, dims) input;
    end;

anx lam logsumexp_dims (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64»)
    (input: «s; F#A#R#T»)
  : «torch_multi_reduce_shape
        (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "logsumexp expects non-empty, unique, in-range dims")
        body
    where
        lam body(): «torch_multi_reduce_shape
                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
            torch_logsumexp_dims F @(r, nr, s) dimensions input;
    end;

anx lam logsumexp_dims_keepdim (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64»)
    (input: «s; F#A#R#T»)
  : «torch_multi_keepdim_shape
        (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "logsumexp expects non-empty, unique, in-range dims")
        body
    where
        lam body(): «torch_multi_keepdim_shape
                (s, torch_canonical_dims @(r, nr) dimensions); F#A#R#T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let reduced = torch_logsumexp_dims F
                @(r, nr, s) dimensions input;
            tensor.reshape
                @(F#A#R#T, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims))
                reduced;
    end;

anx lam logsumexp (F: Floating)
    {r nr: Nat, s: «r; Nat»}
    (dimensions: «nr; I64», keepdim: Bool)
    (input: «s; F#A#R#T») =
    runtime.require
        (torch_dims_valid @(r, nr) dimensions,
         "logsumexp expects non-empty, unique, in-range dims")
        body
    where
        lam body() =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            let reduced = torch_logsumexp_dims F
                @(r, nr, s) dimensions input;
            let kept = tensor.reshape
                @(F#A#R#T, torch_reduced_rank dims, r)
                (torch_multi_reduce_shape (s, dims))
                (torch_multi_keepdim_shape (s, dims)) reduced;
            (reduced, kept)#keepdim;
    end;

end
/// Selects training batch statistics or inference running statistics. The
/// continuation-style branch keeps the unused path out of the normalized IR
/// whenever `training` is static.
lam torch_batch_norm_stats (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     running_mean running_var:
        option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
     training: Bool)
  : [Bool,
     «s#(torch_channel_dim @r); F#A#R#T»,
     «s#(torch_channel_dim @r); F#A#R#T»] =
    (inference_stats, training_stats)#training ()
    where
        lam training_stats():
            [Bool,
             «s#(torch_channel_dim @r); F#A#R#T»,
             «s#(torch_channel_dim @r); F#A#R#T»] =
            let channel_dim = torch_channel_dim @r;
            let channels = s#channel_dim;
            // Move C last and flatten all sample axes. Reducing axis zero then
            // has the manifest result shape `[C]`, avoiding a proof that a
            // symbolic multi-axis reduction leaves exactly the channel axis.
            let permutation = ‹d: r;
                core.idx 0 r  ((torch_reduce_subscripts @r channel_dim)#d)›;
            let transposed_shape = torch_transpose_shape (s, permutation);
            let transposed = tensor.transpose @(F#A#R#T, r)
                permutation input;
            let examples = torch_numel (torch_reduce_shape (s, channel_dim));
            let flat = tensor.reshape @(F#A#R#T, r, 2)
                transposed_shape (examples, channels) transposed;
            let pair = reduction_impl.var_mean_dims F
                @(2, 1, (examples, channels))
                ((0I64,), F#A#R#_0) flat;
            (ff, pair#2_3, pair#1_3);
        lam inference_stats():
            [Bool,
             «s#(torch_channel_dim @r); F#A#R#T»,
             «s#(torch_channel_dim @r); F#A#R#T»] =
            let channels = s#(torch_channel_dim @r);
            (ff,
             option.unwrap_or running_mean ‹channels; F#A#R#_0›,
             option.unwrap_or running_var ‹channels; F#A#R#_0›);
    end;

pub mod normalization_impl
anx lam native_layer_norm
    (F: Floating)
    {rb rn: Nat}
    (batch_shape: «rb; Nat», normalized_shape: «rn; Nat»)
    (input: «vec.cat (batch_shape, normalized_shape); F#A#R#T»)
    (weight: option.Opt «normalized_shape; F#A#R#T»,
     bias: option.Opt «normalized_shape; F#A#R#T»)
    (eps: F#A#R#T)
  : [«vec.cat (batch_shape, normalized_shape); F#A#R#T»,
     «vec.cat (batch_shape, ‹i: rn; 1›); F#A#R#T»,
     «vec.cat (batch_shape, ‹i: rn; 1›); F#A#R#T»] =
    runtime.require
        (rn >= 1, "native_layer_norm expects a non-empty normalized_shape")
        body
    where
        lam body():
            [«vec.cat (batch_shape, normalized_shape); F#A#R#T»,
             «vec.cat (batch_shape, ‹i: rn; 1›); F#A#R#T»,
             «vec.cat (batch_shape, ‹i: rn; 1›); F#A#R#T»] =
            let full_shape = vec.cat (batch_shape, normalized_shape);
            let stat_shape = vec.cat (batch_shape, ‹i: rn; 1›);
            let outer = torch_numel batch_shape;
            let inner = torch_numel normalized_shape;
            let flat_shape = (outer, inner);
            let flat_input = tensor.reshape
                @(F#A#R#T, rb + rn, 2)
                full_shape flat_shape input;
            let reduction_dim = 1_2;
            let sum = torch_reduce_dim
                (F#A#R#add, F#A#R#_0) (flat_shape, reduction_dim) flat_input;
            let count = F#from_nat inner;
            let mean = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count) @(1, (outer,)) sum;
            let mean_b = torch_broadcast_reduced @(F#A#R#T, 2)
                (flat_shape, reduction_dim) mean;
            let centered = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#sub @(2, flat_shape) (flat_input, mean_b);
            let squared = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#mul @(2, flat_shape) (centered, centered);
            let variance_sum = torch_reduce_dim
                (F#A#R#add, F#A#R#_0) (flat_shape, reduction_dim) squared;
            let variance = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_div_scalar F#A count) @(1, (outer,)) variance_sum;
            let variance_eps = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_add_scalar F#A eps) @(1, (outer,)) variance;
            let rstd = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_rsqrt_scalar F) @(1, (outer,)) variance_eps;
            let rstd_b = torch_broadcast_reduced @(F#A#R#T, 2)
                (flat_shape, reduction_dim) rstd;
            let normalized = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#mul @(2, flat_shape) (centered, rstd_b);
            // Keep tensor-valued Options out of branch functions. The option
            // normalizer resolves known Some/None values before tensor lowering.
            let default_weight = tensor.splat @(F#A#R#T, rn)
                (normalized_shape, F#from_nat 1);
            let effective_weight = option.unwrap_or weight default_weight;
            let flat_weight = tensor.reshape
                @(F#A#R#T, rn, 1) normalized_shape (inner,) effective_weight;
            let weight_b = tensor.broadcast_in_dim
                @(F#A#R#T, 1, 2)
                ((inner,), flat_shape, flat_weight, (1_2,));
            let scaled = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#mul @(2, flat_shape) (normalized, weight_b);
            let default_bias = tensor.splat @(F#A#R#T, rn)
                (normalized_shape, F#A#R#_0);
            let effective_bias = option.unwrap_or bias default_bias;
            let flat_bias = tensor.reshape
                @(F#A#R#T, rn, 1) normalized_shape (inner,) effective_bias;
            let bias_b = tensor.broadcast_in_dim
                @(F#A#R#T, 1, 2)
                ((inner,), flat_shape, flat_bias, (1_2,));
            let shifted = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#add @(2, flat_shape) (scaled, bias_b);
            let output = tensor.reshape
                @(F#A#R#T, 2, rb + rn)
                flat_shape full_shape shifted;
            let mean_out = tensor.reshape
                @(F#A#R#T, 1, rb + rn)
                (outer,) stat_shape mean;
            let rstd_out = tensor.reshape
                @(F#A#R#T, 1, rb + rn)
                (outer,) stat_shape rstd;
            (output, mean_out, rstd_out);
    end;

anx lam group_norm
    (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     weight: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
     bias: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
     groups: Nat, eps: F#A#R#T): «s; F#A#R#T» =
    runtime.require (r >= 2, "group_norm expects rank >= 2") rank_ok
    where
        lam rank_ok(): «s; F#A#R#T» =
            runtime.require (groups > 0, "group_norm expects groups > 0") groups_ok;
        lam groups_ok(): «s; F#A#R#T» =
            let channels = s#(torch_channel_dim @r);
            runtime.require
                (channels % groups == 0,
                 "group_norm expects channels divisible by groups") body;
        lam body(): «s; F#A#R#T» =
            let channels = s#(torch_channel_dim @r);
            let batch_shape = (s#(core.idx 0 r  0), groups);
            let normalized_shape = torch_group_norm_suffix (s, groups);
            let grouped_shape = vec.cat (batch_shape, normalized_shape);
            let grouped_rank = 2 + (r - 1);
            let grouped = tensor.reshape
                @(F#A#R#T, r, grouped_rank)
                s grouped_shape input;
            let stats = native_layer_norm F
                @(2, r - 1)
                (batch_shape, normalized_shape) grouped
                ((option.none @«normalized_shape; F#A#R#T»),
                 (option.none @«normalized_shape; F#A#R#T»)) eps;
            let normalized = tensor.reshape
                @(F#A#R#T, grouped_rank, r)
                grouped_shape s stats#0_3;
            let effective_weight = option.unwrap_or
                weight ‹channels; F#from_nat 1›;
            let effective_bias = option.unwrap_or
                bias ‹channels; F#A#R#_0›;
            let channel_dim = torch_channel_dim @r;
            let weight_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                ((channels,), s, effective_weight, (channel_dim,));
            let bias_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                ((channels,), s, effective_bias, (channel_dim,));
            let scaled = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#mul @(r, s) (normalized, weight_b);
            tensor.binary @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#add @(r, s) (scaled, bias_b);
    end;

anx lam batch_norm_inference
    (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     weight: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
     bias: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
     running_mean: «s#(torch_channel_dim @r); F#A#R#T»,
     running_var: «s#(torch_channel_dim @r); F#A#R#T»,
     eps: F#A#R#T): «s; F#A#R#T» =
    runtime.require (r >= 2, "batch_norm expects rank >= 2") body
    where
        lam body(): «s; F#A#R#T» =
            let channel_dim = torch_channel_dim @r;
            let channels = s#channel_dim;
            let variance_eps = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_add_scalar F#A eps) @(1, (channels,)) running_var;
            let rstd = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_rsqrt_scalar F) @(1, (channels,)) variance_eps;
            let mean_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                (channels, s, running_mean, (channel_dim,));
            let rstd_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                (channels, s, rstd, (channel_dim,));
            let centered = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#sub @(r, s) (input, mean_b);
            let normalized = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#mul @(r, s) (centered, rstd_b);
            // Avoid tensor-typed branch functions: the option variant is a
            // compile-time API choice, while its tensor payload stays dynamic.
            let effective_weight = option.unwrap_or
                weight ‹channels; F#from_nat 1›;
            let effective_bias = option.unwrap_or
                bias ‹channels; F#A#R#_0›;
            let weight_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                (channels, s, effective_weight, (channel_dim,));
            let bias_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                (channels, s, effective_bias, (channel_dim,));
            let scaled = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#mul @(r, s) (normalized, weight_b);
            tensor.binary @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#add @(r, s) (scaled, bias_b);
    end;

anx lam native_batch_norm (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     weight bias running_mean running_var:
        option.Opt «s#(torch_channel_dim @r); F#A#R#T»)
    (training: Bool, momentum eps: F#A#R#T)
  : [«s; F#A#R#T»,
     «s#(torch_channel_dim @r); F#A#R#T»,
     «s#(torch_channel_dim @r); F#A#R#T»] =
    let channel_dim = torch_channel_dim @r;
    let examples = torch_numel (torch_reduce_shape (s, channel_dim));
    let valid = core.bit2.and_ 0 (
        training,
        core.bit2.and_ 0 (
            r >= 2,
            core.bit2.and_ 0 (
                examples > 1,
                core.bit2.and_ 0 (
                    F#A#ge (momentum, F#A#R#_0),
                    F#A#le (momentum, F#from_nat 1)))));
    runtime.require
        (valid,
         "native_batch_norm currently expects training, rank >= 2, more than one value per channel, and momentum in [0,1]")
        body
    where
        lam body(): [«s; F#A#R#T»,
                     «s#(torch_channel_dim @r); F#A#R#T»,
                     «s#(torch_channel_dim @r); F#A#R#T»] =
            let stats = torch_batch_norm_stats F
                @(r, s) (input, running_mean, running_var, training);
            let mean = stats#1_3;
            let variance = stats#2_3;
            let channels = s#(torch_channel_dim @r);
            let variance_eps = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_add_scalar F#A eps) @(1, (channels,)) variance;
            let invstd = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_rsqrt_scalar F) @(1, (channels,)) variance_eps;
            let output = torch_batch_norm_apply F @(r, s)
                (input, weight, bias, mean, variance, eps);
            (output, mean, invstd);
    end;

anx lam native_batch_norm_functional
    (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     weight bias: option.Opt
        «s#(torch_channel_dim @r); F#A#R#T»,
     running_mean running_var:
        «s#(torch_channel_dim @r); F#A#R#T»)
    (training: Bool, momentum eps: F#A#R#T)
  : [«s; F#A#R#T»,
     «s#(torch_channel_dim @r); F#A#R#T»,
     «s#(torch_channel_dim @r); F#A#R#T»,
     «s#(torch_channel_dim @r); F#A#R#T»,
     «s#(torch_channel_dim @r); F#A#R#T»] =
    let channel_dim = torch_channel_dim @r;
    let examples = torch_numel (torch_reduce_shape (s, channel_dim));
    let valid = core.bit2.and_ 0 (
        training,
        core.bit2.and_ 0 (
            r >= 2,
            core.bit2.and_ 0 (
                examples > 1,
                core.bit2.and_ 0 (
                    F#A#ge (momentum, F#A#R#_0),
                    F#A#le (momentum, F#from_nat 1)))));
    runtime.require
        (valid,
         "functional native_batch_norm expects training, rank >= 2, more than one value per channel, and momentum in [0,1]")
        body
    where
        lam body(): [«s; F#A#R#T»,
                     «s#(torch_channel_dim @r); F#A#R#T»,
                     «s#(torch_channel_dim @r); F#A#R#T»,
                     «s#(torch_channel_dim @r); F#A#R#T»,
                     «s#(torch_channel_dim @r); F#A#R#T»] =
            let stats = torch_batch_norm_stats F @(r, s)
                (input, option.some running_mean,
                 option.some running_var, training);
            let mean = stats#1_3;
            let variance = stats#2_3;
            let channels = s#(torch_channel_dim @r);
            let variance_eps = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_add_scalar F#A eps) @(1, (channels,)) variance;
            let invstd = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_rsqrt_scalar F) @(1, (channels,)) variance_eps;
            let output = torch_batch_norm_apply F @(r, s)
                (input, weight, bias, mean, variance, eps);
            let retained = F#A#sub (F#from_nat 1, momentum);
            let old_mean = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_scale_scalar F#A retained)
                @(1, (channels,)) running_mean;
            let batch_mean = tensor.unary @(F#A#R#T, F#A#R#T)
                (torch_scale_scalar F#A momentum) @(1, (channels,)) mean;
            let updated_mean = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#add @(1, (channels,)) (old_mean, batch_mean);
            let unbiased_scale = F#A#div (
                F#from_nat examples,
                F#from_nat (examples - 1));
            let unbiased_variance = tensor.unary
                @(F#A#R#T, F#A#R#T)
                (torch_scale_scalar F#A unbiased_scale)
                @(1, (channels,)) variance;
            let old_variance = tensor.unary
                @(F#A#R#T, F#A#R#T)
                (torch_scale_scalar F#A retained)
                @(1, (channels,)) running_var;
            let batch_variance = tensor.unary
                @(F#A#R#T, F#A#R#T)
                (torch_scale_scalar F#A momentum)
                @(1, (channels,)) unbiased_variance;
            let updated_variance = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#add @(1, (channels,))
                (old_variance, batch_variance);
            (output, mean, invstd, updated_mean, updated_variance);
    end;

anx lam batch_norm (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     weight bias running_mean running_var:
        option.Opt «s#(torch_channel_dim @r); F#A#R#T»)
    (training: Bool, momentum eps: F#A#R#T, cudnn_enabled: Bool)
  : «s; F#A#R#T» =
    runtime.require
        (core.bit2.and_ 0 (
            r >= 2,
            core.bit2.and_ 0 (
                core.bit2.or_ 0 (
                    training,
                    core.bit2.and_ 0 (
                        option.is_some running_mean,
                        option.is_some running_var)),
                core.bit2.and_ 0 (
                    F#A#ge (momentum, F#A#R#_0),
                    F#A#le (momentum, F#from_nat 1)))),
         "batch_norm expects rank >= 2, valid running stats, and momentum in [0,1]")
        body
    where
        lam body(): «s; F#A#R#T» =
            let channel_dim = torch_channel_dim @r;
            let examples = torch_numel (torch_reduce_shape (s, channel_dim));
            let valid_training_count = core.bit2.or_ 0 (
                core.icmp.e @2 (training, ff),
                examples > 1);
            runtime.require
                (valid_training_count,
                 "batch_norm training expects more than one value per channel")
                normalize
            where
                lam normalize(): «s; F#A#R#T» =
                    let stats = torch_batch_norm_stats F
                        @(r, s) (input, running_mean, running_var, training);
                    torch_batch_norm_apply F @(r, s)
                        (input, weight, bias, stats#1_3, stats#2_3, eps);
            end;
    end;

anx lam softmax (F: Floating)
                           {r: Nat, s: «r; Nat»}
                           (dimension: I64, half_to_float: Bool)
                           (input: «s; F#A#R#T»): «s; F#A#R#T» =
    torch_softmax_common F @(r, s) (dimension, half_to_float, ff) input;

anx lam log_softmax (F: Floating)
                               {r: Nat, s: «r; Nat»}
                               (dimension: I64, half_to_float: Bool)
                               (input: «s; F#A#R#T»): «s; F#A#R#T» =
    torch_softmax_common F @(r, s) (dimension, half_to_float, tt) input;

anx lam native_group_norm
    (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     weight: option.Opt «s#(torch_channel_dim @r); F#A#R#T»,
     bias: option.Opt «s#(torch_channel_dim @r); F#A#R#T»)
    (n channels inner groups: Nat, eps: F#A#R#T)
  : [«s; F#A#R#T»,
     «n, groups; F#A#R#T»,
     «n, groups; F#A#R#T»] =
    runtime.require
        (r >= 2,
         "native_group_norm expects rank >= 2") rank_ok
    where
        lam rank_ok():
            [«s; F#A#R#T»,
             «n, groups; F#A#R#T»,
             «n, groups; F#A#R#T»] =
            let channel_dim = torch_channel_dim @r;
            let valid_shape = core.bit2.and_ 0 (
                s#(core.idx 0 r  0) == n,
                core.bit2.and_ 0 (
                    s#channel_dim == channels,
                    torch_group_norm_inner_size s == inner));
            let valid_groups = core.bit2.and_ 0 (
                groups > 0,
                channels % groups == 0);
            runtime.require
                (core.bit2.and_ 0 (valid_shape, valid_groups),
                 "native_group_norm expects matching N/C/HxW and divisible groups")
                body;
        lam body():
            [«s; F#A#R#T»,
             «n, groups; F#A#R#T»,
             «n, groups; F#A#R#T»] =
            let channels_per_group = channels / groups;
            let grouped_shape = (n, groups, channels_per_group, inner);
            let grouped = tensor.reshape @(F#A#R#T, r, 4)
                s grouped_shape input;
            let stats = native_layer_norm F
                @(2, 2) ((n, groups), (channels_per_group, inner)) grouped
                ((option.none @«channels_per_group, inner; F#A#R#T»),
                 (option.none @«channels_per_group, inner; F#A#R#T»)) eps;
            let normalized = tensor.reshape @(F#A#R#T, 4, r)
                grouped_shape s stats#0_3;
            let actual_channels = s#(torch_channel_dim @r);
            let effective_weight = option.unwrap_or
                weight ‹actual_channels; F#from_nat 1›;
            let effective_bias = option.unwrap_or
                bias ‹actual_channels; F#A#R#_0›;
            let weight_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                ((actual_channels,), s, effective_weight,
                 (torch_channel_dim @r,));
            let bias_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
                ((actual_channels,), s, effective_bias,
                 (torch_channel_dim @r,));
            let scaled = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#mul @(r, s) (normalized, weight_b);
            let output = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#R#add @(r, s) (scaled, bias_b);
            let stat_shape = (n, groups, 1, 1);
            let mean = tensor.reshape @(F#A#R#T, 4, 2)
                stat_shape (n, groups) stats#1_3;
            let rstd = tensor.reshape @(F#A#R#T, 4, 2)
                stat_shape (n, groups) stats#2_3;
            (output, mean, rstd);
    end;

end
/// Integer-target CrossEntropy components. The second result is the weighted
/// denominator used by PyTorch's mean reduction.
lam torch_cross_entropy_index_components (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     target: «torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r); I64»,
     weight: option.Opt
        «s#(torch_cross_entropy_class_dim @r); F#A#R#T»)
    (ignore_index: I64, label_smoothing: F#A#R#T)()
  : let loss_shape = torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r);
    [Bool, «loss_shape; F#A#R#T», F#A#R#T] =
    let class_dim = torch_cross_entropy_class_dim @r;
    let loss_shape = torch_reduce_shape (s, class_dim);
    let classes = s#class_dim;
    let examples = torch_numel loss_shape;
    let log_probs = normalization_impl.log_softmax F
        @(r, s) (core.bitcast I64 class_dim, ff) input;
    let permutation = ‹d: r;
        core.idx 0 r  ((torch_reduce_subscripts @r class_dim)#d)›;
    let class_last = tensor.transpose @(F#A#R#T, r)
        permutation log_probs;
    let flat_log_probs = tensor.reshape @(F#A#R#T, r, 2)
        (torch_transpose_shape (s, permutation)) (examples, classes) class_last;
    let flat_target = tensor.reshape
        @(I64, r - 1, 1)
        loss_shape (examples,) target;
    let safe_target = tensor.unary @(I64, I64)
        (torch_cross_entropy_safe_target ignore_index)
        @(1, (examples,)) flat_target;
    // Validate class indices once, then share the bounded tensor between the
    // logits and optional class-weight gathers.
    let checked_target = torch_checked_index_cast
        @(classes, 1, (examples,))
        "cross_entropy target out of range" safe_target;
    let checked_target_2d = tensor.reshape @(Idx classes, 1, 2)
        (examples,) (examples, 1) checked_target;
    let selected_2d = tensor.gather @(F#A#R#T, 2)
        ((examples, classes), (examples, 1)) 1_2
        (flat_log_probs, checked_target_2d);
    let selected = tensor.reshape @(F#A#R#T, 2, 1)
        (examples, 1) (examples,) selected_2d;
    let effective_weight = option.unwrap_or
        weight ‹classes; F#from_nat 1›;
    // Preserve the option match until PE: the common unweighted case does
    // not materialize or index a class-weight tensor.
    let selected_weight = match weight with
        | actual_weight: «classes; F#A#R#T» =>
            tensor.gather @(F#A#R#T, 1)
                ((classes,), (examples,)) 0_1
                (actual_weight, checked_target)
        | _: [] => ‹examples; F#from_nat 1›;
    let weighted_selected = tensor.binary
        @(F#A#R#T, F#A#R#T, F#A#R#T)
        F#A#R#mul @(1, (examples,)) (selected, selected_weight);
    let nll_unmasked = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_neg_scalar F#A) @(1, (examples,)) weighted_selected;
    let nll = tensor.binary @(I64, F#A#R#T, F#A#R#T)
        (torch_cross_entropy_mask_value F#A ignore_index)
        @(1, (examples,)) (flat_target, nll_unmasked);
    let weight_b = tensor.broadcast_in_dim @(F#A#R#T, 1, 2)
        ((classes,), (examples, classes), effective_weight, (1_2,));
    let weighted_logs = tensor.binary
        @(F#A#R#T, F#A#R#T, F#A#R#T)
        F#A#R#mul @(2, (examples, classes)) (flat_log_probs, weight_b);
    let smooth_sum = torch_reduce_dim
        (F#A#R#add, F#A#R#_0) ((examples, classes), 1_2) weighted_logs;
    let smooth_negative = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_neg_scalar F#A) @(1, (examples,)) smooth_sum;
    let smooth = tensor.binary @(I64, F#A#R#T, F#A#R#T)
        (torch_cross_entropy_mask_value F#A ignore_index)
        @(1, (examples,)) (flat_target, smooth_negative);
    let one_minus = F#A#sub (F#from_nat 1, label_smoothing);
    let smoothing_per_class = F#A#div (label_smoothing, F#from_nat classes);
    let nll_scaled = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_scale_scalar F#A one_minus) @(1, (examples,)) nll;
    let smooth_scaled = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_scale_scalar F#A smoothing_per_class)
        @(1, (examples,)) smooth;
    let flat_loss = tensor.binary
        @(F#A#R#T, F#A#R#T, F#A#R#T)
        F#A#R#add @(1, (examples,)) (nll_scaled, smooth_scaled);
    let loss = tensor.reshape
        @(F#A#R#T, 1, r - 1)
        (examples,) loss_shape flat_loss;
    let denominator_values = tensor.binary
        @(I64, F#A#R#T, F#A#R#T)
        (torch_cross_entropy_mask_value F#A ignore_index)
        @(1, (examples,)) (flat_target, selected_weight);
    let denominator = torch_sum_all_runtime F#A
        @(1, (examples,)) denominator_values;
    (ff, loss, denominator);

/// Probability-target CrossEntropy components. PyTorch's mean denominator is
/// the number of unreduced output elements, independent of class weights.
lam torch_cross_entropy_probability_components (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input target: «s; F#A#R#T»,
     weight: option.Opt
        «s#(torch_cross_entropy_class_dim @r); F#A#R#T»)
    (label_smoothing: F#A#R#T)()
  : let loss_shape = torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r);
    [Bool, «loss_shape; F#A#R#T», F#A#R#T] =
    let class_dim = torch_cross_entropy_class_dim @r;
    let loss_shape = torch_reduce_shape (s, class_dim);
    let classes = s#class_dim;
    let log_probs = normalization_impl.log_softmax F
        @(r, s) (core.bitcast I64 class_dim, ff) input;
    let one_minus = F#A#sub (F#from_nat 1, label_smoothing);
    let smoothing_per_class = F#A#div (label_smoothing, F#from_nat classes);
    let smoothed_target = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_cross_entropy_smooth_target F
            (one_minus, smoothing_per_class)) @(r, s) target;
    let effective_weight = option.unwrap_or
        weight ‹classes; F#from_nat 1›;
    let weight_b = tensor.broadcast_in_dim @(F#A#R#T, 1, r)
        ((classes,), s, effective_weight, (class_dim,));
    let target_logs = tensor.binary
        @(F#A#R#T, F#A#R#T, F#A#R#T)
        F#A#R#mul @(r, s) (smoothed_target, log_probs);
    let weighted_logs = tensor.binary
        @(F#A#R#T, F#A#R#T, F#A#R#T)
        F#A#R#mul @(r, s) (target_logs, weight_b);
    let weighted_terms = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_neg_scalar F#A) @(r, s) weighted_logs;
    let loss = torch_reduce_dim
        (F#A#R#add, F#A#R#_0) (s, class_dim) weighted_terms;
    // PyTorch defines mean over C=0 probability targets as NaN. Selecting a
    // zero denominator preserves that result while none/sum remain zero.
    let denominator_count = core.select @Nat (
        classes == 0, 0, torch_numel loss_shape);
    (ff, loss, F#from_nat denominator_count);

/// Internal class-index CrossEntropy implementation selected by the public
/// target-domain match.
lam torch_cross_entropy_index (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     target: «torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r); I64»,
     weight: option.Opt
        «s#(torch_cross_entropy_class_dim @r); F#A#R#T»)
    (reduce_mode: Nat, ignore_index: I64, label_smoothing: F#A#R#T) =
    let valid = core.bit2.and_ 0 (
        r >= 1,
        core.bit2.and_ 0 (
            reduce_mode <= 2,
            core.bit2.and_ 0 (
                F#A#ge (label_smoothing, F#A#R#_0),
                F#A#le (label_smoothing, F#from_nat 1))));
    let components = runtime.require
        (valid, "cross_entropy expects rank>=1, a valid reduction, and label_smoothing in [0,1]")
        (torch_cross_entropy_index_components F
            @(r, s) (input, target, weight)
            (ignore_index, label_smoothing));
    let loss = components#1_3;
    let loss_shape = torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r);
    let total = torch_sum_all_runtime F#A
        @(r - 1, loss_shape) loss;
    let mean = F#A#div (total, components#2_3);
    let reduced = core.select @F#A#R#T
        (reduce_mode == 2, total, mean);
    (loss, reduced)#(reduce_mode != 0);

/// Internal probability-target implementation selected by the same match.
lam torch_cross_entropy_probability (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input target: «s; F#A#R#T»,
     weight: option.Opt
        «s#(torch_cross_entropy_class_dim @r); F#A#R#T»)
    (reduce_mode: Nat, ignore_index: I64, label_smoothing: F#A#R#T) =
    let valid = core.bit2.and_ 0 (
        r >= 1,
        core.bit2.and_ 0 (
            reduce_mode <= 2,
            core.bit2.and_ 0 (
                core.icmp.sl (ignore_index, 0I64),
                core.bit2.and_ 0 (
                    F#A#ge (label_smoothing, F#A#R#_0),
                    F#A#le (label_smoothing, F#from_nat 1)))));
    let components = runtime.require
        (valid, "cross_entropy probability target expects negative ignore_index and valid parameters")
        (torch_cross_entropy_probability_components F
            @(r, s) (input, target, weight) label_smoothing);
    let loss = components#1_3;
    let loss_shape = torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r);
    let total = torch_sum_all_runtime F#A
        @(r - 1, loss_shape) loss;
    let mean = F#A#div (total, components#2_3);
    let reduced = core.select @F#A#R#T
        (reduce_mode == 2, total, mean);
    (loss, reduced)#(reduce_mode != 0);

pub mod loss_impl
anx lam smooth_l1_mean (F: Floating)
                              {r: Nat, s: «r; Nat»}
                              (input: «s; F#A#R#T», target: «s; F#A#R#T»)
                              (beta: F#A#R#T): F#A#R#T =
    let losses = tensor.binary
        @(F#A#R#T, F#A#R#T, F#A#R#T)
        (torch_smooth_l1_scalar F beta) @(r, s) (input, target);
    reduction_impl.mean_all F @(r, s) losses;

anx lam smooth_l1_loss (F: Floating)
    {ri rt ro: Nat}
    (si: «ri; Nat», di: «ri; Idx ro»,
     st: «rt; Nat», dt: «rt; Idx ro», so: «ro; Nat»)
    (input: «si; F#A#R#T», target: «st; F#A#R#T»)
    (reduce_mode: Nat, beta: F#A#R#T) =
    let valid = core.bit2.and_ 0 (
        reduce_mode <= 2,
        core.bit2.and_ 0 (
            F#A#ge (beta, F#A#R#_0),
            core.bit2.and_ 0 (
                torch_broadcast_compatible (si, so, di),
                torch_broadcast_compatible (st, so, dt))));
    let losses = runtime.require
        (valid, "smooth_l1_loss does not support negative beta and expects broadcastable inputs and a valid reduction")
        (torch_smooth_l1_pointwise F
            @(ri, rt, ro) (si, di, st, dt, so) (input, target) beta);
    let total = torch_sum_all_runtime F#A @(ro, so) losses;
    let mean = F#A#div (total, F#from_nat (torch_numel so));
    let reduced = core.select @F#A#R#T
        (reduce_mode == 2, total, mean);
    (losses, reduced)#(reduce_mode != 0);

anx lam kl_div_reduced (F: Floating)
                              {r: Nat, s: «r; Nat»}
                              (log_target: Bool, reduce_mode: Nat)
                              (input target: «s; F#A#R#T»): F#A#R#T =
    let valid = core.bit2.and_ 0 (
        r >= 1, reduce_mode <= 2);
    runtime.require
        (valid, "kl_div expects rank >= 1 and sum/mean/batchmean reduction")
        body
    where
        lam body(): F#A#R#T =
            let losses = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                (torch_kl_div_scalar F log_target) @(r, s) (input, target);
            let total = torch_sum_all_runtime F#A @(r, s) losses;
            let denominator = core.select (
                reduce_mode == 1,
                torch_numel s,
                s#(core.idx 0 r  0));
            let normalized = F#A#div (total, F#from_nat denominator);
            core.select @F#A#R#T
                (reduce_mode == 0, total, normalized);
    end;

anx lam kl_div (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input target: «s; F#A#R#T»)
    (reduce_mode: Nat, log_target: Bool) =
    let losses = runtime.require
        (core.bit2.and_ 0 (
            r >= 1, reduce_mode <= 3),
         "kl_div expects rank >= 1 and a valid reduction")
        (torch_kl_div_pointwise F @(r, s) (input, target) log_target);
    let total = torch_sum_all_runtime F#A @(r, s) losses;
    let mean = F#A#div (total, F#from_nat (torch_numel s));
    let batch_denominator = s#(core.idx 0 r  0);
    let batchmean = F#A#div (total, F#from_nat batch_denominator);
    let sum_or_batch = core.select @F#A#R#T
        (reduce_mode == 3, batchmean, total);
    let reduced = core.select @F#A#R#T
        (reduce_mode == 1, mean, sum_or_batch);
    (losses, reduced)#(reduce_mode != 0);

anx lam triplet_margin_reduced (F: Floating)
    {n d: Nat}
    (margin p eps: F#A#R#T, swap: Bool, reduce_mode: Nat)
    (anchor positive negative: «n, d; F#A#R#T»): F#A#R#T =
    let valid = core.bit2.and_ 0 (
        F#A#gt (margin, F#A#R#_0),
        reduce_mode <= 1);
    runtime.require
        (valid, "triplet_margin_loss expects margin>0 and sum/mean reduction")
        body
    where
        lam body(): F#A#R#T =
            let distance_positive = torch_pairwise_distance_2d F
                @(n, d) (eps, p) (anchor, positive);
            let distance_negative = torch_pairwise_distance_2d F
                @(n, d) (eps, p) (anchor, negative);
            let distance_swap = torch_pairwise_distance_2d F
                @(n, d) (eps, p) (positive, negative);
            let swapped_negative = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                F#A#minimum @(1, (n,)) (distance_negative, distance_swap);
            let effective_negative = core.select @«n; F#A#R#T»
                (swap, swapped_negative, distance_negative);
            let losses = tensor.binary
                @(F#A#R#T, F#A#R#T, F#A#R#T)
                (torch_triplet_margin_scalar F margin)
                @(1, (n,)) (distance_positive, effective_negative);
            let total = torch_sum_all_runtime F#A @(1, (n,)) losses;
            let mean = F#A#div (total, F#from_nat n);
            core.select @F#A#R#T
                (reduce_mode == 0, total, mean);
    end;

anx lam triplet_margin_loss (F: Floating)
    {r: Nat, s: «r; Nat»}
    (anchor positive negative: «s; F#A#R#T»)
    (margin p eps: F#A#R#T, swap: Bool, reduce_mode: Nat) =
    let valid = core.bit2.and_ 0 (
        r >= 1,
        core.bit2.and_ 0 (
            F#A#gt (margin, F#A#R#_0),
            reduce_mode <= 2));
    let feature_dim = core.idx 0 r  (r - 1);
    let loss_shape = torch_reduce_shape (s, feature_dim);
    let n = torch_numel loss_shape;
    let losses = runtime.require
        (valid, "triplet_margin_loss expects rank >= 1, margin>0, and a valid reduction")
        (torch_triplet_margin_pointwise F
            @(r, s) (anchor, positive, negative) (margin, p, eps, swap));
    let unreduced = tensor.reshape
        @(F#A#R#T, 1, r - 1)
        (n,) loss_shape losses;
    let total = torch_sum_all_runtime F#A @(1, (n,)) losses;
    let mean = F#A#div (total, F#from_nat n);
    let reduced = core.select @F#A#R#T
        (reduce_mode == 2, total, mean);
    (unreduced, reduced)#(reduce_mode != 0);

anx lam triplet_margin_loss_1d_none (F: Floating)
    {d: Nat}
    (anchor positive negative: «d; F#A#R#T»)
    (margin p eps: F#A#R#T, swap: Bool): F#A#R#T =
    runtime.require
        (F#A#gt (margin, F#A#R#_0),
         "triplet_margin_loss expects margin greater than zero")
        body
    where
        lam body(): F#A#R#T =
            let distance_positive = torch_pairwise_distance_1d F
                @d (eps, p) (anchor, positive);
            let distance_negative = torch_pairwise_distance_1d F
                @d (eps, p) (anchor, negative);
            let distance_swap = torch_pairwise_distance_1d F
                @d (eps, p) (positive, negative);
            let effective_negative = core.select @F#A#R#T
                (swap,
                 F#A#minimum (distance_negative, distance_swap),
                 distance_negative);
            torch_triplet_margin_scalar F margin
                (distance_positive, effective_negative);
    end;

anx lam cross_entropy_mean_2d (F: Floating)
    {n c: Nat}
    (input: «n, c; F#A#R#T», target: «n; I64»): F#A#R#T =
    let log_probs = normalization.log_softmax F
        @(2, (n, c)) (1I64, ff) input;
    let target_2d = tensor.reshape @(I64, 1, 2)
        (n,) (n, 1) target;
    let selected_2d = indexing.gather
        @(F#A#R#T, 2, (n, c), (n, 1))
        1I64 (log_probs, target_2d);
    let selected = tensor.reshape @(F#A#R#T, 2, 1)
        (n, 1) (n,) selected_2d;
    let losses = tensor.unary @(F#A#R#T, F#A#R#T)
        (torch_neg_scalar F#A) @(1, (n,)) selected;
    reduction.mean_all F @(1, (n,)) losses;

anx lam cross_entropy (F: Floating)
    {r: Nat, s: «r; Nat»}
    (input: «s; F#A#R#T»,
     target: «s; F#A#R#T» ∪ «torch_reduce_shape
        (s, torch_cross_entropy_class_dim @r); I64»,
     weight: option.Opt
        «s#(torch_cross_entropy_class_dim @r); F#A#R#T»)
    (reduce_mode: Nat, ignore_index: I64, label_smoothing: F#A#R#T) =
    match target with
        | indices: «torch_reduce_shape
              (s, torch_cross_entropy_class_dim @r); I64» =>
            torch_cross_entropy_index F @(r, s)
                (input, indices, weight)
                (reduce_mode, ignore_index, label_smoothing)
        | probabilities: «s; F#A#R#T» =>
            torch_cross_entropy_probability F @(r, s)
                (input, probabilities, weight)
                (reduce_mode, ignore_index, label_smoothing);

end

pub mod scan
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.cumsum.html
/// Types: rank-2 Floating tensor and signed axis to the same tensor type.
axm cumsum_2d: [F: Floating]
                         → {m n: Nat}
                         → [dimension: I64]
                         → «m, n; F#A#R#T»
                         → «m, n; F#A#R#T»;
/// Directional form used to eliminate `flip -> cumsum -> flip`.
axm cumsum_2d_direction: [F: Floating]
                                   → {m n: Nat}
                                   → [dimension: I64, reverse: Bool]
                                   → «m, n; F#A#R#T»
                                   → «m, n; F#A#R#T»;
/// PyTorch composition: `cat((zeros_like(select(x, dim, 0)).unsqueeze(dim),
/// cumsum(narrow(x, dim, 0, size(dim) - 1), dim)), dim)`.
/// Static dimension and extent expose the full prefix and one-element shift to
/// PE; only tensor pad/map operations remain.
axm cumsum_exclusive_2d: [F: Floating]
                                   → {m n: Nat}
                                   → [dimension: I64]
                                   → «m, n; F#A#R#T»
                                   → «m, n; F#A#R#T»;
/// Boolean cumsum follows PyTorch's default promotion to I64.
axm cumsum_bool_i64: {m n: Nat}
                              → [dimension: I64]
                              → «m, n; Bool» → «m, n; I64»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.cumprod.html
/// Types: rank-2 Floating tensor and signed axis to the same tensor type.
axm cumprod_2d: [F: Floating]
                          → {m n: Nat}
                          → [dimension: I64]
                          → «m, n; F#A#R#T»
                          → «m, n; F#A#R#T»;
end
pub mod scan_impl
anx lam cumsum_2d (F: Floating)
                              {m n: Nat} (dimension: I64)
                              (input: «m, n; F#A#R#T»)
                            : «m, n; F#A#R#T» =
    runtime.require
        (torch_dim_in_range @2 dimension,
         "cumsum expects an in-range dimension") body
    where
        lam body(): «m, n; F#A#R#T» =
            torch_prefix_2d @(F#A#R#T, m, n)
                (F#A#R#add, F#A#R#_0,
                 torch_canonical_dim @2 dimension) input;
    end;

anx lam cumsum_2d_direction (F: Floating)
                                        {m n: Nat}
                                        (dimension: I64, reverse: Bool)
                                        (input: «m, n; F#A#R#T»)
                                      : «m, n; F#A#R#T» =
    runtime.require
        (torch_dim_in_range @2 dimension,
         "cumsum expects an in-range dimension") body
    where
        lam body(): «m, n; F#A#R#T» =
            let canonical = torch_canonical_dim @2 dimension;
            (core.select (reverse, backward, forward)) ()
            where
                lam forward(): «m, n; F#A#R#T» =
                    torch_prefix_2d @(F#A#R#T, m, n)
                        (F#A#R#add, F#A#R#_0, canonical) input;
                lam backward(): «m, n; F#A#R#T» =
                    torch_reverse_prefix_add_2d F @(m, n)
                        canonical input;
            end;
    end;

anx lam cumsum_exclusive_2d (F: Floating)
                                        {m n: Nat} (dimension: I64)
                                        (input: «m, n; F#A#R#T»)
                                      : «m, n; F#A#R#T» =
    runtime.require
        (torch_dim_in_range @2 dimension,
         "exclusive cumsum expects an in-range dimension") body
    where
        lam body(): «m, n; F#A#R#T» =
            let canonical = torch_canonical_dim @2 dimension;
            let inclusive = torch_prefix_2d @(F#A#R#T, m, n)
                (F#A#R#add, F#A#R#_0, canonical) input;
            torch_prefix_shift_2d @(F#A#R#T, m, n)
                (F#A#R#_0, canonical, 1) inclusive;
    end;

anx lam cumsum_bool_i64 {m n: Nat}
                                   (dimension: I64)
                                   (input: «m, n; Bool»): «m, n; I64» =
    runtime.require
        (torch_dim_in_range @2 dimension,
         "cumsum expects an in-range dimension") body
    where
        lam body(): «m, n; I64» =
            let converted = tensor.unary @(Bool, I64)
                torch_bool_to_i64 @(2, (m, n)) input;
            torch_prefix_2d @(I64, m, n)
                (torch_i64_add, 0I64,
                 torch_canonical_dim @2 dimension) converted;
    end;

anx lam cumprod_2d (F: Floating)
                               {m n: Nat} (dimension: I64)
                               (input: «m, n; F#A#R#T»)
                             : «m, n; F#A#R#T» =
    runtime.require
        (torch_dim_in_range @2 dimension,
         "cumprod expects an in-range dimension") body
    where
        lam body(): «m, n; F#A#R#T» =
            torch_prefix_2d @(F#A#R#T, m, n)
                (F#A#R#mul, F#from_nat 1,
                 torch_canonical_dim @2 dimension) input;
    end;

end

pub mod indexing_impl
anx lam slice {T: *, r: Nat}
                         (s_in: «r; Nat», start: «r; Nat»,
                          step: «r; Nat», s_out: «r; Nat»)
                         (input: «s_in; T»): «s_out; T» =
    tensor.slice @(T, r) s_in (start, step, s_out) input;

anx lam select {T: *, r: Nat, s: «r; Nat»}
                          (dimension: I64, index: I64)
                          (input: «s; T»)
                        : «torch_reduce_shape (s, torch_canonical_dim @r dimension); T» =
    let dim = torch_canonical_dim @r dimension;
    let valid = core.bit2.and_ 0 (
        torch_dim_in_range @r dimension,
        torch_index_in_range (s#dim, index));
    runtime.require (valid, "select expects an in-range dim and index") body
    where
        lam body(): «torch_reduce_shape (s, torch_canonical_dim @r dimension); T» =
            let dim = torch_canonical_dim @r dimension;
            let selected = torch_canonical_index (s#dim, index);
            let start = ‹d: r;
                core.select (core.icmp.e @r (d, dim), selected, 0)›;
            let step = ‹d: r; 1›;
            let sliced_shape = torch_keepdim_shape (s, dim);
            let sliced = tensor.slice @(T, r)
                s (start, step, sliced_shape) input;
            tensor.reshape @(T, r, r - 1)
                sliced_shape (torch_reduce_shape (s, dim)) sliced;
    end;

anx lam roll {T: *, r nr: Nat, s: «r; Nat»}
                        (shifts: «nr; Nat», dimensions: «nr; I64»)
                        (input: «s; T»): «s; T» =
    runtime.require
        (torch_dims_in_range @(r, nr) dimensions,
         "roll expects in-range dimensions")
        body
    where
        lam body(): «s; T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            tensor.map_reduce @1 @(T, r, r) (s, s)
                @(T, r, s) (torch_tensor_copy @T, ⊥: T)
                (affine.id @r) (torch_roll_map (s, shifts, dims),) input;
    end;

anx lam unfold {T: *, r: Nat, s: «r; Nat»}
                          (dimension: I64, size step: Nat)
                          (input: «s; T»)
                        : «torch_unfold_shape
                            (s, torch_canonical_dim @r dimension, size, step); T» =
    runtime.require
        (core.bit2.and_ 0 (
            torch_dim_in_range @r dimension,
            step >= 1),
         "unfold expects an in-range dimension and positive step")
        checked_dimension
    where
        lam checked_dimension():
            «torch_unfold_shape
                (s, torch_canonical_dim @r dimension, size, step); T» =
            let dim = torch_canonical_dim @r dimension;
            runtime.require
                (size <= s#dim,
                 "unfold size must not exceed the selected extent")
                body;
        lam body():
            «torch_unfold_shape
                (s, torch_canonical_dim @r dimension, size, step); T» =
            let dim = torch_canonical_dim @r dimension;
            let out_shape = torch_unfold_shape (s, dim, size, step);
            let out_rank = r + 1;
            tensor.map_reduce @1 @(T, out_rank, out_rank)
                (out_shape, out_shape) @(T, r, s)
                (torch_tensor_copy @T, ⊥: T) (affine.id @out_rank)
                (torch_unfold_map @r (dim, step),) input;
    end;

anx lam narrow {T: *, r: Nat, s: «r; Nat»}
                          (dimension: I64, start: I64, length: Nat)
                          (input: «s; T»)
                        : «torch_narrow_shape
                            (s, torch_canonical_dim @r dimension, length); T» =
    let dim = torch_canonical_dim @r dimension;
    let valid = core.bit2.and_ 0 (
        torch_dim_in_range @r dimension,
        torch_narrow_start_in_range (s#dim, length, start));
    runtime.require
        (valid, "narrow expects an in-range dim, start, and length")
        body
    where
        lam body():
            «torch_narrow_shape
                (s, torch_canonical_dim @r dimension, length); T» =
            let dim = torch_canonical_dim @r dimension;
            let canonical_start = torch_canonical_index (s#dim, start);
            let starts = ‹d: r;
                core.select (core.icmp.e @r (d, dim), canonical_start, 0)›;
            let steps = ‹d: r; 1›;
            let s_out = torch_narrow_shape (s, dim, length);
            tensor.slice @(T, r) s (starts, steps, s_out) input;
    end;

anx lam gather {T: *, r: Nat, s_input s_index: «r; Nat»}
                          (dimension: I64)
                          (input: «s_input; T», index: «s_index; I64»)
                        : «s_index; T» =
    runtime.require
        (torch_dim_in_range @r dimension,
         "gather expects a nonzero rank and an in-range dimension")
        body
    where
        lam body(): «s_index; T» =
            let dim = torch_canonical_dim @r dimension;
            let shape_valid = core.bit2.or_ 0 (
                torch_numel s_index == 0,
                torch_gather_shape_compatible (s_input, s_index, dim));
            runtime.require
                (shape_valid, "gather index shape exceeds input shape")
                gather;
        lam gather(): «s_index; T» =
            let dim = torch_canonical_dim @r dimension;
            let checked_index = torch_checked_index_cast
                @(s_input#dim, r, s_index) "gather index out of range" index;
            tensor.gather @(T, r)
                (s_input, s_index) dim (input, checked_index);
    end;

anx lam scatter_src
    {T: *, r: Nat, s_input s_index s_src: «r; Nat»}
    (dimension: I64)
    (input: «s_input; T», index: «s_index; I64», src: «s_src; T»)
  : «s_input; T» =
    runtime.require
        (torch_dim_in_range @r dimension,
         "scatter expects a nonzero rank and an in-range dimension")
        body
    where
        lam body(): «s_input; T» =
            let dim = torch_canonical_dim @r dimension;
            let empty = torch_numel s_index == 0;
            let shape_valid = core.bit2.or_ 0 (
                empty,
                core.bit2.and_ 0 (
                    torch_gather_shape_compatible (s_input, s_index, dim),
                    torch_shape_le (s_index, s_src)));
            runtime.require
                (shape_valid, "scatter index shape exceeds input or source shape")
                scatter;
        lam scatter(): «s_input; T» =
            let dim = torch_canonical_dim @r dimension;
            let checked_index = torch_checked_index_cast
                @(s_input#dim, r, s_index) "scatter index out of range" index;
            tensor.scatter @(T, r)
                (s_input, s_index, s_src) dim (input, checked_index, src);
    end;

anx lam scatter_value {T: *, r: Nat, s_input s_index: «r; Nat»}
                                 (dimension: I64, value: T)
                                 (input: «s_input; T», index: «s_index; I64»)
                               : «s_input; T» =
    let src = tensor.splat @(T, r) (s_index, value);
    scatter_src @(T, r, s_input, s_index, s_index)
        dimension (input, index, src);

anx lam embedding {T: *, vocab hidden ri: Nat}
                             {s_indices: «ri; Nat»}
                             (padding_idx: I64,
                              scale_grad_by_freq: Bool,
                              sparse: Bool)
                             (weight: «vocab, hidden; T»,
                              indices: «s_indices; I64»)
                           : «vec.cat (s_indices, (hidden,)); T» =
    runtime.require
        (ri > 0, "embedding currently requires index rank >= 1")
        body
    where
    lam body(): «vec.cat (s_indices, (hidden,)); T» =
    let prefix_rank = ri - 1;
    let ro = ri + 1;
    let s_out = vec.cat (s_indices, (hidden,));
    let gather_dim = core.idx 0 ro  prefix_rank;
    let source_shape = ‹d: ro;
        core.select (core.icmp.e @ro (d, gather_dim), vocab, s_out#d)›;
    let weight_dims = (gather_dim, core.idx 0 ro  ri);
    let index_dims = ‹d: ri; core.idx 0 ro  (core.bitcast Nat d)›;
    let checked_indices = torch_checked_index_cast
        @(vocab, ri, s_indices) "embedding index out of range" indices;
    let broadcast_weight = tensor.broadcast_in_dim @(T, 2, ro)
        ((vocab, hidden), source_shape, weight, weight_dims);
    let broadcast_indices = tensor.broadcast_in_dim @(Idx vocab, ri, ro)
        (s_indices, s_out, checked_indices, index_dims);
    tensor.gather @(T, ro)
        (source_shape, s_out) gather_dim
        (broadcast_weight, broadcast_indices);
    end;

anx lam index_2d {T: *, m n r: Nat, s: «r; Nat»}
                            (input: «m, n; T»,
                            rows: «s; I64», columns: «s; I64»): «s; T» =
    runtime.require (r > 0, "index_2d expects result rank >= 1") body
    where
        lam body(): «s; T» =
            let linear_i64 = tensor.binary @(I64, I64, I64)
                (torch_linearize_2d_index @n) @(r, s) (rows, columns);
            let flat_size = m * n;
            let linear = torch_checked_index_cast
                @(flat_size, r, s) "2-D index out of range" linear_i64;
            let flat = tensor.reshape @(T, 2, 1)
                (m, n) (flat_size,) input;
            let source_shape = ‹d: r;
                core.select (
                    core.icmp.e @r (d, core.idx 0 r  0),
                    flat_size,
                    s#d)›;
            let source = tensor.broadcast_in_dim @(T, 1, r)
                ((flat_size,), source_shape, flat, (core.idx 0 r  0,));
            tensor.gather @(T, r)
                (source_shape, s) (core.idx 0 r  0) (source, linear);
    end;

anx lam flip {T: *, r nr: Nat, s: «r; Nat»}
                            (dimensions: «nr; I64»)
                            (input: «s; T»): «s; T» =
    runtime.require
        (torch_axis_list_valid @(r, nr) dimensions,
         "flip expects unique, in-range dimensions") body
    where
        lam body(): «s; T» =
            let dims = torch_canonical_dims @(r, nr) dimensions;
            tensor.generate @(T, r) s
                (torch_flip_element @(T, r, nr) (s, dims) input);
    end;
end

pub mod recurrent
/// One direction of `torch.nn.RNN`. The leading sequence axis is scanned with a loop-carried hidden
/// tensor; `relu` selects the ReLU nonlinearity over the standard tanh, and `reverse` runs the sequence
/// backwards while still returning the output in the original time order.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.RNN.html
/// Types: `[seq, batch, input]`, `[batch, hidden]`, input/recurrent weights and optional biases to
/// `[output, final_hidden]`.
axm rnn_direction: [F: Floating]
                 → {seq batch input_size hidden: Nat}
                 → [relu reverse: Bool]
                 → [input: «seq, batch, input_size; F#A#R#T»,
                    initial_hidden: «batch, hidden; F#A#R#T»,
                    weight_ih: «hidden, input_size; F#A#R#T»,
                    weight_hh: «hidden, hidden; F#A#R#T»,
                    bias_ih: option.Opt «hidden; F#A#R#T»,
                    bias_hh: option.Opt «hidden; F#A#R#T»]
                 → [«seq, batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»];

/// One direction of `torch.nn.GRU`, in PyTorch's `(reset, update, new)` gate order and with its
/// reset-after recurrent-bias semantics.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.GRU.html
/// Types: weights and biases have leading extent `3 * hidden`.
axm gru_direction: [F: Floating]
                 → {seq batch input_size hidden: Nat}
                 → [reverse: Bool]
                 → [input: «seq, batch, input_size; F#A#R#T»,
                    initial_hidden: «batch, hidden; F#A#R#T»,
                    weight_ih: «3 * hidden, input_size; F#A#R#T»,
                    weight_hh: «3 * hidden, hidden; F#A#R#T»,
                    bias_ih: option.Opt «3 * hidden; F#A#R#T»,
                    bias_hh: option.Opt «3 * hidden; F#A#R#T»]
                 → [«seq, batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»];

/// One direction of `torch.nn.LSTM`, in PyTorch's `(input, forget, cell, output)` gate order.
/// The scan state carries both the hidden and the cell tensor.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.LSTM.html
/// Types: weights and biases have leading extent `4 * hidden`.
axm lstm_direction: [F: Floating]
                  → {seq batch input_size hidden: Nat}
                  → [reverse: Bool]
                  → [input: «seq, batch, input_size; F#A#R#T»,
                     initial_hidden: «batch, hidden; F#A#R#T»,
                     initial_cell: «batch, hidden; F#A#R#T»,
                     weight_ih: «4 * hidden, input_size; F#A#R#T»,
                     weight_hh: «4 * hidden, hidden; F#A#R#T»,
                     bias_ih: option.Opt «4 * hidden; F#A#R#T»,
                     bias_hh: option.Opt «4 * hidden; F#A#R#T»]
                  → [«seq, batch, hidden; F#A#R#T»,
                     «batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»];
end

lam torch_reverse_leading {T: *, seq batch size: Nat}
                          (input: «seq, batch, size; T»): «seq, batch, size; T» =
    indexing_impl.flip @(T, 3, 1, (seq, batch, size)) (0I64,) input;

lam torch_recurrent_scan {T S: *, seq batch input_size hidden: Nat}
                         (reverse: Bool)
                         (step: Cn [«batch, input_size; T», S, Cn [«batch, hidden; T», S]])
                         (input: «seq, batch, input_size; T», initial_state: S)
                       : [«seq, batch, hidden; T», S] =
    runtime.require (seq >= 1, "recurrent input sequence must be non-empty") body
where
    lam body (): [«seq, batch, hidden; T», S] =
        (core.select (reverse, backward, forward)) ()
    where
        lam forward (): [«seq, batch, hidden; T», S] =
            tensor.scan @(T, S, seq, 2, 2) ((batch, input_size), (batch, hidden))
                step (input, initial_state);

        /// Scanned back to front, then put back into the original time order.
        lam backward (): [«seq, batch, hidden; T», S] =
            let reversed = torch_reverse_leading @(T, seq, batch, input_size) input;
            let scanned = tensor.scan @(T, S, seq, 2, 2) ((batch, input_size), (batch, hidden))
                step (reversed, initial_state);
            (torch_reverse_leading @(T, seq, batch, hidden) scanned#ff, scanned#tt);
    end;
end;

con torch_rnn_step (F: Floating) {batch input_size hidden: Nat}
                   (relu: Bool)
                   (weight_ih: «hidden, input_size; F#A#R#T»,
                    weight_hh: «hidden, hidden; F#A#R#T»,
                    bias_ih: option.Opt «hidden; F#A#R#T»,
                    bias_hh: option.Opt «hidden; F#A#R#T»)
                   (x: «batch, input_size; F#A#R#T»,
                    state: «batch, hidden; F#A#R#T»,
                    return: Cn [«batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»]) =
    let from_input = linalg_impl.linear F#A @(1, input_size, hidden) (batch,) (x, weight_ih) bias_ih;
    let from_hidden = linalg_impl.linear F#A @(1, hidden, hidden) (batch,) (state, weight_hh) bias_hh;
    let preactivation = torch_recurrent_binary F#A @(batch, hidden)
        F#A#R#add (from_input, from_hidden);
    let next = torch_recurrent_unary @(F#A#R#T, batch, hidden)
        (torch_rnn_activation F relu) preactivation;
    return (next, next);

con torch_gru_step (F: Floating) {batch input_size hidden: Nat}
                   (weight_ih: «3 * hidden, input_size; F#A#R#T»,
                    weight_hh: «3 * hidden, hidden; F#A#R#T»,
                    bias_ih: option.Opt «3 * hidden; F#A#R#T»,
                    bias_hh: option.Opt «3 * hidden; F#A#R#T»)
                   (x: «batch, input_size; F#A#R#T»,
                    state: «batch, hidden; F#A#R#T»,
                    return: Cn [«batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»]) =
    let input_gates = linalg_impl.linear F#A @(1, input_size, 3 * hidden) (batch,)
        (x, weight_ih) bias_ih;
    let hidden_gates = linalg_impl.linear F#A @(1, hidden, 3 * hidden) (batch,)
        (state, weight_hh) bias_hh;
    let ir = torch_gate_slice @(F#A#R#T, 3, batch, hidden) 0 input_gates;
    let iz = torch_gate_slice @(F#A#R#T, 3, batch, hidden) 1 input_gates;
    let inn = torch_gate_slice @(F#A#R#T, 3, batch, hidden) 2 input_gates;
    let hr = torch_gate_slice @(F#A#R#T, 3, batch, hidden) 0 hidden_gates;
    let hz = torch_gate_slice @(F#A#R#T, 3, batch, hidden) 1 hidden_gates;
    let hn = torch_gate_slice @(F#A#R#T, 3, batch, hidden) 2 hidden_gates;
    let reset = torch_recurrent_unary @(F#A#R#T, batch, hidden) (torch_sigmoid_scalar F)
        (torch_recurrent_binary F#A @(batch, hidden) F#A#R#add (ir, hr));
    let update = torch_recurrent_unary @(F#A#R#T, batch, hidden) (torch_sigmoid_scalar F)
        (torch_recurrent_binary F#A @(batch, hidden) F#A#R#add (iz, hz));
    let reset_hidden = torch_recurrent_binary F#A @(batch, hidden) F#A#R#mul (reset, hn);
    let candidate = torch_recurrent_unary @(F#A#R#T, batch, hidden) (torch_tanh_scalar F)
        (torch_recurrent_binary F#A @(batch, hidden) F#A#R#add (inn, reset_hidden));
    let delta = torch_recurrent_binary F#A @(batch, hidden) F#A#sub (state, candidate);
    let weighted_delta = torch_recurrent_binary F#A @(batch, hidden) F#A#R#mul (update, delta);
    let next = torch_recurrent_binary F#A @(batch, hidden) F#A#R#add (candidate, weighted_delta);
    return (next, next);

/// The leading `Bool` is a private tag keeping the two rank-2 state tensors from normalizing into one
/// rank-3 tensor; it stays `ff` and so carries no state of its own.
con torch_lstm_step (F: Floating) {batch input_size hidden: Nat}
                    (weight_ih: «4 * hidden, input_size; F#A#R#T»,
                     weight_hh: «4 * hidden, hidden; F#A#R#T»,
                     bias_ih: option.Opt «4 * hidden; F#A#R#T»,
                     bias_hh: option.Opt «4 * hidden; F#A#R#T»)
                    (x: «batch, input_size; F#A#R#T»,
                     state: [Bool, «batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»],
                     return: Cn [«batch, hidden; F#A#R#T»,
                                 [Bool, «batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»]]) =
    let input_gates = linalg_impl.linear F#A @(1, input_size, 4 * hidden) (batch,)
        (x, weight_ih) bias_ih;
    let hidden_gates = linalg_impl.linear F#A @(1, hidden, 4 * hidden) (batch,)
        (state#1_3, weight_hh) bias_hh;
    let gates = tensor.binary @(F#A#R#T, F#A#R#T, F#A#R#T)
        F#A#R#add @(2, (batch, 4 * hidden)) (input_gates, hidden_gates);
    let input_gate = torch_recurrent_unary @(F#A#R#T, batch, hidden) (torch_sigmoid_scalar F)
        (torch_gate_slice @(F#A#R#T, 4, batch, hidden) 0 gates);
    let forget_gate = torch_recurrent_unary @(F#A#R#T, batch, hidden) (torch_sigmoid_scalar F)
        (torch_gate_slice @(F#A#R#T, 4, batch, hidden) 1 gates);
    let cell_gate = torch_recurrent_unary @(F#A#R#T, batch, hidden) (torch_tanh_scalar F)
        (torch_gate_slice @(F#A#R#T, 4, batch, hidden) 2 gates);
    let output_gate = torch_recurrent_unary @(F#A#R#T, batch, hidden) (torch_sigmoid_scalar F)
        (torch_gate_slice @(F#A#R#T, 4, batch, hidden) 3 gates);
    let retained = torch_recurrent_binary F#A @(batch, hidden) F#A#R#mul (forget_gate, state#2_3);
    let written = torch_recurrent_binary F#A @(batch, hidden) F#A#R#mul (input_gate, cell_gate);
    let next_cell = torch_recurrent_binary F#A @(batch, hidden) F#A#R#add (retained, written);
    let activated_cell = torch_recurrent_unary @(F#A#R#T, batch, hidden)
        (torch_tanh_scalar F) next_cell;
    let next_hidden = torch_recurrent_binary F#A @(batch, hidden) F#A#R#mul
        (output_gate, activated_cell);
    return (next_hidden, (ff, next_hidden, next_cell));

pub mod recurrent_impl
anx lam rnn_direction (F: Floating) {seq batch input_size hidden: Nat}
                      (relu reverse: Bool)
                      (input: «seq, batch, input_size; F#A#R#T»,
                       initial_hidden: «batch, hidden; F#A#R#T»,
                       weight_ih: «hidden, input_size; F#A#R#T»,
                       weight_hh: «hidden, hidden; F#A#R#T»,
                       bias_ih: option.Opt «hidden; F#A#R#T»,
                       bias_hh: option.Opt «hidden; F#A#R#T»)
                    : [«seq, batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»] =
    torch_recurrent_scan @(F#A#R#T, «batch, hidden; F#A#R#T», seq, batch, input_size, hidden)
        reverse
        (torch_rnn_step F @(batch, input_size, hidden) relu
            (weight_ih, weight_hh, bias_ih, bias_hh))
        (input, initial_hidden);

anx lam gru_direction (F: Floating) {seq batch input_size hidden: Nat}
                      (reverse: Bool)
                      (input: «seq, batch, input_size; F#A#R#T»,
                       initial_hidden: «batch, hidden; F#A#R#T»,
                       weight_ih: «3 * hidden, input_size; F#A#R#T»,
                       weight_hh: «3 * hidden, hidden; F#A#R#T»,
                       bias_ih: option.Opt «3 * hidden; F#A#R#T»,
                       bias_hh: option.Opt «3 * hidden; F#A#R#T»)
                    : [«seq, batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»] =
    torch_recurrent_scan @(F#A#R#T, «batch, hidden; F#A#R#T», seq, batch, input_size, hidden)
        reverse
        (torch_gru_step F @(batch, input_size, hidden) (weight_ih, weight_hh, bias_ih, bias_hh))
        (input, initial_hidden);

anx lam lstm_direction (F: Floating) {seq batch input_size hidden: Nat}
                       (reverse: Bool)
                       (input: «seq, batch, input_size; F#A#R#T»,
                        initial_hidden: «batch, hidden; F#A#R#T»,
                        initial_cell: «batch, hidden; F#A#R#T»,
                        weight_ih: «4 * hidden, input_size; F#A#R#T»,
                        weight_hh: «4 * hidden, hidden; F#A#R#T»,
                        bias_ih: option.Opt «4 * hidden; F#A#R#T»,
                        bias_hh: option.Opt «4 * hidden; F#A#R#T»)
                     : [«seq, batch, hidden; F#A#R#T»,
                        «batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»] =
    let scanned = torch_recurrent_scan
        @(F#A#R#T, [Bool, «batch, hidden; F#A#R#T», «batch, hidden; F#A#R#T»],
          seq, batch, input_size, hidden)
        reverse
        (torch_lstm_step F @(batch, input_size, hidden) (weight_ih, weight_hh, bias_ih, bias_hh))
        (input, (ff, initial_hidden, initial_cell));
    (scanned#ff, scanned#tt#1_3, scanned#tt#2_3);
end
