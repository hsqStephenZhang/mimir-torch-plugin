axm sqrt: [F: Floating] → {r: Nat, s: «r; Nat»}
                   → «s; F#A#R#T» → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.rsqrt.html
/// Types: a `Floating` tensor to a shape- and element-type-preserving tensor.
axm rsqrt: [F: Floating] → {r: Nat, s: «r; Nat»}
                    → «s; F#A#R#T» → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sin.html
