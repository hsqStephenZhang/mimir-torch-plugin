pub mod comparison_impl
anx lam ne_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    tensor.unary @(I64, Bool)
        (torch_ne_i64_scalar other) @(r, s) input;

anx lam eq_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    tensor.unary @(I64, Bool)
        (torch_eq_i64_scalar other) @(r, s) input;

anx lam lt_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    tensor.unary @(I64, Bool)
        (torch_lt_i64_scalar other) @(r, s) input;

anx lam le_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    tensor.unary @(I64, Bool)
        (torch_le_i64_scalar other) @(r, s) input;

anx lam gt_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    tensor.unary @(I64, Bool)
        (torch_gt_i64_scalar other) @(r, s) input;

anx lam ge_i64_scalar {r: Nat, s: «r; Nat»}
                                 (input: «s; I64», other: I64): «s; Bool» =
    tensor.unary @(I64, Bool)
        (torch_ge_i64_scalar other) @(r, s) input;

anx lam eq_i64 {r: Nat, s: «r; Nat»}
                         (lhs: «s; I64», rhs: «s; I64»): «s; Bool» =
    tensor.binary @(I64, I64, Bool)
        torch_eq_i64 @(r, s) (lhs, rhs);

anx lam ne_i64 {r: Nat, s: «r; Nat»}
                         (lhs: «s; I64», rhs: «s; I64»): «s; Bool» =
    tensor.binary @(I64, I64, Bool)
        torch_ne_i64 @(r, s) (lhs, rhs);

anx lam lt_i64 {r: Nat, s: «r; Nat»}
                         (lhs: «s; I64», rhs: «s; I64»): «s; Bool» =
    tensor.binary @(I64, I64, Bool)
        torch_lt_i64 @(r, s) (lhs, rhs);

anx lam le_i64 {r: Nat, s: «r; Nat»}
                         (lhs: «s; I64», rhs: «s; I64»): «s; Bool» =
    tensor.binary @(I64, I64, Bool)
        torch_le_i64 @(r, s) (lhs, rhs);

anx lam gt_i64 {r: Nat, s: «r; Nat»}
                         (lhs: «s; I64», rhs: «s; I64»): «s; Bool» =
    tensor.binary @(I64, I64, Bool)
        torch_gt_i64 @(r, s) (lhs, rhs);

anx lam ge_i64 {r: Nat, s: «r; Nat»}
                         (lhs: «s; I64», rhs: «s; I64»): «s; Bool» =
    tensor.binary @(I64, I64, Bool)
        torch_ge_i64 @(r, s) (lhs, rhs);

anx lam eq (A: Arithmetic) {r: Nat, s: «r; Nat»}
                      (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; Bool» =
    tensor.binary @(A#R#T, A#R#T, Bool)
        (torch_compare_scalar A (torch_arith_eq A)) @(r, s) (lhs, rhs);

anx lam ne (A: Arithmetic) {r: Nat, s: «r; Nat»}
                      (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; Bool» =
    tensor.binary @(A#R#T, A#R#T, Bool)
        (torch_compare_scalar A (torch_arith_ne A)) @(r, s) (lhs, rhs);

anx lam lt (A: Arithmetic) {r: Nat, s: «r; Nat»}
                      (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; Bool» =
    tensor.binary @(A#R#T, A#R#T, Bool)
        (torch_compare_scalar A (torch_arith_lt A)) @(r, s) (lhs, rhs);

anx lam le (A: Arithmetic) {r: Nat, s: «r; Nat»}
                      (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; Bool» =
    tensor.binary @(A#R#T, A#R#T, Bool)
        (torch_compare_scalar A (torch_arith_le A)) @(r, s) (lhs, rhs);

anx lam gt (A: Arithmetic) {r: Nat, s: «r; Nat»}
                      (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; Bool» =
    tensor.binary @(A#R#T, A#R#T, Bool)
        (torch_compare_scalar A (torch_arith_gt A)) @(r, s) (lhs, rhs);

anx lam ge (A: Arithmetic) {r: Nat, s: «r; Nat»}
                      (lhs: «s; A#R#T», rhs: «s; A#R#T»): «s; Bool» =
    tensor.binary @(A#R#T, A#R#T, Bool)
        (torch_compare_scalar A (torch_arith_ge A)) @(r, s) (lhs, rhs);

end
pub mod activation
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.relu.html
/// Types: an `Arithmetic` tensor to a shape- and element-type-preserving tensor.
axm relu: [A: Arithmetic]
                             → {r: Nat, s: «r; Nat»}
                             → [input: «s; A#R#T»]
                             → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.leaky_relu.html
/// Types: a Floating tensor and same-dtype negative slope to the same tensor type.
axm leaky_relu: [F: Floating]
                              → {r: Nat, s: «r; Nat»}
                              → [input: «s; F#A#R#T»,
                                 negative_slope: F#A#R#T]
                              → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.tanh.html
/// Types: a `Floating` tensor to a shape- and element-type-preserving tensor.
axm tanh: [F: Floating] → {r: Nat, s: «r; Nat»}
                             → «s; F#A#R#T» → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.sigmoid.html
/// Types: a `Floating` tensor to a shape- and element-type-preserving tensor.
axm sigmoid: [F: Floating] → {r: Nat, s: «r; Nat»}
                                → «s; F#A#R#T» → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.silu.html
/// Types: a `Floating` tensor to a shape- and element-type-preserving tensor.
axm silu: [F: Floating] → {r: Nat, s: «r; Nat»}
                             → «s; F#A#R#T» → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.gelu.html
/// Types: a `Floating` tensor and static approximation mode to the same tensor type.
axm gelu: [F: Floating] → {r: Nat, s: «r; Nat»}
                             → [approximate_tanh: Bool, input: «s; F#A#R#T»]
                             → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.elu.html
/// Types: a Floating tensor and same-dtype alpha/scale/input_scale parameters.
axm elu: [F: Floating] → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T», alpha scale input_scale: F#A#R#T]
    → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.selu.html
/// Types: a Floating tensor to a shape-preserving tensor with standard SELU constants.
axm selu: [F: Floating] → {r: Nat, s: «r; Nat»}
    → «s; F#A#R#T» → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.hardsigmoid.html
/// Types: a Floating tensor to a shape-preserving tensor.
axm hardsigmoid: [F: Floating]
    → {r: Nat, s: «r; Nat»} → «s; F#A#R#T» → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.softplus.html
/// Types: a Floating tensor and same-dtype beta/threshold parameters.
axm softplus: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → [input: «s; F#A#R#T», beta threshold: F#A#R#T]
    → «s; F#A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.hardtanh.html
/// Types: an `Arithmetic` tensor and same-dtype scalar bounds to the same tensor type.
axm hardtanh: [A: Arithmetic]
                                 → {r: Nat, s: «r; Nat»}
                                 → [input: «s; A#R#T»,
                                    minimum: A#R#T, maximum: A#R#T]
                                 → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.threshold.html
/// Types: an `Arithmetic` tensor plus same-dtype threshold/value scalars to the same tensor type.
axm threshold: [A: Arithmetic]
                        → {r: Nat, s: «r; Nat»}
                        → [input: «s; A#R#T», threshold: A#R#T, value: A#R#T]
                        → «s; A#R#T»;
/// Scalar-bound `aten.clamp`. Each Optional specializes independently. PyTorch
/// propagates an input NaN, while a NaN bound replaces an ordered input; the
/// compare/select implementation preserves both cases.
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.clamp.html
/// Types: an `Arithmetic` tensor and optional same-dtype scalar bounds to the same tensor type.
axm clamp: [A: Arithmetic]
                    → {r: Nat, s: «r; Nat»}
                    → [input: «s; A#R#T»,
                       minimum: option.Opt A#R#T,
                       maximum: option.Opt A#R#T]
                    → «s; A#R#T»;
/// PyTorch API: https://pytorch.org/docs/stable/generated/torch.nn.functional.mish.html
/// Types: a Floating tensor to a shape- and element-type-preserving tensor.
axm mish: [F: Floating]
    → {r: Nat, s: «r; Nat»}
    → «s; F#A#R#T» → «s; F#A#R#T»;
end
