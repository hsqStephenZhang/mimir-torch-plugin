// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match %s

// CHECK-LABEL: extern fun view_ops
// CHECK-COUNT-2: tensor.map_reduce

plugin tensor;
plugin torch;
plugin compile;

extern fun view_ops(input: (tensor.Tensor 3 (2, 3, 4) I32))
  : [(tensor.Tensor 2 (6, 4) I32), (tensor.Tensor 3 (2, 4, 3) I32)] =
    return (
        torch.shape.reshape @(I32, 3, 2)
            ((2, 3, 4), (6, 4)) input,
        torch.shape.transpose_int @(I32, 3, (2, 3, 4))
            (input, -2I64, -1I64));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
