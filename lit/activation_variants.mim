// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match %s

plugin tensor;
plugin math;
plugin torch;
plugin compile;

// CHECK-LABEL: extern fun elu
// CHECK: tensor.map_reduce
extern fun elu(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.elu (torch.resolve_floating math.F32)
        @(2, (2, 4))
        (input, 1.0:math.F32, 1.0:math.F32, 1.0:math.F32));

// CHECK-LABEL: extern fun hardsigmoid
// CHECK: tensor.map_reduce
extern fun hardsigmoid(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.hardsigmoid (torch.resolve_floating math.F32)
        @(2, (2, 4)) input);

// CHECK-LABEL: extern fun selu
// CHECK: tensor.map_reduce
extern fun selu(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.selu (torch.resolve_floating math.F32)
        @(2, (2, 4)) input);

// CHECK-LABEL: extern fun softplus
// CHECK: tensor.map_reduce
extern fun softplus(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.softplus (torch.resolve_floating math.F32)
        @(2, (2, 4)) (input, 1.0:math.F32, 20.0:math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
