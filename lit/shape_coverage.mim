// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. --implicit-check-not=runtime.require \
// RUN:   --implicit-check-not=Match %s

plugin tensor;
plugin torch;
plugin compile;

// CHECK-DAG: extern fun expand
// CHECK-DAG: tensor.map_reduce
extern fun expand(input: «1, 3; I32»): «2, 3; I32» =
    return (torch.shape.expand @(I32, 2, 2)
        ((1, 3), (2, 3)) (input, (0₂, 1₂)));

// CHECK-DAG: extern fun select
// CHECK-DAG: tensor.map_reduce
extern fun select(input: «2, 3, 4; I32»): «2, 3; I32» =
    return (torch.indexing.select @(I32, 3, (2, 3, 4))
        (-1I64, -2I64) input);

// CHECK-DAG: extern fun cat
// CHECK-DAG: tensor.concat
extern fun cat(lhs: «2, 3; I32», rhs: «1, 3; I32»): «3, 3; I32» =
    return (torch.shape.cat @(I32, 2, 2) 0₂ @((2, 3), (1, 3)) (lhs, rhs));

// CHECK-DAG: extern fun flatten
// CHECK-DAG: tensor.map_reduce
extern fun flatten(input: «2, 3, 4; I32»): «6, 4; I32» =
    return (torch.shape.flatten @(I32, 3, 2) ((2, 3, 4), (6, 4)) input);

// Dropping or adding a unit axis leaves the layout as is: the input comes back unchanged.
// CHECK-DAG: extern fun squeeze
// CHECK-DAG: return input
extern fun squeeze(input: «2, 1, 3; I32»): «2, 3; I32» =
    return (torch.shape.squeeze @(I32, 3, 2) ((2, 1, 3), (2, 3)) input);

// CHECK-DAG: extern fun unsqueeze
// CHECK-DAG: return input
extern fun unsqueeze(input: «2, 3; I32»): «2, 1, 3; I32» =
    return (torch.shape.unsqueeze @(I32, 2, 3) ((2, 3), (2, 1, 3)) input);

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
