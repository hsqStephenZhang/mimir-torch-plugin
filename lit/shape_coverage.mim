// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. --implicit-check-not=runtime.require \
// RUN:   --implicit-check-not=Match %s

plugin tensor;
plugin torch;
plugin compile;

// CHECK-DAG: extern fun expand
// CHECK-DAG: tensor.map_reduce
extern fun expand(input: (tensor.Tensor 2 (1, 3) I32)): (tensor.Tensor 2 (2, 3) I32) =
    return (torch.shape.expand @(I32, 2, 2)
        ((1, 3), (2, 3)) (input, (0₂, 1₂)));

// CHECK-DAG: extern fun select
// CHECK-DAG: tensor.map_reduce
extern fun select(input: (tensor.Tensor 3 (2, 3, 4) I32)): (tensor.Tensor 2 (2, 3) I32) =
    return (torch.indexing.select @(I32, 3, (2, 3, 4))
        (-1I64, -2I64) input);

// CHECK-DAG: extern fun cat
// CHECK-DAG: tensor.concat
extern fun cat(lhs: (tensor.Tensor 2 (2, 3) I32), rhs: (tensor.Tensor 2 (1, 3) I32)): (tensor.Tensor 2 (3, 3) I32) =
    return (torch.shape.cat @(I32, 2, 2) 0₂ @((2, 3), (1, 3)) (lhs, rhs));

// CHECK-DAG: extern fun flatten
// CHECK-DAG: tensor.map_reduce
extern fun flatten(input: (tensor.Tensor 3 (2, 3, 4) I32)): (tensor.Tensor 2 (6, 4) I32) =
    return (torch.shape.flatten @(I32, 3, 2) ((2, 3, 4), (6, 4)) input);

// Unit-axis changes preserve the layout but change the nominal tensor type.
// CHECK-DAG: extern fun squeeze
// CHECK-DAG: tensor.map_reduce_post
extern fun squeeze(input: (tensor.Tensor 3 (2, 1, 3) I32)): (tensor.Tensor 2 (2, 3) I32) =
    return (torch.shape.squeeze @(I32, 3, 2) ((2, 1, 3), (2, 3)) input);

// CHECK-DAG: extern fun unsqueeze
// CHECK-DAG: tensor.map_reduce_post
extern fun unsqueeze(input: (tensor.Tensor 2 (2, 3) I32)): (tensor.Tensor 3 (2, 1, 3) I32) =
    return (torch.shape.unsqueeze @(I32, 2, 3) ((2, 3), (2, 1, 3)) input);

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
