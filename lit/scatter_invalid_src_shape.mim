// RUN: (! %mim %s -o /dev/null 2>&1) | %FileCheck %s

plugin math;
plugin torch;
plugin compile;

extern fun invalid_src_shape(
    input: «3, 3; math.F32»,
    index: «2, 3; I64»,
    src: «1, 3; math.F32»): «3, 3; math.F32» =
    return (torch.indexing.scatter_src
        @(math.F32, 2, (3, 3), (2, 3), (1, 3))
        (1I64) (input, index, src));

// CHECK: scatter index shape exceeds input or source shape
extern lam _compile (): compile.Phase = torch.lower_torch;
