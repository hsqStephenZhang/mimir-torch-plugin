// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=runtime.require \
// RUN:   --implicit-check-not=Match

plugin tensor;
plugin math;
plugin option;
plugin torch;
plugin compile;

// Static inference uses running statistics and eliminates the training
// reduction branch.
// CHECK-LABEL: extern fun batch_norm_inference
// CHECK: tensor.map_reduce
extern fun batch_norm_inference(
    input: (tensor.Tensor 4 (2, 3, 4, 5) math.F32),
    mean variance weight bias: (tensor.Tensor 1 3 math.F32))
  : (tensor.Tensor 4 (2, 3, 4, 5) math.F32) =
    return (torch.normalization.batch_norm
        (torch.resolve_floating math.F32)
        @(4, (2, 3, 4, 5))
        (input, option.Opt#Some weight, option.Opt#Some bias,
         option.Opt#Some mean, option.Opt#Some variance)
        (ff, 0x3DCCCCCD:math.F32, 0x3727C5AC:math.F32, tt));

// Static training computes channel-wise batch statistics over N,H,W and
// accepts absent running and affine tensors.
// CHECK-LABEL: extern fun batch_norm_training
// CHECK: tensor.map_reduce
// CHECK: tensor.map_reduce
extern fun batch_norm_training(input: (tensor.Tensor 4 (2, 3, 4, 5) math.F32))
  : (tensor.Tensor 4 (2, 3, 4, 5) math.F32) =
    return (torch.normalization.batch_norm
        (torch.resolve_floating math.F32)
        @(4, (2, 3, 4, 5))
        (input,
         (option.Opt@(tensor.Tensor 1 3 math.F32))#None, (option.Opt@(tensor.Tensor 1 3 math.F32))#None,
         (option.Opt@(tensor.Tensor 1 3 math.F32))#None, (option.Opt@(tensor.Tensor 1 3 math.F32))#None)
        (tt, 0x3DCCCCCD:math.F32, 0x3727C5AC:math.F32, ff));

// Functionalization also exposes updated running statistics.
// CHECK-LABEL: extern fun native_batch_norm_functional
// CHECK: tensor.map_reduce

// Native training exposes the saved mean and inverse standard deviation.
// CHECK-LABEL: extern fun native_batch_norm_training
// CHECK: tensor.map_reduce
extern fun native_batch_norm_training(
    input: (tensor.Tensor 4 (2, 3, 4, 5) math.F32),
    weight bias: (tensor.Tensor 1 3 math.F32))
  : [(tensor.Tensor 4 (2, 3, 4, 5) math.F32), (tensor.Tensor 1 3 math.F32), (tensor.Tensor 1 3 math.F32)] =
    return (torch.normalization.native_batch_norm
        (torch.resolve_floating math.F32)
        @(4, (2, 3, 4, 5))
        (input, option.Opt#Some weight, option.Opt#Some bias,
         (option.Opt@(tensor.Tensor 1 3 math.F32))#None, (option.Opt@(tensor.Tensor 1 3 math.F32))#None)
        (tt, 0x3DCCCCCD:math.F32, 0x3727C5AC:math.F32));

extern fun native_batch_norm_functional(
    input: (tensor.Tensor 4 (2, 3, 4, 5) math.F32),
    weight bias mean variance: (tensor.Tensor 1 3 math.F32))
  : [(tensor.Tensor 4 (2, 3, 4, 5) math.F32), (tensor.Tensor 1 3 math.F32), (tensor.Tensor 1 3 math.F32),
     (tensor.Tensor 1 3 math.F32), (tensor.Tensor 1 3 math.F32)] =
    return (torch.normalization.native_batch_norm_functional
        (torch.resolve_floating math.F32)
        @(4, (2, 3, 4, 5))
        (input, option.Opt#Some weight, option.Opt#Some bias, mean, variance)
        (tt, 0x3E800000:math.F32, 0x3727C5AC:math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
