// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. --implicit-check-not=runtime. %s

// CHECK-LABEL: extern fun addcdiv_broadcast
// CHECK-COUNT-6: tensor.map_reduce
// CHECK-LABEL: extern fun addcmul_broadcast
// CHECK-COUNT-6: tensor.map_reduce

plugin tensor;
plugin math;
plugin core;
plugin torch;
plugin compile;

extern fun addcmul_broadcast(
    self: «2; math.F32», tensor1: «3; math.F32»,
    tensor2: «2, 3; math.F32»): «2, 3; math.F32» =
    return (torch.binary.addcmul (torch.resolve_arithmetic math.F32)
        @(1, 1, 2, 2)
        ((2,), (0₂,),
         (3,), (1₂,),
         (2, 3), (0₂, 1₂), (2, 3))
        (self, tensor1, tensor2, 2.5:math.F32));

extern fun addcdiv_broadcast(
    self: «2; math.F32», tensor1: «3; math.F32»,
    tensor2: «2, 3; math.F32»): «2, 3; math.F32» =
    return (torch.binary.addcdiv (torch.resolve_arithmetic math.F32)
        @(1, 1, 2, 2)
        ((2,), (0₂,),
         (3,), (1₂,),
         (2, 3), (0₂, 1₂), (2, 3))
        (self, tensor1, tensor2, 2.5:math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
