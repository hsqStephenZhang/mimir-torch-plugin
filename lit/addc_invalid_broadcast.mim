// RUN: not %mim %s -p opt -o /dev/null 2>&1 | %FileCheck %s

// CHECK: addcmul operands are not broadcastable

plugin math;
plugin core;
plugin torch;
plugin compile;

extern fun invalid_addcmul(
    self: «2; math.F32», tensor1: «3; math.F32»,
    tensor2: «3, 3; math.F32»): «3, 3; math.F32» =
    return (torch.binary.addcmul (torch.resolve_arithmetic math.F32)
        @(1, 1, 2, 2)
        ((2,), (0₂,),
         (3,), (1₂,),
         (3, 3), (0₂, 1₂), (3, 3))
        (self, tensor1, tensor2, 1.0:math.F32));

extern lam _compile (): compile.Phase = torch.lower_torch;
