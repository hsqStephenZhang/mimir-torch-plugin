// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match

plugin tensor;
plugin math;
plugin torch;
plugin compile;

// CHECK-DAG: math.arith.mul
// CHECK-DAG: math.cmp
// CHECK-LABEL: extern fun leaky_relu
// CHECK: tensor.map_reduce
extern fun leaky_relu(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.leaky_relu (torch.resolve_floating math.F32)
        @(2, (2, 4)) (input, 1036831949:(math.F32)));

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
