// RUN: %mim %s -p opt -o - | %FileCheck %s
// CHECK-LABEL: extern fun ge_i64_scalar
// CHECK-NOT: torch.comparison.ge_i64_scalar
// CHECK: tensor.map_reduce

plugin tensor;
plugin torch;
plugin compile;

extern fun ge_i64_scalar(input: «2, 4; I64»): «2, 4; Bool» =
    return (torch.comparison.ge_i64_scalar @(2, (2, 4)) (input, 2I64));

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
