// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match

plugin tensor;
plugin torch;
plugin compile;

// [2, 0, 1] is intentionally not self-inverse. It distinguishes PyTorch's
// output-to-input axis convention from tensor.transpose's convention.
// CHECK-LABEL: extern fun permute_rank3
// CHECK-SAME: ({{.*}}: tensor.Tensor 3 (2, 3, 4) I32): tensor.Tensor 3 (4, 2, 3) I32
// CHECK: tensor.map_reduce
extern fun permute_rank3(input: (tensor.Tensor 3 (2, 3, 4) I32)): (tensor.Tensor 3 (4, 2, 3) I32) =
    return (torch.shape.permute @(I32, 3, (2, 3, 4))
        (input, (2₃, 0₃, 1₃)));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
