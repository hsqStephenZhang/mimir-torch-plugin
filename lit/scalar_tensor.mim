// RUN: %mim %s -p opt -o - | %FileCheck %s
// CHECK-LABEL: extern fun scalar_tensor
// CHECK-NOT: torch.creation.scalar_tensor

plugin tensor;
plugin math;
plugin torch;
plugin compile;

extern fun scalar_tensor(value: math.F32): math.F32 =
    return (torch.creation.scalar_tensor @math.F32 value);

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
