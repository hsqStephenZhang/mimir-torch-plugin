// RUN: %mim %s -p opt -o - | %FileCheck %s
// CHECK-LABEL: extern fun logsumexp
// CHECK-NOT: torch.reduction.logsumexp_dims
// CHECK: tensor.map_reduce

plugin tensor;
plugin math;
plugin torch;
plugin compile;

extern fun logsumexp(input: «2, 3, 4; math.F32»): «2, 4; math.F32» =
    return (torch.reduction.logsumexp_dims
        (torch.resolve_floating math.F32)
        @(3, 1, (2, 3, 4)) (1I64,) input);

// CHECK-LABEL: extern fun logsumexp_keepdim
// CHECK-NOT: torch.reduction.logsumexp_dims_keepdim
// CHECK: tensor.map_reduce
extern fun logsumexp_keepdim(
    input: «2, 3, 4; math.F32»): «2, 1, 4; math.F32» =
    return (torch.reduction.logsumexp_dims_keepdim
        (torch.resolve_floating math.F32)
        @(3, 1, (2, 3, 4)) (-2I64,) input);

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
