// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=tensor.generate \
// RUN:   --implicit-check-not=Match

plugin math;
plugin torch;
plugin compile;

// CHECK-LABEL: extern fun index_2d
// CHECK: tensor.map_reduce
// CHECK: tensor.gather
extern fun index_2d(
    input: «3, 4; math.F32»,
    rows columns: «2, 5; I64»): «2, 5; math.F32» =
    return (torch.indexing.index_2d
        @(math.F32, 3, 4, 2, (2, 5)) (input, rows, columns));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        compile.cleanup,
    );
