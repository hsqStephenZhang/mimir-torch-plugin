// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=torch.
// RUN: %mim %s --profile summary | %FileCheck %s --check-prefix=PROFILE

plugin tensor;
plugin math;
plugin torch;
plugin compile;

// PyTorch's default exact GELU selects the erf formula statically.
extern fun gelu_exact(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.gelu (torch.resolve_floating math.F32)
        @(2, (2, 4)) (ff, input));

// `approximate="tanh"` selects the tanh formula statically.
extern fun gelu_tanh(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.gelu (torch.resolve_floating math.F32)
        @(2, (2, 4)) (tt, input));

// CHECK-LABEL: extern fun gelu_exact
// CHECK: math.er.f
// CHECK-NOT: math.tri.
// CHECK-LABEL: extern fun gelu_tanh
// CHECK: math.tri.
// CHECK-NOT: math.er.f

// PROFILE: Profile (flat):
// PROFILE-DAG: 2 torch.lower_torch: decompose.impl.torch.activation.gelu
extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
