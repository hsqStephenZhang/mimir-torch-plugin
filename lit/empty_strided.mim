// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=tensor.generate

plugin tensor;
plugin torch;
plugin compile;

// CHECK-LABEL: extern fun empty_strided
// CHECK: tensor.splat
extern fun empty_strided(): «2, 3; I32» =
    return (torch.creation.empty_strided @(I32, 2) ((2, 3), (3, 1)));

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
