// RUN: rm -f %{s:stem}.ll
// RUN: %mim %s -p opt -p ll
// RUN: clang++ -std=c++23 %S/nominal_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
// RUN: %t
// XFAIL: *
// Core SEO crashes on the combined dynamic functions; scripts/nominal_seo.mim reproduces it.

plugin tensor;
plugin math;
plugin torch;
plugin compile;
plugin opt;

let F32 = math.F32;
let A = torch.resolve_arithmetic F32;

extern fun static_relu1 (input: tensor.Tensor 1 4 F32): tensor.Tensor 1 4 F32 =
    return (torch.activation.relu A @(1, 4) input);

extern fun static_relu3 (input: tensor.Tensor 3 (2, 1, 3) F32): tensor.Tensor 3 (2, 1, 3) F32 =
    return (torch.activation.relu A @(3, (2, 1, 3)) input);

extern fun dynamic_relu1 (n: Nat, input: tensor.Tensor 1 n F32): tensor.Tensor 1 n F32 =
    return (torch.activation.relu A @(1, n) input);

extern fun dynamic_relu3 (n: Nat, input: tensor.Tensor 3 (n, 1, 3) F32): tensor.Tensor 3 (n, 1, 3) F32 =
    return (torch.activation.relu A @(3, (n, 1, 3)) input);

extern fun dynamic_sum1 (n: Nat, input: tensor.Tensor 1 n F32): F32 =
    return (tensor.item (torch.reduction.sum A @(1, 1, n) (0I64, ff) input));

extern fun dynamic_sum3 (n: Nat, input: tensor.Tensor 3 (n, 1, 3) F32): tensor.Tensor 3 (n, 1, 1) F32 =
    return (torch.reduction.sum A @(3, 1, (n, 1, 3)) (2I64, tt) input);

extern fun scalar_roundtrip (value: F32): F32 =
    return (tensor.item (torch.creation.scalar_tensor @F32 value));

extern fun literal_relu (): tensor.Tensor 3 (1, 3, 1) F32 =
    let input = tensor.from_array @(3, (1, 3, 1), F32) (-2.0:F32, 0.0:F32, 5.0:F32);
    return (torch.activation.relu A @(3, (1, 3, 1)) input);

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, opt._default_compile ());
