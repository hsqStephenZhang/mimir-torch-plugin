// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match

plugin math;
plugin torch;
plugin compile;

// CHECK-LABEL: extern fun adaptive_avg_pool3d
// CHECK: tensor.generate
extern fun adaptive_avg_pool3d(input: «2, 3, 4, 5, 6; math.F32»)
                             : «2, 3, 1, 1, 1; math.F32» =
    return (torch.pool.adaptive_avg_pool3d (torch.resolve_floating math.F32)
        @(5, (2, 3, 4, 5, 6))
        (1, 1, 1) input);

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, compile.cleanup);
