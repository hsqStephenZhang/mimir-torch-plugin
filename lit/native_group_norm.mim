// RUN: %mim %s -p opt -o - | %FileCheck %s
// CHECK-LABEL: extern fun native_group_norm
// CHECK-NOT: torch.normalization.native_group_norm
// CHECK-NOT: torch.normalization.native_layer_norm
// CHECK: tensor.map_reduce

plugin tensor;
plugin math;
plugin option;
plugin torch;
plugin compile;

extern fun native_group_norm(
    input: (tensor.Tensor 4 (2, 4, 3, 5) math.F32),
    weight: (tensor.Tensor 1 4 math.F32),
    bias: (tensor.Tensor 1 4 math.F32))
  : [(tensor.Tensor 4 (2, 4, 3, 5) math.F32),
     (tensor.Tensor 2 (2, 2) math.F32),
     (tensor.Tensor 2 (2, 2) math.F32)] =
    return (torch.normalization.native_group_norm
        (torch.resolve_floating math.F32)
        @(4, (2, 4, 3, 5))
        (input, (option.Opt#Some weight), (option.Opt#Some bias))
        (2, 4, 15, 2, 0.00001:math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
