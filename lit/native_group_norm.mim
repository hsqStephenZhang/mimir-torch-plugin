// RUN: %mim %s -p opt -o - | %FileCheck %s
// CHECK-LABEL: extern fun native_group_norm
// CHECK-NOT: torch.normalization.native_group_norm
// CHECK-NOT: torch.normalization.native_layer_norm
// CHECK: tensor.map_reduce

plugin math;
plugin option;
plugin torch;
plugin compile;

extern fun native_group_norm(
    input: «2, 4, 3, 5; math.F32»,
    weight: «4; math.F32»,
    bias: «4; math.F32»)
  : [«2, 4, 3, 5; math.F32»,
     «2, 2; math.F32»,
     «2, 2; math.F32»] =
    return (torch.normalization.native_group_norm
        (torch.resolve_floating math.F32)
        @(4, (2, 4, 3, 5))
        (input, (option.some weight), (option.some bias))
        (2, 4, 15, 2, 0.00001:math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, compile.cleanup);
