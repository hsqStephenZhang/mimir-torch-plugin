// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. %s

// CHECK-LABEL: extern fun add_scalar_lhs
// CHECK: math.arith.mul
// CHECK: math.arith.add
// CHECK-LABEL: extern fun sub_scalar_lhs
// CHECK: math.arith.mul
// CHECK: math.arith.sub

plugin math;
plugin torch;
plugin compile;

extern fun add_scalar_lhs(other: «4; math.F32»): «4; math.F32» =
    return (torch.binary.add_scalar_lhs (torch.resolve_arithmetic math.F32)
        @(1, 4) (2.0:math.F32, other, 3.0:math.F32));

extern fun sub_scalar_lhs(other: «4; math.F32»): «4; math.F32» =
    return (torch.binary.sub_scalar_lhs (torch.resolve_arithmetic math.F32)
        @(1, 4) (2.0:math.F32, other, 3.0:math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        compile.cleanup,
    );
