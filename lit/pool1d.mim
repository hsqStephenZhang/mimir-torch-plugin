// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match

plugin tensor;
plugin math;
plugin option;
plugin torch;
plugin compile;

// Externals are emitted in dependency order.
// CHECK-LABEL: extern fun adaptive_avg_pool1d
// CHECK: tensor.generate

extern fun max_pool1d(input: «2, 3, 9; math.F32»)
  : «2, 3, 4; math.F32» =
    return (torch.pool.max_pool1d (torch.resolve_floating math.F32)
        @(2, 3, 9)
        (3, 2, 1, 2, tt)
        input);

// The NCL input is NCL1 with a unit axis, which folds away: no reshape on either side of the 2-D pool.
// CHECK-LABEL: extern fun avg_pool1d
// CHECK: tensor.pad
// CHECK: tensor.map_reduce
// CHECK: tensor.generate
extern fun avg_pool1d(input: «2, 3, 8; math.F32»)
  : «2, 3, 5; math.F32» =
    return (torch.pool.avg_pool1d (torch.resolve_floating math.F32)
        @(2, 3, 8)
        (3, 2, 1, tt, ff, option.none @Nat)
        input);

extern fun adaptive_avg_pool1d(input: «2, 3, 8; math.F32»)
  : «2, 3, 1; math.F32» =
    return (torch.pool.adaptive_avg_pool1d (torch.resolve_floating math.F32)
        @(3, (2, 3, 8)) 1 input);

// CHECK-LABEL: extern fun max_pool1d
// CHECK: tensor.pad
// CHECK: tensor.map_reduce

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
