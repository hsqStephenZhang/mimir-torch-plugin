// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=tensor.generate \
// RUN:   --implicit-check-not=tensor.get --implicit-check-not=Match

plugin tensor;
plugin math;
plugin torch;
plugin compile;

// CHECK-LABEL: extern fun roll
// CHECK-DAG: affine.semiop.rem
// CHECK-DAG: tensor.map_reduce
extern fun roll(input: «2, 3, 4; math.F32»): «2, 3, 4; math.F32» =
    return (torch.indexing.roll @(math.F32, 3, 2, (2, 3, 4))
        ((1, 2), (1I64, 2I64)) input);

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, tensor.lower_tensor, compile.cleanup);
