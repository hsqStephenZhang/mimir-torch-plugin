// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. %s

// CHECK-LABEL: extern fun addcmul_dynamic
// CHECK: runtime.static_check

plugin tensor;
plugin math;
plugin core;
plugin torch;
plugin compile;

extern fun addcmul_dynamic {a n m: Nat}(
    self: «a; math.F32», tensor1: «m; math.F32»,
    tensor2: «n, m; math.F32»): «n, m; math.F32» =
    return (torch.binary.addcmul (torch.resolve_arithmetic math.F32)
        @(1, 1, 2, 2)
        ((a,), (0₂,),
         (m,), (1₂,),
         (n, m), (0₂, 1₂), (n, m))
        (self, tensor1, tensor2, 1.0:math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
