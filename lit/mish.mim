// RUN: %mim %s -p opt -o - | %FileCheck %s
// CHECK-LABEL: extern fun mish
// CHECK-NOT: torch.activation.mish
// CHECK-NOT: torch.activation.softplus
// CHECK: tensor.map_reduce

plugin math;
plugin torch;
plugin compile;

extern fun mish(input: «2, 4; math.F32»): «2, 4; math.F32» =
    return (torch.activation.mish (torch.resolve_floating math.F32)
        @(2, (2, 4)) input);

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, compile.cleanup);
