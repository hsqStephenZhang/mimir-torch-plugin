// RUN: %mim -p opt %s -o - | %FileCheck %s --implicit-check-not=torch.

plugin math;
plugin torch;
plugin compile;

// CHECK-LABEL: extern fun stack_dim1
// CHECK: tensor.map_reduce
// CHECK: tensor.concat
extern fun stack_dim1(a b c: «2, 3; math.F32»): «2, 3, 3; math.F32» =
    return (torch.shape.stack @(math.F32, 3, 2, 3)
        ((2, 3), (2, 1, 3), 1_3) (a, b, c));

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, compile.cleanup);
