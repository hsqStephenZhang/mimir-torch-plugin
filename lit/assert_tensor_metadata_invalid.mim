// RUN: not %mim %s -o - 2>&1 | %FileCheck %s

plugin tensor;
plugin torch;
plugin compile;

// CHECK: static runtime assertion failed: _assert_tensor_metadata size mismatch
extern lam static_failure(): Bool =
    torch.metadata.assert_tensor_metadata @2 ((2, 3), (2, 4));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
