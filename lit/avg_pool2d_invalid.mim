// RUN: (! %mim %s -o /dev/null 2>&1) | %FileCheck %s

plugin math;
plugin option;
plugin tensor;
plugin torch;
plugin compile;

extern fun zero_divisor(input: (tensor.Tensor 4 (1, 1, 3, 3) math.F32))
  : (tensor.Tensor 4 (1, 1, 1, 1) math.F32) =
    return (torch.pool.avg_pool2d (torch.resolve_floating math.F32)
        @(1, 1, 3, 3)
        ((2, 2), (2, 2), (0, 0), ff, tt, option.Opt#Some 0)
        input);

// CHECK: avg_pool2d divisor must be nonzero
extern lam _compile (): compile.Phase = torch.lower_torch;
