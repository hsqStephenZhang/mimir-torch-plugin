// RUN: (! %mim %s -p opt -o /dev/null 2>&1) | %FileCheck %s

// CHECK: batch_norm expects rank >= 2, valid running stats

plugin math;
plugin option;
plugin torch;
plugin compile;

extern fun missing_stats(input: «2, 3, 4; math.F32»)
  : «2, 3, 4; math.F32» =
    return (torch.normalization.batch_norm
        (torch.resolve_floating math.F32) @(3, (2, 3, 4))
        (input,
         option.none @«3; math.F32», option.none @«3; math.F32»,
         option.none @«3; math.F32», option.none @«3; math.F32»)
        (ff, 0x3DCCCCCD:math.F32, 0x3727C5AC:math.F32, ff));

extern lam _compile (): compile.Phase = torch.lower_torch;
