// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. %s

// CHECK-DAG: math.extrema.IM
// CHECK-LABEL: extern fun maximum_f32
// CHECK-DAG: math.extrema.Im
// CHECK-LABEL: extern fun minimum_f64

plugin tensor;
plugin math;
plugin torch;
plugin compile;

extern fun maximum_f32(lhs rhs: «2; math.F32»): «2; math.F32» =
    return (torch.binary.maximum (torch.resolve_arithmetic math.F32)
        @(1, 2) (lhs, rhs));

extern fun minimum_f64(lhs rhs: «2; math.F64»): «2; math.F64» =
    return (torch.binary.minimum (torch.resolve_arithmetic math.F64)
        @(1, 2) (lhs, rhs));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
