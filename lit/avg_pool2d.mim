// RUN: %mim -p opt %s -o - | %FileCheck %s \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match

plugin math;
plugin option;
plugin torch;
plugin compile;

// Externals are emitted in dependency order.
// CHECK-LABEL: extern fun ceil_include_padding
// CHECK: tensor.pad
// CHECK: tensor.generate
// CHECK-LABEL: extern fun divisor_override
// CHECK: tensor.generate
// CHECK-LABEL: extern fun exclude_padding
// CHECK: tensor.map_reduce
// CHECK: tensor.generate

extern fun exclude_padding(input: «1, 1, 3, 3; math.F32»)
  : «1, 1, 2, 2; math.F32» =
    return (torch.pool.avg_pool2d (torch.resolve_floating math.F32)
        @(1, 1, 3, 3)
        ((2, 2), (2, 2), (1, 1), ff, ff, option.none @Nat)
        input);

// Ceil mode extends only the high side needed by the final window.
extern fun ceil_include_padding(input: «1, 1, 4, 4; math.F32»)
  : «1, 1, 3, 3; math.F32» =
    return (torch.pool.avg_pool2d (torch.resolve_floating math.F32)
        @(1, 1, 4, 4)
        ((3, 3), (2, 2), (1, 1), tt, tt, option.none @Nat)
        input);

extern fun divisor_override(input: «1, 1, 3, 3; math.F32»)
  : «1, 1, 2, 2; math.F32» =
    return (torch.pool.avg_pool2d (torch.resolve_floating math.F32)
        @(1, 1, 3, 3)
        ((2, 2), (2, 2), (1, 1), ff, ff, option.some 7)
        input);

extern lam _compile (): compile.Phase =
    compile.phases ff (torch.lower_torch, compile.cleanup);
