// RUN: %mim -p opt %s -o - | %FileCheck \
// RUN:   --implicit-check-not=torch. --implicit-check-not=Match %s

// CHECK-DAG: math.cmp.uGlE
// CHECK-DAG: math.cmp.Ugle
// CHECK-LABEL: extern fun clamp_min_f32

plugin tensor;
plugin math;
plugin option;
plugin torch;
plugin compile;

extern fun clamp_min_f32(input: «4; math.F32»): «4; math.F32» =
    return (torch.activation.clamp (torch.resolve_arithmetic math.F32)
        @(1, 4)
        (input, option.some (-1.0:math.F32), option.none @math.F32));

extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
