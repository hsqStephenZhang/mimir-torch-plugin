// RUN: %mim %s -o - | %FileCheck %s --implicit-check-not=Match
// RUN: %mim %s --profile summary | %FileCheck %s --check-prefix=PROFILE

plugin tensor;
plugin core;
plugin vec;
plugin option;
plugin torch;
plugin compile;

use core.ops.n;

lam nat_max (args: [Nat, Nat]): Nat =
    core.select (core.ncmp.ge args, args#ff, args#tt);
lam nat_min (args: [Nat, Nat]): Nat =
    core.select (core.ncmp.le args, args#ff, args#tt);
lam nat_never (x: Nat): Bool = ff;
lam nat_is_zero (x: Nat): Bool = core.ncmp.e (x, 0);
lam nat_identity (x: Nat): Nat = x;

let NatArithmetic: torch.Arithmetic = (
    (Nat, 0, core.nat.add, core.nat.mul),
    core.nat.sub, core.nat.div,
    nat_max, nat_min,
    core.ncmp.e, core.ncmp.ne,
    core.ncmp.l, core.ncmp.le, core.ncmp.g, core.ncmp.ge,
    nat_never, nat_is_zero,
);

let NatFloating: torch.Floating = (
    NatArithmetic, 0,
    nat_identity, nat_identity, nat_identity,
    nat_identity, nat_identity, nat_identity,
    nat_identity, nat_identity,
    nat_identity,
    core.nat.mul,
);

// A statically non-empty normalized suffix erases the precondition. Concrete
// Some affine parameters also avoid tensor-valued Optional branch functions.
extern fun layer_norm_static(
    input: (tensor.Tensor 2 (2, 4) Nat), weight: (tensor.Tensor 1 4 Nat), bias: (tensor.Tensor 1 4 Nat))
  : [(tensor.Tensor 2 (2, 4) Nat), (tensor.Tensor 2 (2, 1) Nat), (tensor.Tensor 2 (2, 1) Nat)] =
    return (torch.normalization.native_layer_norm NatFloating
        @(1, 1) ((2,), (4,)) input
        ((option.Opt#Some weight), (option.Opt#Some bias)) 1);

extern fun layer_norm_weight_only(input: (tensor.Tensor 2 (2, 4) Nat), weight: (tensor.Tensor 1 4 Nat))
  : [(tensor.Tensor 2 (2, 4) Nat), (tensor.Tensor 2 (2, 1) Nat), (tensor.Tensor 2 (2, 1) Nat)] =
    return (torch.normalization.native_layer_norm NatFloating
        @(1, 1) ((2,), (4,)) input
        ((option.Opt#Some weight), ((option.Opt@(tensor.Tensor 1 4 Nat))#None)) 1);

extern fun layer_norm_bias_only(input: (tensor.Tensor 2 (2, 4) Nat), bias: (tensor.Tensor 1 4 Nat))
  : [(tensor.Tensor 2 (2, 4) Nat), (tensor.Tensor 2 (2, 1) Nat), (tensor.Tensor 2 (2, 1) Nat)] =
    return (torch.normalization.native_layer_norm NatFloating
        @(1, 1) ((2,), (4,)) input
        (((option.Opt@(tensor.Tensor 1 4 Nat))#None), (option.Opt#Some bias)) 1);

extern fun layer_norm_no_affine(input: (tensor.Tensor 2 (2, 4) Nat))
  : [(tensor.Tensor 2 (2, 4) Nat), (tensor.Tensor 2 (2, 1) Nat), (tensor.Tensor 2 (2, 1) Nat)] =
    return (torch.normalization.native_layer_norm NatFloating
        @(1, 1) ((2,), (4,)) input
        (((option.Opt@(tensor.Tensor 1 4 Nat))#None), ((option.Opt@(tensor.Tensor 1 4 Nat))#None)) 1);

// A symbolic normalized rank cannot discharge the non-empty constraint, so
// the same semantic lambda leaves a runtime check instead of rejecting it.
// CHECK-LABEL: extern fun layer_norm_dynamic
// CHECK: runtime.static_check
extern fun layer_norm_dynamic {rn: Nat}
    (normalized_shape: «rn; Nat»,
     input: (tensor.Tensor (1 + rn) (vec.cat ((2,), normalized_shape)) Nat))
  : [(tensor.Tensor (1 + rn) (vec.cat ((2,), normalized_shape)) Nat),
     (tensor.Tensor (1 + rn) (vec.cat ((2,), ‹i: rn; 1›)) Nat),
     (tensor.Tensor (1 + rn) (vec.cat ((2,), ‹i: rn; 1›)) Nat)] =
    return (torch.normalization.native_layer_norm NatFloating
        @(1, rn) ((2,), normalized_shape) input
        (((option.Opt@(tensor.Tensor rn normalized_shape Nat))#None),
         ((option.Opt@(tensor.Tensor rn normalized_shape Nat))#None)) 1);

// Definitions are printed in reverse declaration order.
// CHECK-LABEL: extern fun layer_norm_static
// CHECK-NOT: runtime.static_check
// CHECK-NOT: Match
// CHECK: tensor.map_reduce

// PROFILE: Profile (flat):
// PROFILE-DAG: 5 `torch.lower_torch`: `decompose.impl`
// PROFILE-DAG: 5 `torch.lower_torch`: `decompose.impl.torch.normalization.native_layer_norm`
// PROFILE-DAG: 1 `torch.lower_torch`: `constraints.dynamic_residual`
extern lam _compile (): compile.Phase =
    compile.phases ff (
        torch.lower_torch,
        tensor.lower_tensor,
        compile.cleanup,
    );
